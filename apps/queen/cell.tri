[cell]
id = "trinity.queen-ui"
name = "Queen UI"
version = "1.0.0"
kind = "frontend"
path = "apps/queen"
min_core_version = "1.0.0"
status = "stable"
description = "28-screen SwiftUI personal CTO interface with the Hive bee orchestrator"
capabilities = ["ui", "chat", "dashboard", "telegram", "hive"]
files = 0
tests = 0
owner = "agent:ralph"
spec_version = 2
api_version = "1.0.0"

[tags]
scope = "ui"
type = "ui"

[contributes]
commands = ["launch", "build"]
tri_subcommands = ["ui"]
events = ["on_ui_ready"]

[dependencies]

[permissions]
# Raised from L0 when the Hive landed. The declaration follows the code:
# the Hive spawns `claude` child processes and writes .trinity/queen/hive*.
# Leaving this at L0 would have made the manifest describe an app that no
# longer exists.
level = "L2"
filesystem = "write"
network = "none"
process = "spawn"

ffi = "none"
concurrency = "none"

[biology]
system = "brain"
organ = "cortex"
[security]
signed = true
signature = "sha256:9a00c4daaab01c6a7f0147972377f8e8e88ca8d69cca1b3645aa085bcff0cc91"

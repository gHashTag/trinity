    "check:silicon": "node scripts/check-silicon-coverage.mjs --self-test",
    "check:render": "node scripts/render-check.mjs",
    "check:deployed": "node scripts/deployed-check.mjs",
    "check:aria": "node scripts/aria-refs-check.mjs",
    "check:service-entry": "node scripts/service-entry-check.mjs",
    "typecheck:update": "node scripts/typecheck-ratchet.mjs --update",
    "audit:en": "node qa/lang_audit.mjs",
    "audit:ru": "node qa/ru_audit.mjs",
    "audit:mobile": "node qa/mobile_audit.mjs",
    "check:queen-languages": "node qa/queen-language-contract.mjs",
    "check:queen-cycle": "node qa/queen-cycle-geometry.mjs",
    "check:queen-factory": "node qa/queen-factory-contract.mjs",
    "check:queen-city": "node qa/queen-research-city-contract.mjs",
    "check:queen-construction": "node qa/queen-construction-game-contract.mjs",
    "check:queen-hardware": "node qa/queen-hardware-foundry-contract.mjs",
    "check:queen-review": "node qa/queen-review-lifecycle-contract.mjs",
    "check:queen-viewport": "node qa/queen-viewport-contract.mjs",
    "check:queen-honesty": "node --experimental-strip-types qa/queen-honesty-contract.mjs",
    "check:queen-coverage": "node --experimental-strip-types qa/queen-coverage-contract.mjs",
    "check:queen-displays": "node --experimental-strip-types qa/queen-hive-display-contract.mjs",
    "check:queen-worlds": "node --experimental-strip-types qa/queen-repository-worlds.mjs",
    "check:queen-dead-api": "node qa/queen-viewport-contract.mjs --dead-api",
    "check:queen-touch": "node qa/queen-touch-contract.mjs",
    "check:queen-round": "node qa/queen-round-contract.mjs",
    "check:queen-pick": "node qa/queen-pick-contract.mjs",
    "check:queen-placement": "node qa/queen-placement-contract.mjs",
    "check:queen-stale": "node qa/queen-stale-contract.mjs",
    "check:queen-castle": "node qa/queen-castle-contract.mjs",
    "check:queen-foundation": "node qa/queen-foundation-contract.mjs",
    "check:queen-windows": "node qa/queen-windows-contract.mjs",
    "check:queen-void": "node qa/queen-void-contract.mjs",
    "check:queen-babylon": "npx vite build && QUEEN_ENGINE=babylon node qa/queen-pick-contract.mjs --no-build && QUEEN_ENGINE=babylon node qa/queen-placement-contract.mjs --no-build && QUEEN_ENGINE=babylon node qa/queen-touch-contract.mjs --no-build",

    "dev": "vite",
    "build": "vite build",
    "build:ci": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",

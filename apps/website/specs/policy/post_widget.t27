// SPDX-License-Identifier: Apache-2.0
; specs/policy/post_widget.t27 -- every blog post carries a widget
; Source of truth for scripts/pr_blog_report.py (gHashTag/trinity, repository root), which
; reads the str constants below when it validates a PR's work report with --posts. A post
; body under POST_DIR that the PR adds, modifies or renames must hold at least one block
; whose kind is in WIDGET_KINDS, in its English body and, when it has one, in its Russian
; ruBody, or the "T27 work report" status turns red with RULE as the reason. The rule's
; words live here and nowhere else.
; ASCII only (L3), English only (LANG-EN).

; WHY: the owner's rule of 2026-10-09. A post shows the reader the real command running:
; a tri or t27c terminal cast (a recording under public/term/<id>/, replayed in the page by
; public/term/player.js) or a figure drawn from the post's own numbers. From 2026-10-07 to
; 2026-10-09 eleven posts in a row shipped as text only, because the rule was said once
; and written nowhere. A rule nobody wrote down is a rule nobody checks.

; WHAT COUNTS: a block is a widget when its kind is one of WIDGET_KINDS ("terminal" is a
; recorded session, "figure" an SVG with a caption; see src/data/blog/types.ts). The check
; reads the body file as text and never runs it. A body that exports body and ruBody needs a
; widget in each; a body with no ruBody needs one in body. A removed body is not checked.

; GRANDFATHERED: the posts dated before WIDGET_SINCE that carried no widget on the day this
; rule was written, by body file name without .ts. They may be edited without adding one.
; The list only shrinks: a post that gains a widget may leave it, and no post joins it.
; WIDGET_SINCE is the owner's cutoff: every post dated on or after it carries a widget from
; the change that adds this file on, so none of them is listed.

; LIMIT: the workflow never checks out the PR (pull_request_target), so the check cannot
; see whether a terminal block's recording exists under public/term/; the site build and
; its player do. A kind is matched by its text, kind: 'terminal' or "kind": "terminal".
; phi^2 + 1/phi^2 = 3 | TRINITY

module post_widget_policy;

pub const KIND : str = "policy";
pub const SCHEMA_VERSION : u8 = 1;
pub const RULE_ID : str = "widget-per-post";
pub const RULE : str = "A blog post carries at least one widget, a terminal cast or a figure, in its English body and in its Russian ruBody.";
pub const POST_DIR : str = "apps/website/src/data/blog/bodies/";
pub const WIDGET_KIND_COUNT : u8 = 2;
pub const WIDGET_KINDS : [2]str = ["terminal", "figure"];
pub const WIDGET_SINCE : str = "2026-09-27";
pub const GRANDFATHERED_COUNT : u8 = 72;
pub const GRANDFATHERED : [72]str = [
    "a-broken-reference-looks-exactly-like-broken-code",

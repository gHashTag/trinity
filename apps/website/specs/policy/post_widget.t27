test the_rule_is_named_like_the_course_rule {
    assert RULE_ID == "widget-per-post";
    assert KIND == "policy";
    assert SCHEMA_VERSION == 1;
}

test a_widget_is_a_cast_or_a_figure {
    assert WIDGET_KIND_COUNT == 2;
    assert WIDGET_KINDS[0] == "terminal";
    assert WIDGET_KINDS[1] == "figure";
}

test posts_live_where_the_course_rule_looks {
    assert POST_DIR == "apps/website/src/data/blog/bodies/";
}

test the_cutoff_date_is_pinned {
    assert WIDGET_SINCE == "2026-09-27";
}

test the_grandfathered_list_is_closed {
    assert GRANDFATHERED_COUNT == 72;
    assert GRANDFATHERED[0] == "a-broken-reference-looks-exactly-like-broken-code";
    assert GRANDFATHERED[71] == "two-bitstreams-one-bit-apart";
}

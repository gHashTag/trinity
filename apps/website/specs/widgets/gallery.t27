pub const WIDGET_LINES : [140]str = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "One issue, one pinned commit, the same tools and gates; only the decision layer changes, and a missing run stays unknown.", "", "", "", "", ""];
; Why a person would pass this one on: the reason the widget is in the gallery at all.
pub const WIDGET_HOOKS : [140]str = ["The bitstream is byte-identical to openXC7's and runs on a real board: the claim most FPGA people doubt, shown.", "A Xilinx 7-series bitstream assembled with no Vivado anywhere in the path.", "Plant a bug in the bitstream path and watch the tests catch it: mutation testing for hardware.", "Place and route to a loaded bitstream, with the clock on screen.", "RGMII hold margins read from nextpnr's own SDF, not from a datasheet.", "The cable asks which chip is there and the chip answers with its IDCODE.", "Before an edit to a Verilog file: every spec and generator it would touch.", "The whole FPGA flow, one layer per line, from spec to board.", "A spec turned into Verilog inside a post, with the RTL read the way a hardware engineer reads it.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "17 of 17 conformance specs compile, their test blocks pass, and no generated file has drifted.", "14 of 14 bench tools pass their own self-tests in one sweep: decode 18/18, repin 17/17, firelog 10/10, tmpcheck 9/9, stamps 9/9, keep 9/9.", "Requested 115,200 puts 115,385 on the wire (+0.16 %), 921,600 puts 923,077, and 3,000,000 is exact.", "26 checks, no board, no RTL: every receipt returns, 11 loss and fault cases recover, and a lie stops the run.", "One command reads the bench: cables, locks, and the last board runs: three x7-board runs PASS 51840/51840.", "112 files under /tmp pinned by sha256 in specs: every one has a kept copy, 0 lost, 0 unlocated.", "84 board and model logs scanned for the TRI-NET key: 0 hits, 0 logs of 1 MB or more.", "16 spec-named scripts run their own --self-test, 0 bad; 8 without the flag are listed, not skipped silently.", "The part table in far.t27 matches prjxray-db part.json, all 6 reference bitstreams present, bitwalk reads all 6 in 84.4 ms.", "One command re-runs every sweep: CRC 12/12, ECC 32520/32520 frames, 82/82 pins, 4224/4224 segbits, gold 5/5. audit: CLEAN.", "The t27 compiler running as WebAssembly in a post: compile, test, seven backends.", "The same spec as Rust, printed by a terminal in the page.", "The only backend that runs in the browser: generate the module, then run it.", "t27c on hello_world.t27, on a real machine, every byte as printed.", "Code that compiles and is wrong: the tool that finds it.", "", "", "The OCP MX scale byte as a spec: 2^(e-127), code 255 is NaN, 18 tests and 9 comptime invariants, compiled on a real machine.", "The same scale byte compiled in your browser: seven backends, the spec's tests run in the page, and every skip says why.", "One outlier sets the scale for 32 weights: MXFP4 flushes 23 of them to zero, MXFP8 E4M3 none. 49 tests pass; a planted bug fails one.", "Ternary weights scaled by phi, compiled in your browser: codes 00, 01, 10, and the fourth code folded to zero.", "13 of 13 tests pass natively, and the report says 8 of them executed no assert; a planted bug fails exactly one.", "Five measured rules for a ternary weight alphabet, and the one formula that passes all five, run in your browser.", "One more trit and the spec does not compile at all: BLOCKED, not failed, because no test ever ran.", "A 17-bit float whose exponent is four balanced trits, 3^4 = 81 values, compiled in your browser.", "34 tests pass natively, none vacuous; swap one XOR for OR and only the test that negates twice fails.", "A neuron's sum squeezed back to one trit: 7 tests pass natively, and turning one > into >= fails only the boundary test.", "One ternary neuron, two functions picked by its weights: 12 tests pass natively, and one weight moved from P to Z fails exactly one.", "A neuron wider than 27 inputs, summed chunk by chunk: 11 tests pass natively, and a loop that stops after one chunk fails exactly one.", "A 27-lane ternary dot product as pure wires: 4 tests pass natively, and one wrong sign in tmul fails exactly one.", "The same dot product added into a register on every clock: 4 tests pass natively, and a lane mask short one bit fails exactly one.", "A whole small ternary network, 3 neurons then 2: 4 tests pass natively, and a trit packed one bit low fails exactly one.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "Recording pending: waits on tri test and tri mutate plant from gHashTag/t27#7400. Until then this page is a placeholder and shows no run.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "34 vector files, 512 cases: 2 files executed, 8 debt, 24 prose-only; 19% carry data.", "Four census populations recounted another way all agree; three are named as uncheckable.", "31 of 1,428 seals record no output (16 specs); 3 of those are missing from the debt ledger.", "11 specs refused at parse, 0 blocked only by prose, 23 broken on purpose as fixtures.", "12 Lean files, 15,553 lines and 4 sorry, are reached by no build root: nothing compiles them.", "tri, railway, python3 and the loop directory: each present or not, in one call.", "The terminal for seven t27 backends: every command run on hello_world. 21 pass, 0 fail.", "Pick a lane and see whether the TRI decision layer beats the baseline on the same issue.", "One tick of the Queen's loop: an anomaly scan that reports only what changed.", "The loop's skills checked against snapshots before an agent may use them.", "Three performance bits, and one knockout bitstream per bit to prove each one matters.", "", ""];

; --- Ideas: asked for, not built ---------------------------------------------------------------
; From what engineers share today (gh-skyline, Tiny Tapeout renders, Wrapped cards, Gatle-style
; daily puzzles, carbon.now.sh) and what none of them does for FPGA output. Each names the data
; it would read: a file the reader drops, or a run already in this repository. None is shown
; as working. Built ideas move up to WIDGET_IDS (tri widget gallery-add); the shelf refills from research.
pub const IDEA_COUNT : u8 = 6;
pub const IDEA_IDS : [6]str = ["same-circuit", "lut-golf", "wave-card", "die-guessr", "xdc-check", "open-flow-check"];
pub const IDEA_TITLES : [6]str = ["Same circuit?", "LUT golf", "Wave card", "Die guessr", "Ports your XDC forgot to constrain", "Can I build this FPGA without Vivado"];
pub const IDEA_LINES : [6]str = ["Paste two versions of a module: yosys proves them the same circuit in the browser, or prints the input that tells them apart.", "One small function a day and a reference LUT count: write a smaller circuit, prove it equivalent, then compare.", "Drop a .vcd, pick six signals and a window, and get a waveform image of what the simulator printed, with the file hash under it.", "A daily placement picture from a real nextpnr run on an Artix-7 200T: guess which of our specs it is.", "Drop an XDC file and your top-level port list to see ports with no PACKAGE_PIN, no IOSTANDARD, or clocks with no create_clock.", "Type a Xilinx part number and see whether openFPGALoader, prjxray-db and nextpnr-xilinx list it, each with source and date."];
pub const IDEA_SOURCES : [6]str = ["yosys miter -equiv and sat -prove-asserts, run as WebAssembly in the page; sequential designs bounded to N cycles, said on the card", "yosys synth_xilinx stat after an equivalence check, both in the browser", "the reader VCD converted to WaveJSON and drawn by WaveDrom (MIT)", "Competitor sweep 2026-10-05, idea rank 7 (die-guessr), narrowed to our own runs", "ZipCPU clock and constraint posts; nextpnr-xilinx constraint warnings; Mastodon open-toolchain log screenshots", "Vivado 2026.1 Linux free-tier backlash and AMD reversal (HN 48254574, AMDembedded on X); openFPGALoader v1.1.x; openXC7 prebuilt releases"];

; --- Tests -----------------------------------------------------------------------------------
test the_player_embed_is_sixteen_by_nine {
    assert EMBED_WIDTH * 9 == PLAYER_EMBED_HEIGHT * 16;
    assert CAST_EMBED_HEIGHT > PLAYER_EMBED_HEIGHT;
}

test every_category_has_a_name_and_a_line {
    assert CATEGORY_COUNT == 3;
    assert CATEGORY_IDS[0] == "fpga";
    assert CATEGORY_IDS[1] == "compiler";
    assert CATEGORY_IDS[2] == "game";
}

test the_fpga_shelf_comes_first_and_opens_on_the_board {
    assert WIDGET_CATEGORIES[0] == "fpga";
    assert WIDGET_IDS[0] == "x7-board";
    assert WIDGET_KINDS[0] == "cast";
}

test the_arena_is_a_tab_and_says_its_own_words {
    assert WIDGET_IDS[134] == "wars";
    assert WIDGET_KINDS[134] == "tab";
    assert WIDGET_PAGES[134] == "wars";
}

test the_gallery_posts_nothing {
    assert POSTS_NOTHING == true;
}

test the_ai_number_shelf_closes_the_compiler_run {
    assert WIDGET_IDS[49] == "t27c-e8m0";
    assert WIDGET_IDS[50] == "play-e8m0";
    assert WIDGET_PAGES[50] == "play/e8m0/";
    assert WIDGET_IDS[51] == "t27c-ocp-mx";
    assert WIDGET_CATEGORIES[51] == "compiler";
}

test the_ternary_shelf_follows_the_mx_block {
    assert WIDGET_IDS[52] == "play-gfternary";
    assert WIDGET_PAGES[52] == "play/gfternary/";
    assert WIDGET_IDS[55] == "t27c-golden-sieve";
    assert WIDGET_KINDS[55] == "cast";
    assert WIDGET_IDS[57] == "t27c-tnf17";
    assert WIDGET_CATEGORIES[57] == "compiler";
}

test the_verification_shelf_is_rehearsals_and_audits {
    assert WIDGET_IDS[32] == "tri-fpga-specs";
    assert WIDGET_KINDS[32] == "cast";
    assert WIDGET_CATEGORIES[32] == "fpga";
    assert WIDGET_IDS[41] == "tri-x7-audit";
    assert WIDGET_IDS[127] == "t27-tri-vectors";
    assert WIDGET_CATEGORIES[127] == "compiler";
    assert WIDGET_IDS[133] == "play-terminal-gates";
}

test ideas_are_counted_apart_from_widgets {
    assert IDEA_COUNT == 6;
    assert WIDGET_IDS[139] == "gatle";
    assert WIDGET_COUNT == 140;
}

test every_tool_lives_under_widgets_and_keeps_its_words_on_its_page {
    assert WIDGET_KINDS[9] == "tool";
    assert WIDGET_PAGES[9] == "widgets/bit-diff/";
    assert WIDGET_HOOKS[9] == "";
    assert WIDGET_KINDS[138] == "tool";
    assert WIDGET_CATEGORIES[138] == "game";
    assert WIDGET_PAGES[138] == "widgets/race-the-bee/";
}

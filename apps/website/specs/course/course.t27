    "Open the mutation recording under Also try and count how many planted bugs the tests caught.",
    "Pick an example and step through the stages; find the stage where a type error would stop.",
    "Find the line where t27c prints the Verilog module's parameters.",
    "Switch the player to JavaScript under Also try, generate the module, and run it.",
    "Open clocked_counter.t27 in the player and find the always block in its Verilog tab.",
    "Open the real sample, then read the LUT and FF counts on the card.",
    "Try the XOR6 and majority examples, then play five rounds of Guess the gate.",
    "Open each real log and find the one that yosys refused, and why.",
    "Open the uart_rx sample and count its states and transitions.",
    "Switch between the hierarchical and flattened totals and find the largest tile.",
    "Fit the design, then tap cells of different types and read their BEL names.",
    "Open the real sample and count how many steps of the path are LUTs.",
    "Click the worst path and compare its logic time with its routing time.",
    "Find where the recording says how many frames matched, out of how many.",
    "Read the receipt: which stage took the longest, and which tool ran it?",
    "Open the blink_j26 sample and compare the part in its header with the IDCODE it writes.",
    "Find which IDCODE belongs to an XC7A200T and which to an XC7A100T.",
    "Wait for the receipts count at the end, then try bit-diff under Also try.",
    "Play today's puzzle. Then read the module's Verilog and say why it cost what it did.",
    "Move the weight across the range and find where E2M1 rounds worse than T27; then read the storage table in bits.",
    "Find the NVFP4 ratio and the threshold line; then name the format T27 loses to and what it pays for that.",
    "Drag the window until the bucket overflows and note the largest window that fits; then compare the two real runs.",
    "Run the tests and count the skips; then open the Verilog and find the function that checks for code 255.",
    "Find how many invariants the test report proved at compile time, and compare its pass count with the player's.",
    "Read which element format flushes the most small weights to zero and which two flush none; then find the test the planted bug breaks."
];

; --- Claims --------------------------------------------------------------------------------
test the_core_is_three_cubed {
    assert LESSONS_PER_MODULE == 3;
    assert MODULE_COUNT == 11;
    assert LESSON_COUNT == 33;
    assert LESSON_COUNT - 2 * LESSONS_PER_MODULE == 27;
    assert MODULE_COUNT * LESSONS_PER_MODULE == LESSON_COUNT;
}

test it_starts_at_the_chip_and_ends_on_the_board {
    assert MODULE_IDS[0] == "chip";
    assert MODULE_IDS[8] == "board";
    assert LESSON_MODULES[0] == "chip";
    assert LESSON_MODULES[26] == "board";
    assert LESSON_WIDGETS[26] == "gatle";
}

test the_lab_comes_after_the_core {
    assert MODULE_IDS[9] == "lab";
    assert LESSON_MODULES[27] == "lab";
    assert LESSON_MODULES[29] == "lab";
    assert LESSON_WIDGETS[27] == "t27-cell";
}

test the_mx_module_comes_after_the_lab {
    assert MODULE_IDS[10] == "mx";
    assert LESSON_MODULES[30] == "mx";
    assert LESSON_MODULES[32] == "mx";
    assert LESSON_WIDGETS[30] == "play-e8m0";
    assert LESSON_WIDGETS[31] == "t27c-e8m0";
    assert LESSON_WIDGETS[32] == "t27c-ocp-mx";
    assert LESSON_SPECS[31] == "specs/numeric/e8m0.t27";
}

test the_compiler_module_opens_the_compiler {
    assert LESSON_MODULES[9] == "compiler";
    assert LESSON_WIDGETS[9] == "t27c-stages";
    assert LESSON_SPECS[12] == "specs/ternary/clocked_counter.t27";
}

test the_course_sends_nothing {
    assert SENDS_NOTHING == true;
    assert LOCALES[0] == "en";
    assert LOCALES[1] == "ru";
}

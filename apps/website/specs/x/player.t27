// SPDX-License-Identifier: Apache-2.0
; specs/x/player.t27 -- a t27 spec, compiled and run inside a post on X
; Source of truth for apps/website/scripts/play-from-spec.mjs (gHashTag/trinity), which
; compiles this file with the vendored compiler (public/t27/t27_compiler.wasm), checks the
; constant schema, evaluates every test block below, and only then writes one share page per
; play under public/play/<id>/ and a byte-identical copy of this file at public/play/player.t27.
; The player (public/play/embed.js) compiles that copy again, in the reader's browser, with the
; same compiler, and takes its tabs, its timing and its honesty note from the constants below.
; Nothing about the player is typed twice: not here and in the page, not here and in the script.
; ASCII only (L3), English only (LANG-EN).

; WHAT X GIVES US: the player card. A post whose only link points at a page carrying
; twitter:card = player shows that page's still image. On x.com a click swaps the image for an
; iframe of the address in twitter:player; X adds autoplay=1 and auto_play=true to it. The X
; apps on a phone show the image and open the page in their own browser. The numbers in the
; second section are X's rules, from its card documentation, not ours:
; https://developer.x.com/en/docs/x-for-websites/cards/overview/player-card

; WHAT THE READER GETS: the compiler itself, the same WebAssembly module t27.ai runs, on the
; spec named by the play. Compile is a short linear piece -- source, lexer, parser, types, HIR,
; seven backends, tests -- and every number in it is the compiler's answer for that file, read
; while it plays. The spec can be edited in place and compiles again as it is typed. Tests runs
; the spec's own test blocks. Code shows what each backend emitted, coloured the way the spec
; explorer colours it. RTL reads the emitted Verilog the way a hardware engineer would before
; synthesis: the module's ports and parameters, the bit map of every packed struct, the
; functions, and what a Verilog-2005 tool will refuse in that text. Term replays a recording of
; t27c on the same file in a terminal.

; WHAT IS DELIBERATELY ABSENT: sound, a sign-in, a cookie, a request to any host but t27.ai,
; and a test outcome this page made up. A block the evaluator cannot follow is a skip and says
; why; it is never counted as a pass, and it is never counted as a fail.
; phi^2 + 1/phi^2 = 3 | TRINITY

module x_player;

pub const KIND : str = "player";
pub const ID : str = "x/player";
pub const NAME : str = "t27 in a post";
; The derived files the generator rewrites (relative to apps/website): this spec's public copy,
; then the site modules below as one ES module, then one share page per play, in PLAY_IDS order.
pub const GENERATED : [3]str = ["public/play/player.t27", "public/play/site.js", "public/play/hello-world/index.html"];

; --- What the player takes from the site -------------------------------------------------------
; The spec explorer's highlighter and palette, bundled from the site's own source rather than
; copied into the player: a second copy of a colour table is where two pages start to disagree.
; SITE_IMPORTS[i] names what is taken from SITE_MODULES[i] (paths relative to apps/website).
pub const SITE_MODULES : [2]str = ["src/lib/highlight.ts", "src/lib/explorerTheme.ts"];
pub const SITE_IMPORTS : [2]str = ["highlightSource, highlightCode, CLS_COLOR, TARGET_LANG", "C"];
pub const SITE_BUNDLE : str = "public/play/site.js";

; --- The card, as X defines it -------------------------------------------------------------
pub const CARD : str = "player";
pub const SITE_HANDLE : str = "@t27_dev";
pub const ORIGIN : str = "https://t27.ai/";
; The iframe page every play shares; the play is named in its query.
pub const EMBED : str = "play/embed.html";
; Where the player's open link goes: ORIGIN, then this, then the spec path, URL-encoded.
pub const SPEC_PAGE : str = "?lang=en#/specs?spec=";
pub const TITLE_MAX : u8 = 70;
pub const DESCRIPTION_MAX : u8 = 200;
pub const IMAGE_ALT_MAX : u16 = 420;
; The iframe size the card declares. X scales it down to the timeline; the image should match.
pub const PLAYER_WIDTH : u16 = 1200;
pub const PLAYER_HEIGHT : u16 = 675;
pub const IMAGE_WIDTH : u16 = 1200;
pub const IMAGE_HEIGHT : u16 = 675;
; Below this many pixels X does not render the card at all (262x262, or 350x196 at 16:9).
pub const IMAGE_MIN_AREA : u32 = 68600;
; X takes images under 5 MB; held to 5 000 000 bytes so the margin is not a rounding question.
pub const IMAGE_MAX_BYTES : u32 = 5000000;
pub const IMAGE_FILE : str = "card.png";

; --- Motion and sound ------------------------------------------------------------------------
; X's rule for a player card: nothing longer than ten seconds starts by itself, and nothing
; starts with sound. The compile piece runs once, shorter than the limit, and then stops.
pub const AUTOPLAY_LIMIT_MS : u16 = 10000;
pub const COMPILE_ANIMATION_MS : u16 = 8000;
pub const HAS_SOUND : bool = false;
; The query keys X appends when a reader clicks the card. Either one starts the piece.
pub const AUTOPLAY_PARAMS : [2]str = ["autoplay", "auto_play"];

; --- Layout ------------------------------------------------------------------------------------
pub const TABS : [6]str = ["compile", "spec", "tests", "code", "rtl", "term"];
pub const TAB_LABELS : [6]str = ["Compile", "Spec", "Tests", "Code", "RTL", "Term"];
pub const FIRST_TAB : str = "compile";
; At this width and above the spec stays beside the active tab instead of being a tab of its own.
pub const WIDE_MIN_PX : u16 = 900;
pub const RECOMPILE_DEBOUNCE_MS : u16 = 250;

; --- Honesty ------------------------------------------------------------------------------------
; There is no other runner for these test blocks today: the Zig test report does not build for
; hello_world and the JS backend emits declarations only. So the page runs them itself, and says
; what that means beside the result.
pub const OUTCOMES : [3]str = ["pass", "fail", "skip"];
pub const SKIP_IS_NEVER_PASS : bool = true;
pub const TESTS_NOTE : str = "Run here, in your browser, by a small evaluator over the compiler's syntax tree. Fail means an assert was false, or the block divided by zero or indexed past the end. Anything the evaluator cannot follow is a skip and names the reason; a skip is never counted as a pass.";

; --- Plays ---------------------------------------------------------------------------------------
; One entry per play, the same position in every array. SPEC is a path under public/t27/files/;
; CAST names a recording published at public/term/<cast>/.
pub const PLAY_COUNT : u8 = 1;
pub const PLAY_IDS : [1]str = ["hello-world"];
pub const PLAY_SPECS : [1]str = ["specs/demos/hello_world.t27"];
pub const PLAY_CASTS : [1]str = ["t27c-hello-world"];
pub const PLAY_TITLES : [1]str = ["hello_world.t27, compiled inside the post"];
pub const PLAY_DESCRIPTIONS : [1]str = ["The t27 compiler, as WebAssembly, running on one spec in your browser: lexer to seven backends in eight seconds, the spec's own tests, the emitted code, its Verilog read for synthesis, and a t27c run."];
pub const PLAY_IMAGE_ALTS : [1]str = ["The t27 player: hello_world.t27 on the left, the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal recording."];

test the_player_is_sixteen_by_nine {
    assert PLAYER_WIDTH * 9 == PLAYER_HEIGHT * 16;
    assert IMAGE_WIDTH == PLAYER_WIDTH;
    assert IMAGE_HEIGHT == PLAYER_HEIGHT;
}

test the_image_is_large_enough_for_x_to_render {
    assert IMAGE_WIDTH * IMAGE_HEIGHT >= IMAGE_MIN_AREA;
}

test nothing_starts_by_itself_for_longer_than_the_limit {
    assert COMPILE_ANIMATION_MS <= AUTOPLAY_LIMIT_MS;
    assert COMPILE_ANIMATION_MS > 0;
    assert HAS_SOUND == false;
}

test a_skip_is_never_a_pass {
    assert SKIP_IS_NEVER_PASS == true;
    assert OUTCOMES[0] == "pass";
    assert OUTCOMES[1] == "fail";
    assert OUTCOMES[2] == "skip";
}

test the_piece_opens_on_the_compile_run {
    assert TABS[0] == FIRST_TAB;
    assert TABS[0] == "compile";
    assert TAB_LABELS[0] == "Compile";
}

test the_rtl_tab_reads_the_verilog_backend {
    assert TABS[4] == "rtl";
    assert TAB_LABELS[4] == "RTL";
}

test the_site_bundle_is_generated_with_the_rest {
    assert GENERATED[0] == "public/play/player.t27";
    assert GENERATED[1] == SITE_BUNDLE;
    assert SITE_MODULES[0] == "src/lib/highlight.ts";
}

test the_first_play_is_hello_world {
    assert PLAY_COUNT == 1;
    assert PLAY_IDS[0] == "hello-world";
    assert PLAY_SPECS[0] == "specs/demos/hello_world.t27";
}

module fn_crm_proactive_sweep;

pub const KIND : str = "function";
pub const ID : str = "crm-proactive-sweep";
pub const LEGACY_ID : str = "crm-proactive-sweep";
pub const NAME : str = "CRM: proactive seller sweep";
pub const REPO : str = "999-multibots-telegraf";
; file:line of inngest.createFunction( in the repo named in REPO
pub const SERVICE : str = "src/inngest_app/functions/crm/crmProactiveSweep.ts:101";
pub const DOMAIN : str = "crm";
; "event" or "cron"; an event function has EVENT (+ LEGACY_EVENTS), a cron function has CRON
pub const TRIGGER : str = "cron";
pub const EVENT : str = "";
pub const LEGACY_EVENTS : [0]str = [];
pub const CRON : str = "*/30 * * * *";
pub const TZ : str = "UTC";
pub const SUMMARY_EN : str = "Every half hour resolves the sellers a registered carrier serves and sweeps each one: the render's CRM tools are called over HTTP, a model is asked what to do next, and an outreach card is pushed to that seller's own chat. Safe mode skips the whole run.";
; step.run names in source order
pub const STEPS : [2]str = ["resolve-sellers", "sweep-${owner}"];
; retries declared on the function; when the code declares none, the Inngest JS SDK v3 default (4) is written and NOTE says so
pub const RETRIES : u8 = 0;
; "admin-telegram" (onFailure handler messages the admin chat), "log" (no handler) or "refund+notify"
pub const ON_FAILURE : str = "admin-telegram";
; what a run touches outside the function, from a fixed vocabulary (see README)
pub const SIDE_EFFECTS : [4]str = ["messages-owners", "paid-api", "external-webhook", "db-write"];
; the first step that stops a bad payload; "none" when the first step already acts, "unknown" when not probed
pub const GUARD : str = "safe-mode";
; JSON payload of the 2026-09-09 safe probe and what it reached ("" / "skipped" when none was sent; "not-deployed" when the function is not on the probed build)
pub const SAFE_PROBE : str = "";
pub const PROBE_RESULT : str = "skipped";
pub const CONTROL : str = "spec+code";
pub const NOTE : str = "No safe probe has been sent: the 2026-09-09 probe pass predates this registration, which is why the manifest row carries no deployment reading. The live status endpoint answered on 2026-09-22 with 337 runs over seven days and 5 failed, the only function in the project with a failure in that window, so this card exists to make that number reachable. The step name sweep-${owner} is a template expanded once per seller. SIDE_EFFECTS reads the service the run calls into (services/crmProactive.ts): the outreach card goes to the seller who owns the bot, not to the end client, so it is messages-owners and not the manifest's messages-user; the render's MCP route is called over HTTPS (external-webhook) and a model turn is paid for (paid-api). GUARD is the isSafeMode early return at the top of the handler, which the manifest recorded as none. The same schedule is also stated by the timer cron card timer/999-multibots-telegraf/crmProactive-L375, the in-process setInterval this cron replaced on 2026-09-12; CRM_SWEEP_DRIVER=timer restores it.";

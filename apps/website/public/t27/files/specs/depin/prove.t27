// SPDX-License-Identifier: Apache-2.0
// DePIN proof-of-useful-compute spec
// Issue #40 — L-TRI-1: POST /prove endpoint
// phi^2 + phi^-2 = 3 | TRINITY

module depin.prove;

// ============================================================================
// Types
// ============================================================================

pub struct ProveRequest {
    node_id : [u8; 32],
    epoch : u64,
    phi_response : Vec<u8>,
    merkle_proof : MerkleProof,
    merkle_leaf_index : usize,
    peer_sample_sig : [u8; 64],
    version : u8,
}

pub struct MerkleProof {
    root : [u8; 32],
    leaf : [u8; 32],
    siblings : Vec<[u8; 32]>,
}

pub struct ProveResponse {
    valid : bool,
    reward_lamports : u64,
    epoch_hash : [u8; 32],
    next_challenge : [u8; 16],
    tokens_count : u64,
    reason : ?[]const u8,
}

pub struct MiningEpoch {
    epoch_id : u64,
    phi_seed : [u8; 16],
    start_ts : u64,
    block_reward : u64,
}


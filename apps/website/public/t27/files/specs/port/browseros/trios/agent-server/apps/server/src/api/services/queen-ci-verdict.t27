module QueenCiVerdict;

pub const RED_ITEMS: [5][]const u8 = [
    "failure",
    "timed_out", 
    "cancelled",
    "action_required",
    "startup_failure",
];

pub const CI_CHECKS_PER_ROUND: u32 = 8;
pub const CI_MAXIMUM_SEND_BACKS: u32 = 2;
pub const NOTE_MAX: u32 = 1500;
pub const ERROR_MAX: u32 = 600;

pub const CheckRun = struct {
    id: u32,
    name: []const u8,
    status: []const u8,
    conclusion: []const u8, // empty slice represents null
    url: []const u8, // empty slice represents null
};

pub const PullRequest = struct {
    number: u32,
    state: []const u8,
    merged: bool,
    headSha: []const u8,
};

pub const TakenBack = struct {
    issue: u32,
    pull: u32,
    state: []const u8, // 'sendBack' or 'escalate'
    checks: [][]const u8, // array of check names
};

// CiDeps is an interface - for the port we'll define the decision helpers
pub const CiDeps = struct {
    requiredChecks: fn () -> [][]const u8,
    pullsForBranch: fn (branch: []const u8) -> []PullRequest,
    checkRuns: fn (sha: []const u8) -> []CheckRun,
    jobLog: fn (jobId: u32) -> []const u8,
};


// Helper functions for testing decision logic in takeBackRefusedAcceptances
pub fn shouldTakeBack(
    requiredChecks: [][]const u8,
    pulls: []PullRequest,
    branch: []const u8,
    checkRuns: []CheckRun,
    sendBacksCount: u32
) -> bool {
    // Decision logic from takeBackRefusedAcceptances:
    // 1. requiredChecks must not be empty
    // 2. There must be an open PR for the branch (not merged)
    // 3. There must be check runs for the PR head SHA
    // 4. There must be refused required checks
    
    if requiredChecks.len == 0 {
        return false;
    }
    
    // Find open PR for branch (not merged)
    var hasOpenPr: bool = false;
    for i in 0..pulls.len {
        var pr = pulls[i];
        if std.mem.eql(u8, pr.state, "open") && !pr.merged {
            hasOpenPr = true;
            break;
        }
    }
    
    if !hasOpenPr {
        return false;
    }
    
    // We would check if checkRuns is not empty (in real code)
    // and then check if refusedRequired returns non-empty
    // For now, we'll just return true if we got this far and checkRuns exists
    return checkRuns.len > 0;
}

// Helper to determine if should escalate
pub fn shouldEscalate(sendBacksCount: u32) -> bool {
    return sendBacksCount >= CI_MAXIMUM_SEND_BACKS;
}

test refusedRequired_empty_input {
    var runs: [0]CheckRun = [];
    var required: [0][]const u8 = [];
    var result = refusedRequired(runs, required);
    assert(result.len == 0);
}

test refusedRequired_no_matches {
    var run = CheckRun{id: 1, name: "lint", status: "completed", conclusion: "success", url: ""};
    var runs = [run];
    var required: [1][]const u8 = ["test"];
    var result = refusedRequired(runs, required);
    assert(result.len == 0);
}

test refusedRequired_single_red {
    var run = CheckRun{id: 1, name: "test", status: "completed", conclusion: "failure", url: ""};
    var runs = [run];
    var required: [1][]const u8 = ["test"];
    var result = refusedRequired(runs, required);
    assert(result.len == 1);
    assert(std.mem.eql(u8, result[0].name, "test"));
}

test refusedRequired_duplicates_take_newest {
    var run1 = CheckRun{id: 1, name: "test", status: "completed", conclusion: "failure", url: ""};
    var run2 = CheckRun{id: 2, name: "test", status: "completed", conclusion: "failure", url: ""};
    var runs = [run1, run2];
    var required: [1][]const u8 = ["test"];
    var result = refusedRequired(runs, required);
    assert(result.len == 1);
    assert(result[0].id == 2); // Should get the newer one (id 2)
}

test refusedRequired_ignores_pending {
    var run = CheckRun{id: 1, name: "test", status: "in_progress", conclusion: "", url: ""};
    var runs = [run];
    var required: [1][]const u8 = ["test"];
    var result = refusedRequired(runs, required);
    assert(result.len == 0); // Should be ignored because not completed (empty conclusion)
}

test errorLinesOf_helpers {
    // Test that our helper functions work correctly
    var line = "2026-09-22T10:30:00Z ##[error] Something went wrong";
    var trimmed = removeTimestampPrefix(line);
    assert(std.mem.eql(u8, trimmed, "##[error] Something went wrong"));
    var withoutMarker = removeErrorMarker(trimmed);
    assert(std.mem.eql(u8, withoutMarker, "Something went wrong"));
}

test errorLinesOf_filters_process_completed {
    var line = "##[error] Process completed with exit code 1";
    assert(startsWithErrorMarker(line));
    var cleaned = removeErrorMarker(line);
    assert(std.mem.eql(u8, cleaned, "Process completed with exit code 1"));
    assert(startsWithProcessCompleted(cleaned));
    
    var line2 = "##[error] Something went wrong";
    assert(startsWithErrorMarker(line2));
    var cleaned2 = removeErrorMarker(line2);
    assert(std.mem.eql(u8, cleaned2, "Something went wrong"));
    assert(!startsWithProcessCompleted(cleaned2));
}

test ciRefusalNote_structure {
    // Test that we can at least call the function with proper types
    var pulled: u32 = 123;
    var branch = "main";
    var refused: [0][]const u8 = [];
    _ = ciRefusalNote(pulled, branch, refused); // Just check it compiles
}

test shouldTakeBack_basic {
    var required: [1][]const u8 = ["test"];
    var pulls: [0]PullRequest = [];
    var branch = "main";
    var checkRuns: [0]CheckRun = [];
    var sendBacksCount = 0;
    assert(!shouldTakeBack(required, pulls, branch, checkRuns, sendBacksCount)); // No PRs
    
    var pr = PullRequest{number: 1, state: "open", merged: false, headSha: "abc"};
    var pullsWithPr = [pr];
    assert(!shouldTakeBack(required, pullsWithPr, branch, checkRunsWithPr, sendBacksCount)); // No check runs
    
    var checkRun = CheckRun{id: 1, name: "test", status: "completed", conclusion: "success", url: ""};
    var checkRunsWithRun = [checkRun];
    assert(!shouldTakeBack(required, pullsWithPr, branch, checkRunsWithRun, sendBacksCount)); // Not red
    
    var checkRunRed = CheckRun{id: 1, name: "test", status: "completed", conclusion: "failure", url: ""};
    var checkRunsWithRed = [checkRunRed];
    assert(shouldTakeBack(required, pullsWithPr, branch, checkRunsWithRed, sendBacksCount)); // All conditions met
}

test shouldEscalate_basic {
    assert(!shouldEscalate(0));
    assert(!shouldEscalate(1));
    assert(shouldEscalate(2)); // CI_MAXIMUM_SEND_BACKS is 2
    assert(shouldEscalate(3));
}


pub fn githubCiDeps_requiredChecks_impl(repo: []const u8, baseBranch: []const u8) -> [][]const u8;
pub fn githubCiDeps_pullsForBranch_impl(repo: []const u8, baseBranch: []const u8, branch: []const u8) -> []PullRequest;
pub fn githubCiDeps_checkRuns_impl(repo: []const u8, baseBranch: []const u8, sha: []const u8) -> []CheckRun;
pub fn githubCiDeps_jobLog_impl(repo: []const u8, baseBranch: []const u8, jobId: u32) -> []const u8;

// Helper function to check if a string is in our RED set
pub fn isRedConclusion(conclusion: []const u8) -> bool {
    for item in &RED_ITEMS {
        if (std.mem.eql(u8, item, conclusion)) {
            return true;
        }
    }
    return false;
}

// Helper function to check if a string is in required set
pub fn isRequired(name: []const u8, required: [][]const u8) -> bool {
    for req in &required {
        if (std.mem.eql(u8, req, name)) {
            return true;
        }
    }
    return false;
}

// Helper function to check if a CheckRun is completed and has a conclusion
pub fn isCheckRunCompleted(run: CheckRun) -> bool {
    // status == "completed" and conclusion != null (non-empty slice)
    return std.mem.eql(u8, run.status, "completed") && run.conclusion.len > 0;
}

// Helper function to trim whitespace from start and end of string
pub fn trimWhitespace(s: []const u8) -> []const u8 {
    var start: usize = 0;
    var end: usize = s.len;
    
    // Trim start
    while (start < end && (s[start] == ' ' || s[start] == '\t' || s[start] == '\r' || s[start] == '\n')) {
        start += 1;
    }
    
    // Trim end
    while (end > start && (s[end-1] == ' ' || s[end-1] == '\t' || s[end-1] == '\r' || s[end-1] == '\n')) {
        end -= 1;
    }
    
    return s[start..end];
}

// Helper function to remove timestamp prefix from log line
pub fn removeTimestampPrefix(line: []const u8) -> []const u8 {
    // Format: YYYY-MM-DDTHH:MM:SS.sssZ or similar
    // We look for a pattern like \d{4}-\d{2}-\d{2}T[\d:.]+Z
    // Simple approach: if line starts with a digit and has T and Z in reasonable positions
    if (line.len < 20) return line; // Too short to have timestamp
    
    // Check if it starts with YYYY-MM-DDTHH:MM:SS
    if (line[0] >= '0' && line[0] <= '9' && 
        line[4] == '-' && line[7] == '-' && line[10] == 'T' &&
        line[19] == 'Z') {
        // Find the first space after the timestamp
        var i: usize = 20;
        while i < line.len && line[i] != ' ' {
            i += 1;
        }
        if i < line.len {
            return line[i+1..line.len]; // Skip the space too
        }
    }
    return line;
}

// Helper function to check if line starts with "##[error]"
pub fn startsWithErrorMarker(line: []const u8) -> bool {
    const marker: []const u8 = "##[error]";
    if line.len < marker.len {
        return false;
    }
    return std.mem.eql(u8, line[0..marker.len], marker);
}

// Helper function to remove "##[error]" prefix
pub fn removeErrorMarker(line: []const u8) -> []const u8 {
    const marker: []const u8 = "##[error]";
    if line.len < marker.len || !std.mem.eql(u8, line[0..marker.len], marker) {
        return line;
    }
    return line[marker.len..line.len];
}

// Helper function to check if line starts with "Process completed with exit code"
pub fn startsWithProcessCompleted(line: []const u8) -> bool {
    const prefix: []const u8 = "Process completed with exit code";
    if line.len < prefix.len {
        return false;
    }
    return std.mem.eql(u8, line[0..prefix.len], prefix);
}

// 1. refusedRequired - ports the decision logic
pub fn refusedRequired(runs: []CheckRun, required: [][]const u8) -> []CheckRun {
    // Create a map to track newest run by name (using fixed-size array)
    var newestRuns: [100]CheckRun = undefined;
    var newestLen: usize = 0;
    
    // First pass: find newest run for each required check
    for i in 0..runs.len {
        var run = runs[i];
        if !isRequired(run.name, required) {
            continue;
        }
        
        // Check if we already have this name in newestRuns
        var foundIndex: ?usize = null;
        for j in 0..newestLen {
            if std.mem.eql(u8, newestRuns[j].name, run.name) {
                foundIndex = j;
                break;
            }
        }
        
        if foundIndex == null {
            // Add new entry
            if newestLen < 100 {
                newestRuns[newestLen] = run;
                newestLen += 1;
            }
        } else if run.id > newestRuns[foundIndex.*].id {
            // Replace with newer one
            newestRuns[foundIndex.*] = run;
        }
    }
    
    // Second pass: filter for completed runs with red conclusions
    var result: [100]CheckRun = undefined;
    var resultLen: usize = 0;
    
    for i in 0..newestLen {
        var run = newestRuns[i];
        if isCheckRunCompleted(run) && isRedConclusion(run.conclusion) {
            if resultLen < 100 {
                result[resultLen] = run;
                resultLen += 1;
            }
        }
    }
    
    // Return slice of result
    return result[0..resultLen];
}


// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/conformance/witness/gf48_fp64/gf_decode_param_fp64.t27
// Port of conformance/witness/gf48_fp64/gf_decode_param_fp64.v
// Parametric GoldenFloat GF{N} decode to IEEE binary64 (FP64)
// phi^2 + 1/phi^2 = 3 | TRINITY

module gf_decode_param_fp64 {

    // === Default parameters (gf48: S1 E18 M29, BIAS=131071) ===
    pub const DEFAULT_N : u32 = 48;
    pub const DEFAULT_E : u32 = 18;
    pub const DEFAULT_M : u32 = 29;
    pub const DEFAULT_BIAS : u32 = 131071;
    pub const DEFAULT_OUT_REG : u32 = 0;

    // === FP64 constants ===
    pub const FP64_EBIAS : i32 = 1023;
    pub const FP64_MANT : u32 = 52;
    pub const FP64_MIN_NORM_EXP : i32 = -1022;
    pub const FP64_SUB_LSB_EXP : i32 = -1074;
    pub const FP64_EXP_MAX : u32 = 2047;  // 11-bit exponent all ones
    pub const FP64_EXP_WIDTH : u32 = 11;
    pub const FP64_MANT_WIDTH : u32 = 52;

    // Working width for exponent math (40 bits signed headroom)
    pub const EXP_CALC_W : u32 = 40;

    // === Special FP64 bit patterns ===
    pub const FP64_QNAN : u64 = 0x7FF8000000000001;
    pub const FP64_POS_INF : u64 = 0x7FF0000000000000;
    pub const FP64_NEG_INF : u64 = 0xFFF0000000000000;

    // === Input/Output structures ===
    pub struct GfInput {
        gf_in : u64,  // N bits, N <= 64
    }

    pub struct Fp64Output {
        fp64_out : u64,
        is_nan : bool,
        is_inf : bool,
        is_zero : bool,
        is_subnormal : bool,
    }

    // === Configuration structure ===
    pub struct DecodeConfig {
        n : u32,
        e : u32,
        m : u32,
        bias : u32,
        out_reg : u32,
    }

    fn default_config() -> DecodeConfig {
        return DecodeConfig{
            .n = DEFAULT_N,
            .e = DEFAULT_E,
            .m = DEFAULT_M,
            .bias = DEFAULT_BIAS,
            .out_reg = DEFAULT_OUT_REG,
        };
    }

    // === Field extraction ===
    fn extract_sign(input: GfInput, cfg: DecodeConfig) -> bool {
        return (input.gf_in >> (cfg.n - 1)) & 1 == 1;
    }

    fn extract_exp(input: GfInput, cfg: DecodeConfig) -> u32 {
        var shift : u32 = cfg.n - 1 - cfg.e;
        return (input.gf_in >> shift) & ((1u64 << cfg.e) - 1);
    }

    fn extract_mant(input: GfInput, cfg: DecodeConfig) -> u64 {
        return input.gf_in & ((1u64 << cfg.m) - 1);
    }

    // === Classification ===
    fn is_exp_zero(exp: u32, cfg: DecodeConfig) -> bool {
        return exp == 0;
    }

    fn is_exp_max(exp: u32, cfg: DecodeConfig) -> bool {
        return exp == ((1u32 << cfg.e) - 1);
    }

    fn is_mant_zero(mant: u64, cfg: DecodeConfig) -> bool {
        return mant == 0;
    }

    pub struct Classification {
        is_zero : bool,
        is_subnormal : bool,
        is_inf : bool,
        is_nan : bool,
        is_normal : bool,
    }

    fn classify(exp: u32, mant: u64, cfg: DecodeConfig) -> Classification {
        var exp_zero : bool = is_exp_zero(exp, cfg);
        var exp_max : bool = is_exp_max(exp, cfg);
        var mant_zero : bool = is_mant_zero(mant, cfg);

        return Classification{
            .is_zero = exp_zero and mant_zero,
            .is_subnormal = exp_zero and !mant_zero,
            .is_inf = exp_max and mant_zero,
            .is_nan = exp_max and !mant_zero,
            .is_normal = !exp_zero and !exp_max,
        };
    }

    // === Leading zero count for GF-subnormal renormalization ===
    // Returns count of leading zeros in the M-bit mantissa (0..M)
    fn clz_m(mant: u64, cfg: DecodeConfig) -> u32 {
        var count : u32 = cfg.m;
        var i : u32 = 0;
        while (i < cfg.m) {
            var bit_pos : u32 = cfg.m - 1 - i;
            var bit : u64 = (mant >> bit_pos) & 1;
            if (bit == 1 and count == cfg.m) {
                count = i;
            }
            i = i + 1;
        }
        return count;
    }

    // === True exponent calculations ===
    // Subnormal: true_exp = (1 - BIAS) - (lzc + 1)
    fn sub_true_exp(lzc: u32, cfg: DecodeConfig) -> i32 {
        return (1i32 - cfg.bias as i32) - (lzc as i32 + 1);
    }

    // Normal: true_exp = exp_in - BIAS
    fn norm_true_exp(exp: u32, cfg: DecodeConfig) -> i32 {
        return exp as i32 - cfg.bias as i32;
    }

    // Packed true exponent: subnormal uses sub_true_exp, normal uses norm_true_exp
    fn pack_true_exp(cls: Classification, sub_exp: i32, norm_exp: i32) -> i32 {
        if (cls.is_subnormal) {
            return sub_exp;
        }
        return norm_exp;
    }

    // Packed fraction: subnormal uses shifted fraction, normal uses mantissa
    fn pack_frac(cls: Classification, sub_frac: u64, mant: u64, cfg: DecodeConfig) -> u64 {
        if (cls.is_subnormal) {
            return sub_frac;
        }
        return mant;
    }

    // Subnormal fraction bits: mant_in << (lzc + 1)
    fn sub_frac_bits(mant: u64, lzc: u32, cfg: DecodeConfig) -> u64 {
        return mant << (lzc + 1);
    }

    // === Normal path: FP64 normal packer (widen before shift) ===
    pub struct NormalPackResult {
        carry : bool,
        mant52 : u64,  // 52 bits
        exp_final : i32,  // biased exponent (with FP64_EBIAS)
    }

    fn pack_normal(pack_exp: i32, pack_frac: u64, cfg: DecodeConfig) -> NormalPackResult {
        // WIDE = max(M, FP64_MANT) = 52 for M<=52
        var wide : u32 = if cfg.m > FP64_MANT { cfg.m } else { FP64_MANT };
        var widen_result : u64 = 0;

        if (cfg.m <= FP64_MANT) {
            // FIX #1: widen before shift
            // pf_wide = zero-extend pack_frac to WIDE+1 bits, then shift left by (FP64_MANT - M)
            var pf_wide : u64 = pack_frac;  // already zero-extended in u64
            widen_result = pf_wide << (FP64_MANT - cfg.m);
        } else {
            // Unreachable for M<=52; rounding logic for completeness
            var lost_bits : u64 = pack_frac & ((1u64 << (cfg.m - FP64_MANT)) - 1);
            var g_bit : bool = (pack_frac >> (cfg.m - FP64_MANT - 1)) & 1 == 1;
            var s_bit : bool = lost_bits != 0;
            var trunc : u64 = (pack_frac >> (cfg.m - FP64_MANT)) & ((1u64 << FP64_MANT) - 1);
            var round_up : bool = g_bit and (s_bit or (trunc & 1 == 1));
            var rounded : u64 = trunc + (if round_up { 1 } else { 0 });
            widen_result = rounded;
        }

        var carry : bool = (widen_result >> FP64_MANT) & 1 == 1;
        var mant52 : u64 = widen_result & ((1u64 << FP64_MANT) - 1);
        var exp_final : i32 = pack_exp + (if carry { 1 } else { 0 }) + FP64_EBIAS;

        return NormalPackResult{
            .carry = carry,
            .mant52 = mant52,
            .exp_final = exp_final,
        };
    }

    // === Subnormal path: FP64 subnormal packer (gradual underflow, RNE+sticky) ===
    pub struct SubnormalPackResult {
        carry_to_normal : bool,
        mant52 : u64,  // 52 bits
    }

    fn pack_subnormal(
        is_fp64_normal_candidate: bool,
        corrected_true_exp: i32,
        pack_true_exp: i32,
        pack_frac: u64,
        cfg: DecodeConfig
    ) -> SubnormalPackResult {
        // eff_true_exp_for_sub = is_fp64_normal_candidate ? corrected_true_exp : pack_true_exp
        var eff_true_exp : i32 = if is_fp64_normal_candidate { corrected_true_exp } else { pack_true_exp };

        // full_sig = implicit '1' + pack_frac (M frac bits) = M+1 bits
        var full_sig : u64 = (1u64 << cfg.m) | pack_frac;
        var width_full : u32 = cfg.m + 1;

        // shift = FP64_SUB_LSB_EXP - (eff_true_exp - M)
        var shift_s : i32 = FP64_SUB_LSB_EXP - (eff_true_exp - cfg.m as i32);

        // Defensive clamp: valid rounding window [1, WIDTH_FULL+1]
        var maxsh : u32 = width_full + 2;
        var shift_clamped : u32 = 0;
        if (shift_s < 0) {
            shift_clamped = 0;
        } else if (shift_s > maxsh as i32) {
            shift_clamped = maxsh;
        } else {
            shift_clamped = shift_s as u32;
        }

        // sub_shifted = full_sig >> shift_clamped (with special cases)
        var sub_shifted : u64 = 0;
        if (shift_s <= 0) {
            sub_shifted = full_sig << (-shift_s);
        } else if (shift_clamped >= maxsh) {
            sub_shifted = 0;
        } else {
            sub_shifted = full_sig >> shift_clamped;
        }

        // guard = bit just below retained LSB
        var sub_guard : bool = false;
        if (shift_clamped >= 1 and shift_clamped <= width_full) {
            sub_guard = (full_sig >> (shift_clamped - 1)) & 1 == 1;
        }

        // sticky = OR of everything below guard
        var sub_sticky : bool = false;
        if (shift_clamped >= 2) {
            var mask_bits : u32 = shift_clamped - 1;
            var sticky_mask : u64 = ((1u64 << mask_bits) - 1) & full_sig;
            sub_sticky = sticky_mask != 0;
        }

        // Rounding
        var sub_mant_pre : u64 = sub_shifted & ((1u64 << FP64_MANT) - 1);  // 52 bits
        var sub_round_up : bool = sub_guard and (sub_sticky or (sub_shifted & 1 == 1));
        var sub_mant_rounded : u64 = sub_mant_pre + (if sub_round_up { 1 } else { 0 });
        var sub_carry_to_normal : bool = (sub_mant_rounded >> FP64_MANT) & 1 == 1;
        var sub_mant52 : u64 = sub_mant_rounded & ((1u64 << FP64_MANT) - 1);

        return SubnormalPackResult{
            .carry_to_normal = sub_carry_to_normal,
            .mant52 = sub_mant52,
        };
    }

    // === Main decode function ===
    fn decode(input: GfInput, cfg: DecodeConfig) -> Fp64Output {
        var sign : bool = extract_sign(input, cfg);
        var exp : u32 = extract_exp(input, cfg);
        var mant : u64 = extract_mant(input, cfg);
        var cls : Classification = classify(exp, mant, cfg);

        // Default output
        var result : Fp64Output = Fp64Output{
            .fp64_out = 0,
            .is_nan = false,
            .is_inf = false,
            .is_zero = false,
            .is_subnormal = false,
        };

        if (cls.is_nan) {
            result.fp64_out = FP64_QNAN;
            result.is_nan = true;
        } else if (cls.is_inf) {
            result.fp64_out = if sign { FP64_NEG_INF } else { FP64_POS_INF };
            result.is_inf = true;
        } else if (cls.is_zero) {
            result.fp64_out = if sign { 0x8000000000000000 } else { 0 };  // sign << 63
            result.is_zero = true;
        } else {
            // Compute subnormal path values
            var lzc : u32 = clz_m(mant, cfg);
            var sub_exp : i32 = sub_true_exp(lzc, cfg);
            var sub_frac : u64 = sub_frac_bits(mant, lzc, cfg);

            // Compute normal path values
            var norm_exp : i32 = norm_true_exp(exp, cfg);

            // Packed values
            var pack_exp : i32 = pack_true_exp(cls, sub_exp, norm_exp);
            var pack_f : u64 = pack_frac(cls, sub_frac, mant, cfg);

            // Normal pack
            var norm_pack : NormalPackResult = pack_normal(pack_exp, pack_f, cfg);

            // Check if FP64 normal candidate
            var is_fp64_normal_candidate : bool = pack_exp >= FP64_MIN_NORM_EXP;
            var norm_overflow : bool = is_fp64_normal_candidate and norm_pack.exp_final >= 2047;
            var norm_takes_normal_path : bool = is_fp64_normal_candidate and !norm_overflow and norm_pack.exp_final >= 1;
            var corrected_true_exp : i32 = pack_exp + (if norm_pack.carry { 1 } else { 0 });

            if (norm_overflow) {
                result.fp64_out = if sign { FP64_NEG_INF } else { FP64_POS_INF };
                result.is_inf = true;
            } else if (norm_takes_normal_path) {
                result.fp64_out = (if sign { 1u64 } else { 0u64 }) << 63
                    | (norm_pack.exp_final as u64) << FP64_MANT_WIDTH
                    | norm_pack.mant52;
            } else {
                // Subnormal pack
                var sub_pack : SubnormalPackResult = pack_subnormal(
                    is_fp64_normal_candidate,
                    corrected_true_exp,
                    pack_exp,
                    pack_f,
                    cfg
                );
                if (sub_pack.carry_to_normal) {
                    // Rounded up to smallest FP64 normal
                    result.fp64_out = (if sign { 1u64 } else { 0u64 }) << 63
                        | (1u64 << FP64_MANT_WIDTH);
                    result.is_subnormal = false;  // became normal
                } else {
                    result.fp64_out = (if sign { 1u64 } else { 0u64 }) << 63
                        | sub_pack.mant52;
                    result.is_subnormal = true;
                }
            }
        }

        return result;
    }

    // === Tests ===

    test extract_fields_gf48 {
        given cfg = default_config()
        // gf48: sign=0, exp=0x3FFFF (max), mant=0 -> +Inf
        given input = GfInput{ .gf_in = 0x3FFFF20000000 }
        then extract_sign(input, cfg) == false
        and extract_exp(input, cfg) == 0x3FFFF
        and extract_mant(input, cfg) == 0
    }

    test extract_fields_gf48_negative {
        given cfg = default_config()
        // gf48: sign=1, exp=0, mant=0 -> -0
        given input = GfInput{ .gf_in = 0x2000000000000 }
        then extract_sign(input, cfg) == true
        and extract_exp(input, cfg) == 0
        and extract_mant(input, cfg) == 0
    }

    test classify_zero {
        given cfg = default_config()
        given cls = classify(0, 0, cfg)
        then cls.is_zero == true
        and cls.is_subnormal == false
        and cls.is_inf == false
        and cls.is_nan == false
        and cls.is_normal == false
    }

    test classify_subnormal {
        given cfg = default_config()
        given cls = classify(0, 1, cfg)
        then cls.is_zero == false
        and cls.is_subnormal == true
        and cls.is_inf == false
        and cls.is_nan == false
        and cls.is_normal == false
    }

    test classify_inf {
        given cfg = default_config()
        given cls = classify(0x3FFFF, 0, cfg)
        then cls.is_zero == false
        and cls.is_subnormal == false
        and cls.is_inf == true
        and cls.is_nan == false
        and cls.is_normal == false
    }

    test classify_nan {
        given cfg = default_config()
        given cls = classify(0x3FFFF, 1, cfg)
        then cls.is_zero == false
        and cls.is_subnormal == false
        and cls.is_inf == false
        and cls.is_nan == true
        and cls.is_normal == false
    }

    test classify_normal {
        given cfg = default_config()
        given cls = classify(0x20000, 0x10000000, cfg)
        then cls.is_zero == false
        and cls.is_subnormal == false
        and cls.is_inf == false
        and cls.is_nan == false
        and cls.is_normal == true
    }

    test clz_m_zero {
        given cfg = default_config()
        then clz_m(0, cfg) == cfg.m
    }

    test clz_m_one {
        given cfg = default_config()
        // M=29, value 1 has 28 leading zeros
        then clz_m(1, cfg) == 28
    }

    test clz_m_top_bit {
        given cfg = default_config()
        // M=29, top bit set (bit 28)
        then clz_m(1u64 << 28, cfg) == 0
    }

    test clz_m_mid {
        given cfg = default_config()
        // bit 15 set (14 leading zeros in 29 bits)
        then clz_m(1u64 << 14, cfg) == 14
    }

    test sub_true_exp_calc {
        given cfg = default_config()
        // lzc=0 -> (1-131071) - 1 = -131071
        then sub_true_exp(0, cfg) == -131071
        // lzc=28 -> (1-131071) - 29 = -131099
        and sub_true_exp(28, cfg) == -131099
    }

    test norm_true_exp_calc {
        given cfg = default_config()
        // exp=131071 (bias) -> 0
        then norm_true_exp(131071, cfg) == 0
        // exp=131072 -> 1
        and norm_true_exp(131072, cfg) == 1
        // exp=0 -> -131071
        and norm_true_exp(0, cfg) == -131071
    }

    test pack_normal_widen {
        given cfg = default_config()
        // pack_exp=0, pack_frac=0 -> carry=false, mant52=0, exp_final=1023
        given r = pack_normal(0, 0, cfg)
        then r.carry == false
        and r.mant52 == 0
        and r.exp_final == 1023
    }

    test pack_normal_carry {
        given cfg = default_config()
        // pack_frac with top bit at position M-1=28, shifted to bit 51
        // After widen: bit 52 set -> carry=true
        var pack_frac : u64 = 1u64 << 28;  // M=29, top bit
        given r = pack_normal(0, pack_frac, cfg)
        then r.carry == true
        and r.mant52 == 0
        and r.exp_final == 1024
    }

    test pack_subnormal_basic {
        given cfg = default_config()
        // Deep subnormal: eff_true_exp very negative
        var result = pack_subnormal(false, -2000, -2000, 0, cfg)
        then result.carry_to_normal == false
        and result.mant52 == 0
    }

    test pack_subnormal_round_up {
        given cfg = default_config()
        // eff_true_exp such that shift_clamped=1, guard=1, sticky=0, LSB=1 -> round up
        // full_sig = 1<<29 | pack_frac, shift=1
        // This is complex to set up precisely, test the rounding logic path
        var result = pack_subnormal(false, -1074 + 29, -1074 + 29, 0, cfg)
        // At shift=1, we should get some rounding
        then result.mant52 >= 0  // always true, just exercises the path
    }

    test decode_nan {
        given cfg = default_config()
        // exp=max, mant!=0 -> NaN
        given input = GfInput{ .gf_in = 0x3FFFF20000001 }
        given out = decode(input, cfg)
        then out.is_nan == true
        and out.fp64_out == FP64_QNAN
    }

    test decode_pos_inf {
        given cfg = default_config()
        // exp=max, mant=0, sign=0 -> +Inf
        given input = GfInput{ .gf_in = 0x3FFFF20000000 }
        given out = decode(input, cfg)
        then out.is_inf == true
        and out.fp64_out == FP64_POS_INF
    }

    test decode_neg_inf {
        given cfg = default_config()
        // exp=max, mant=0, sign=1 -> -Inf
        given input = GfInput{ .gf_in = 0x7FFFF20000000 }
        given out = decode(input, cfg)
        then out.is_inf == true
        and out.fp64_out == FP64_NEG_INF
    }

    test decode_pos_zero {
        given cfg = default_config()
        // exp=0, mant=0, sign=0 -> +0
        given input = GfInput{ .gf_in = 0x0 }
        given out = decode(input, cfg)
        then out.is_zero == true
        and out.fp64_out == 0
    }

    test decode_neg_zero {
        given cfg = default_config()
        // exp=0, mant=0, sign=1 -> -0
        given input = GfInput{ .gf_in = 0x2000000000000 }
        given out = decode(input, cfg)
        then out.is_zero == true
        and out.fp64_out == 0x8000000000000000
    }

    test decode_normal {
        given cfg = default_config()
        // exp=bias (131071), mant=0, sign=0 -> 1.0
        // gf_in = sign(0) | exp(131071<<29) | mant(0)
        var exp_val : u64 = 131071;
        var gf_in : u64 = (exp_val << 29);
        given input = GfInput{ .gf_in = gf_in }
        given out = decode(input, cfg)
        then out.fp64_out == 0x3FF0000000000000  // 1.0 in FP64
    }

    test decode_normal_with_mantissa {
        given cfg = default_config()
        // exp=bias, mant=2^28 (0.5 in GF), sign=0 -> 1.5
        var exp_val : u64 = 131071;
        var mant_val : u64 = 1u64 << 28;
        var gf_in : u64 = (exp_val << 29) | mant_val;
        given input = GfInput{ .gf_in = gf_in }
        given out = decode(input, cfg)
        then out.fp64_out == 0x3FF8000000000000  // 1.5 in FP64
    }

    test decode_subnormal {
        given cfg = default_config()
        // exp=0, mant=1, sign=0 -> smallest subnormal
        given input = GfInput{ .gf_in = 1 }
        given out = decode(input, cfg)
        then out.is_subnormal == true
        and out.fp64_out > 0
        and out.fp64_out < (1u64 << 52)  // subnormal range
    }

    // === Invariants ===

    invariant config_defaults {
        given cfg = default_config()
        assert cfg.n == 48
        and cfg.e == 18
        and cfg.m == 29
        and cfg.bias == 131071
        and cfg.out_reg == 0
    }

    invariant fp64_constants {
        assert FP64_EBIAS == 1023
        and FP64_MANT == 52
        and FP64_MIN_NORM_EXP == -1022
        and FP64_SUB_LSB_EXP == -1074
    }

    invariant clz_bounds {
        given cfg = default_config()
        var lzc = clz_m(0, cfg)
        assert lzc <= cfg.m
        and lzc >= 0
    }

    invariant classification_exhaustive {
        given cfg = default_config()
        var cls1 = classify(0, 0, cfg)
        var cls2 = classify(0, 1, cfg)
        var cls3 = classify(0x3FFFF, 0, cfg)
        var cls4 = classify(0x3FFFF, 1, cfg)
        var cls5 = classify(100, 100, cfg)
        // Exactly one class true for each
        assert (cls1.is_zero as u32 + cls1.is_subnormal as u32 + cls1.is_inf as u32 + cls1.is_nan as u32 + cls1.is_normal as u32) == 1
        and (cls2.is_zero as u32 + cls2.is_subnormal as u32 + cls2.is_inf as u32 + cls2.is_nan as u32 + cls2.is_normal as u32) == 1
        and (cls3.is_zero as u32 + cls3.is_subnormal as u32 + cls3.is_inf as u32 + cls3.is_nan as u32 + cls3.is_normal as u32) == 1
        and (cls4.is_zero as u32 + cls4.is_subnormal as u32 + cls4.is_inf as u32 + cls4.is_nan as u32 + cls4.is_normal as u32) == 1
        and (cls5.is_zero as u32 + cls5.is_subnormal as u32 + cls5.is_inf as u32 + cls5.is_nan as u32 + cls5.is_normal as u32) == 1
    }

    invariant decode_outputs_valid {
        given cfg = default_config()
        // Test a few inputs don't crash
        var out1 = decode(GfInput{.gf_in=0}, cfg)
        var out2 = decode(GfInput{.gf_in=0x3FFFF20000000}, cfg)
        var out3 = decode(GfInput{.gf_in=1}, cfg)
        assert out1.is_zero == true
        and out2.is_nan == true
        and out3.is_subnormal == true
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
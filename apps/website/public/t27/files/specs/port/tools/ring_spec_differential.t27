// Test block for signatures
test "signatures_basic" {
    let text = "pub fn foo(a: u32) -> u32 { 0 }\npub fn bar(b: bool) -> bool { false }";
    let sigs = signatures(text);
    assert!(sigs.len() == 2, "Expected 2 signatures");
    assert!(sigs[0].name == "foo", "First function name should be foo");
    assert!(sigs[0].params == "a: u32", "First function params should be a: u32");
    assert!(sigs[0].ret == "u32", "First function ret should be u32");
    assert!(sigs[1].name == "bar", "Second function name should be bar");
    assert!(sigs[1].params == "b: bool", "Second function params should be b: bool");
    assert!(sigs[1].ret == "bool", "Second function ret should be bool");
}

// Test block for producers
test "producers_basic" {
    let text = "pub fn make_u32() -> u32 { 0 }\npub fn use_u32(x: u32) -> u32 { x }\npub fn make_bool() -> bool { false }\npub fn use_bool(b: bool) -> bool { b }\npub fn use_struct(s: MyStruct) -> u32 { 0 }\npub fn make_my_struct() -> MyStruct { MyStruct { field: 0 } }";
    let sigs = signatures(text);
    let prods = producers(sigs);
    // We expect producers for u32 and bool and MyStruct? Actually, MyStruct is a struct and we have a producer for it.
    // But note: the producers function only returns types that are not in GRID, INT_TYPES, bool and have all parameters in GRID.
    // For u32: it is in INT_TYPES, so skipped.
    // For bool: skipped.
    // For MyStruct: not in GRID, INT_TYPES, bool, and its producer make_my_struct has no parameters (all in GRID trivially) -> so we expect a producer for MyStruct.
    // Also, note that the producer for MyStruct is make_my_struct.
    // We also expect a producer for u32? No, because u32 is in INT_TYPES.
    // Let's check the actual logic: the producers function skips if ret is in GRID or INT_TYPES or bool.
    // So u32 and bool are skipped.
    // We also skip if any parameter is not in GRID.
    // For use_u32: parameter x: u32 -> u32 is in INT_TYPES, so not in GRID -> so we skip u32 as a producer type? Actually, we are looking at the return type of the function.
    // The function use_u32 has return type u32 -> skipped.
    // The function make_u32 has return type u32 -> skipped.
    // The function use_bool has return type bool -> skipped.
    // The function make_bool has return type bool -> skipped.
    // The function use_struct has return type u32 -> skipped.
    // The function make_my_struct has return type MyStruct -> not skipped, and its parameters are empty -> all in GRID (vacuously) -> so we add a producer for MyStruct.
    // So we expect one producer: for MyStruct with producer make_my_struct.
    assert!(prods.len() == 1, "Expected 1 producer");
    assert!(prods[0].ty == "MyStruct", "Producer type should be MyStruct");
    assert!(prods[0].producer.fn_name == "make_my_struct", "Producer function name should be make_my_struct");
    assert!(prods[0].producer.params == "", "Producer params should be empty");
}

// Test block for comparable
test "comparable_basic" {
    let structs = ["MyStruct", "OtherStruct"];
    assert!(comparable("u8", structs) == true, "u8 should be comparable");
    assert!(comparable("u32", structs) == true, "u32 should be comparable (in INT_TYPES)");
    assert!(comparable("bool", structs) == true, "bool should be comparable");
    assert!(comparable("f32", structs) == true, "f32 should be comparable");
    assert!(comparable("f64", structs) == true, "f64 should be comparable");
    assert!(comparable("MyStruct", structs) == true, "MyStruct should be comparable (in structs)");
    assert!(comparable("OtherStruct", structs) == true, "OtherStruct should be comparable (in structs)");
    assert!(comparable("Unknown", structs) == false, "Unknown should not be comparable");
}

// Test block for emit
test "emit_basic" {
    let ring_lib = "hand.rs";
    let spec_rs = "spec.rs";
    let text = "pub fn foo(a: u32) -> u32 { 0 }\npub fn bar(b: bool) -> bool { false }";
    let sigs = signatures(text);
    let prods = producers(sigs);
    let result = emit(ring_lib, spec_rs, sigs, prods);
    // We expect covered to contain both functions because their parameters and return types are in GRID/INT_TYPES/bool.
    assert!(result.covered.len() == 2, "Expected 2 covered functions");
    assert!(result.refused.len() == 0, "Expected 0 refused functions");
    // Check that the source contains the expected modules
    assert!(result.src.contains("mod hand"), "Source should contain mod hand");
    assert!(result.src.contains("mod spec"), "Source should contain mod spec");
    assert!(result.src.contains("fn main()"), "Source should contain fn main");
}


; specs/port/tools/ternary_model.t27 -- port of tools/ternary_model.py
; This file contains the ternary primitive functions ported from Python to T27.

; Function: _i16
; Emulates signed 16-bit integer wrapping.
pub fn _i16(v: i32) -> i32 {
    let masked = (v + 0x8000) & 0xFFFF;
    return masked - 0x8000;
}

; Function: _i8
; Emulates signed 8-bit integer wrapping.
pub fn _i8(v: i32) -> i32 {
    let masked = (v + 0x80) & 0xFF;
    return masked - 0x80;
}

; Function: tmul
; Ternary multiplication: if ta == 1 -> 0; if tb == 1 -> 0; if ta == tb -> 1; else -1.
pub fn tmul(ta: i32, tb: i32) -> i32 {
    if ta == 1 {
        return 0;
    }
    if tb == 1 {
        return 0;
    }
    if ta == tb {
        return 1;
    }
    return -1;
}

; Function: dot27
; Sum of tmul over 27 trit lanes, accumulated in i16.
pub fn dot27(a: i32, b: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < 27 {
        let shift = i * 2;
        let ta = (a >> shift) & 3;
        let tb = (b >> shift) & 3;
        acc = _i16(acc + tmul(ta, tb));
        i = i + 1;
    }
    return acc;
}

; Function: sign0
; Returns 2 if v > 0, 0 if v < 0, else 1.
pub fn sign0(v: i32) -> i32 {
    if v > 0 {
        return 2;
    } else if v < 0 {
        return 0;
    } else {
        return 1;
    }
}

; Function: negate
; Ternary negation: 2 -> 0; 0 -> 2; else 1.
pub fn negate(t: i32) -> i32 {
    if t == 2 {
        return 0;
    } else if t == 0 {
        return 2;
    } else {
        return 1;
    }
}

; Constant _Z used in pack2 and pack3.
const _Z: u64 = 6004799503160661;

; Function: pack2
; Packs two trits into a 64-bit integer (without masking inputs to two bits).
pub fn pack2(t0: u64, t1: u64) -> u64 {
    let cleared = _Z & 0xFFFFFFFFFFFFFFFC; // 18446744073709551600
    return (cleared | (t0 & 0xFFFFFFFFFFFFFFFF) | ((t1 & 0xFFFFFFFFFFFFFFFF) << 2)) & 0xFFFFFFFFFFFFFFFF;
}

; Function: pack3
; Packs three trits into a 64-bit integer.
pub fn pack3(t0: u64, t1: u64, t2: u64) -> u64 {
    let cleared = _Z & 0xFFFFFFFFFFFFFFF0; // 18446744073709551552
    return (cleared | t0 | (t1 << 2) | (t2 << 4)) & 0xFFFFFFFFFFFFFFFF;
}

; Tests for each function

test _i16_test {
    assert _i16(0) == 0;
    assert _i16(32767) == 32767;
    assert _i16(32768) == -32768;
    assert _i16(65535) == -1;
    assert _i16(-1) == -1;
    assert _i16(-32768) == -32768;
    assert _i16(-32769) == 32767;
}

test _i8_test {
    assert _i8(0) == 0;
    assert _i8(127) == 127;
    assert _i8(128) == -128;
    assert _i8(255) == -1;
    assert _i8(-1) == -1;
    assert _i8(-128) == -128;
    assert _i8(-129) == 127;
}

test tmul_test {
    assert tmul(1, 0) == 0;
    assert tmul(0, 1) == 0;
    assert tmul(1, 1) == 0;
    assert tmul(1, 2) == 0;
    assert tmul(2, 1) == 0;
    assert tmul(2, 2) == 1;
    assert tmul(2, 0) == -1;
    assert tmul(0, 2) == -1;
    assert tmul(0, 0) == 1; // because ta == tb (both 0) -> 1
}

test dot27_test {
    // Simple test: all zeros -> 0
    assert dot27(0, 0) == 0;
    // All ones: each tmul(1,1)=1, 27*1=27 -> but accumulated in i16, so 27
    // However, note: each trit lane: a and b have bits set to 0b01 for each trit? 
    // We need to construct a number where each pair of bits is 0b01 (which is 1).
    // Let's compute: for 27 trits, each set to 1, the integer is sum_{i=0}^{26} (1 << (2*i))
    // This is (4^27 - 1) / (4 - 1) = (2^54 - 1) / 3.
    // We'll compute that value and then dot27 of that with itself should be 27.
    // But note: the accumulation is done in i16, so if 27 is within -32768..32767, it's fine.
    // We'll do a smaller test: 2 trits.
    // Let a = 0b0101 (which is 5) representing two trits: [1,1] (LSB first? Actually, the loop extracts from LSB: i=0 -> bits 0-1, i=1 -> bits 2-3)
    // So a = 5 (binary 0101) -> trits: [1,1]
    // Similarly b = 5.
    // tmul(1,1)=1 for each lane, so total = 2.
    // We'll test with 2 trits by changing the loop to 2? We cannot change the function.
    // Instead, we test the function as is with 27 trits, but we can test with a value that has only the first two trits set and the rest zero.
    // Let a = 5 (binary ...00000101) -> trits: [1,1,0,0,...]
    // Let b = 5.
    // Then for i=0: ta=1, tb=1 -> tmul=1 -> acc=1
    // i=1: ta=1, tb=1 -> tmul=1 -> acc=2
    // i=2..26: ta=0, tb=0 -> tmul(0,0)=1 -> each adds 1 -> total 2 + 25*1 = 27.
    // So dot27(5,5) should be 27.
    assert dot27(5,5) == 27;
    // Test with mixed values: we can test one lane.
    // Let a = 1 (binary 01) -> trit0=1, rest 0.
    // Let b = 2 (binary 10) -> trit0=2, rest 0.
    // tmul(1,2) = 0 (because ta==1) -> so dot27 should be 0.
    assert dot27(1,2) == 0;
}

test sign0_test {
    assert sign0(-5) == 0;
    assert sign0(0) == 1;
    assert sign0(5) == 2;
}

test negate_test {
    assert negate(0) == 2;
    assert negate(1) == 1;
    assert negate(2) == 0;
    // Test any other value (should return 1)
    assert negate(3) == 1;
    assert negate(-1) == 1;
}

test pack2_test {
    // We'll test with small values that don't overflow the mask.
    // Let t0=1, t1=2.
    // cleared = _Z & 0xFFFFFFFFFFFFFFFC
    // We know _Z = 6004799503160661
    // Let's compute expected by using the original Python function in our mind? 
    // Instead, we can trust the function if we test against the original Python? 
    // But we don't have Python here? We can run the original Python from the tools directory.
    // However, for the purpose of this test, we can test a few properties.
    // Note: the function does not mask t0 and t1 to two bits, so we can test with larger values.
    // We'll test that packing then unpacking (if we had unpack) would give the original? 
    // Since we don't have unpack, we test consistency with the original Python by using the known constant.
    // We'll compute the expected value for t0=1, t1=2 using the original Python and then assert.
    // But we cannot run Python in the test? We can compute the expected value by hand? 
    // Alternatively, we can test that the function returns the same as the original Python by having a separate test that uses the original Python? 
    // That is beyond the scope of the unit test in .t27.
    // We'll do a simple test: pack2(0,0) should be cleared.
    let cleared = _Z & 0xFFFFFFFFFFFFFFFC;
    assert pack2(0,0) == cleared;
    // pack2(1,0) should be cleared | 1
    assert pack2(1,0) == cleared | 1;
    // pack2(0,1) should be cleared | (1 << 2)
    assert pack2(0,1) == cleared | (1 << 2);
    // pack2(1,1) should be cleared | 1 | (1 << 2)
    assert pack2(1,1) == cleared | 1 | (1 << 2);
}

test pack3_test {
    let cleared = _Z & 0xFFFFFFFFFFFFFFF0;
    assert pack3(0,0,0) == cleared;
    assert pack3(1,0,0) == cleared | 1;
    assert pack3(0,1,0) == cleared | (1 << 2);
    assert pack3(0,0,1) == cleared | (1 << 4);
    assert pack3(1,1,1) == cleared | 1 | (1 << 2) | (1 << 4);
}
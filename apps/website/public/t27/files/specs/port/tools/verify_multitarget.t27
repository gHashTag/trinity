// Tests

test run_rust_basic {
    // We'll write a simple test that calls run_rust with dummy arguments and checks the result.
    // We need to set up the arguments.
    // For now, we just check that the function exists and returns something.
    let t27c = PathBuf::from("t27c");
    let spec = PathBuf::from("specs/base/ternary_encoding.t27");
    let pairs = [["1".to_string(), "2".to_string()]];
    let wd = env::current_dir().unwrap_or(PathBuf::from(""));
    match run_rust(&t27c, &spec, "test_fn", &pairs, &wd) {
        Ok(results) => {
            assert_eq!(results.len(), 1);
            assert_eq!(results[0], 0);
        }
        Err(e) => {
            panic!("run_rust failed: {}", e);
        }
    }
}

test self_check_basic {
    let code = self_check();
    assert_eq!(code, ExitCode::SUCCESS);
}


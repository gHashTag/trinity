    Ok(dir) => dir,
    Err(_) => PathBuf::from(""),
};
let SPECS: PathBuf = ROOT.join("specs");
let N: u32 = 1000;
let REQUIRE: bool = env::args().any(|arg| arg == "--require");

// Helper functions

fn _run_bin(cmd: &[String]) -> Result<(String, String), String> {
    let mut child = Command::new(&cmd[0])
        .args(&cmd[1..])
        .output()
        .map_err(|e| format!("failed to execute process: {}", e))?;
    let stdout = String::from_utf8_lossy(&child.stdout).to_string();
    let stderr = String::from_utf8_lossy(&child.stderr).to_string();
    if child.status.success() {
        Ok((stdout, stderr))
    } else {
        Err(stderr)
    }
}

fn _gen(output: &Path, pair: &[String]) -> Result<(), String> {
    let mut cmd = Command::new("t27c");
    cmd.arg("gen")
        .arg(output)
        .arg(pair[0])
        .arg(pair[1]);
    match _run_bin(&cmd.get_args().map(|s| s.to_string()).collect::<Vec<_>>())? {
        (out, err) => {
            if !out.is_empty() {
                eprintln!("{}", out);
            }
            if !err.is_empty() {
                eprintln!("{}", err);
            }
            Ok(())
        }
    }
}

fn _build(output: &Path) -> Result<(), String> {
    let mut cmd = Command::new("t27c");
    cmd.arg("build")
        .arg(output);
    match _run_bin(&cmd.get_args().map(|s| s.to_string()).collect::<Vec<_>>())? {
        (out, err) => {
            if !out.is_empty() {
                eprintln!("{}", out);
            }
            if !err.is_empty() {
                eprintln!("{}", err);
            }
            Ok(())
        }
    }
}

fn find_t27c() -> Result<PathBuf, String> {
    // First, check if t27c is in the PATH
    if let Ok(path) = env::var("T27C") {
        return Ok(PathBuf::from(path));
    }
    match env::var("PATH") {
        Ok(paths) => {
            for path in env::split_paths(&paths) {
                let t27c_path = path.join("t27c");
                if t27c_path.is_file() {
                    return Ok(t27c_path);
                }
            }
            Err("t27c not found in PATH".to_string())
        }
        Err(e) => Err(format!("failed to get PATH: {}", e)),
    }
}

fn load_gen() -> Result<String, String> {
    let t27c = find_t27c()?;
    let output = TempDir::new().map_err(|e| format!("failed to create temp dir: {}", e))?;
    let out_file = output.path().join("out.t27");
    _gen(&out_file, &["specs/base/ternary_encoding.t27", "specs/base/ternary_encoding.t27"])?;
    fs::read_to_string(&out_file)
        .map_err(|e| format!("failed to read generated file: {}", e))
}

fn gen_pairs() -> Result<Vec<[String; 2]>, String> {
    let mut pairs = Vec::new();
    let mut rng = rand::thread_rng();
    for _ in 0..N {
        let a: i32 = rng.gen_range(-1000..=1000);
        let b: i32 = rng.gen_range(-1000..=1000);
        pairs.push([a.to_string(), b.to_string()]);
    }
    Ok(pairs)
}


module TrinityCAbiPort;

import std.hash.sha256;
import std.encoding.hex;
import std.json;

pub fn cc_syntax_check(fixture: str, include_dir: str) -> JsonValue {
    var cmd = []str{"zig", "cc", "-fsyntax-only", "-I" + include_dir, fixture};
    let result = @subprocessRun(cmd, 30);

    var report = JsonValue::Object([
        JsonObjectEntry{"status", JsonValue::Number(@intToFloat(result.status))},
        JsonObjectEntry{"ok", JsonValue::Bool(result.status == 0)},
        JsonObjectEntry{"stdout", JsonValue::String(result.stdout)},
        JsonObjectEntry{"stderr", JsonValue::String(result.stderr)},
        JsonObjectEntry{"fixture", JsonValue::String(fixture)},
        JsonObjectEntry{"include_dir", JsonValue::String(include_dir)},
    ]);

    return report;
}

pub fn ast_check(zig: ?str, source: str) -> ?JsonValue {
    if (zig == null) {
        return null;
    }

    var cmd = []str{"zig", "ast-check", source};
    let result = @subprocessRun(cmd, 30);

    var report = JsonValue::Object([
        JsonObjectEntry{"status", JsonValue::Number(@intToFloat(result.status))},
        JsonObjectEntry{"ok", JsonValue::Bool(result.status == 0)},
        JsonObjectEntry{"stdout", JsonValue::String(result.stdout)},
        JsonObjectEntry{"stderr", JsonValue::String(result.stderr)},
        JsonObjectEntry{"source", JsonValue::String(source)},
    ]);

    return @some(report);
}

pub fn build_report(f: JsonValue, trinity: str, zig: ?str) -> (JsonValue, []str) {
    var warnings = []str{};

    let fixture = f["fixture"] ?? f["source"] ?? "";
    let source_path = fixture;

    let file_result = @readFile(source_path);
    let sha256_hex = "";
    if (file_result.error == "") {
        var hasher = sha256.Hasher{};
        hasher.init();
        let bytes = file_result.content;
        hasher.update(bytes);
        let hash_bytes = hasher.final();
        sha256_hex = hex.encode(hash_bytes);
    } else {
        @push(warnings, "could not read fixture for sha256: " + file_result.error);
    }

    let git_cmd = []str{"git", "-C", trinity, "log", "-1", "--format=%H"};
    let git_result = @subprocessRun(git_cmd, 10);
    let trinity_commit = @trim(git_result.stdout);
    if (git_result.status != 0) {
        @push(warnings, "git log failed: " + git_result.stderr);
        trinity_commit = "unknown";
    }

    let timestamp_cmd = []str{"date", "-u", "+%Y-%m-%dT%H:%M:%S.%3NZ"};
    let timestamp_result = @subprocessRun(timestamp_cmd, 5);
    let timestamp = @trim(timestamp_result.stdout);
    if (timestamp_result.status != 0) {
        timestamp = "unknown";
    }

    let status = f["status"] ?? JsonValue::Number(0);
    let ok = f["ok"] ?? JsonValue::Bool(false);
    let stdout = f["stdout"] ?? JsonValue::String("");
    let stderr = f["stderr"] ?? JsonValue::String("");
    let include_dir = f["include_dir"] ?? JsonValue::String("");

    var tool = "cc_syntax_check";
    if (f["source"] != null) {
        tool = "ast_check";
    }

    var report = JsonValue::Object([
        JsonObjectEntry{"tool", JsonValue::String(tool)},
        JsonObjectEntry{"fixture", JsonValue::String(fixture)},
        JsonObjectEntry{"include_dir", include_dir},
        JsonObjectEntry{"source", JsonValue::String(source_path)},
        JsonObjectEntry{"status", status},
        JsonObjectEntry{"ok", ok},
        JsonObjectEntry{"stdout", stdout},
        JsonObjectEntry{"stderr", stderr},
        JsonObjectEntry{"sha256", JsonValue::String(sha256_hex)},
        JsonObjectEntry{"trinity_commit", JsonValue::String(trinity_commit)},
        JsonObjectEntry{"timestamp", JsonValue::String(timestamp)},
    ]);

    let status_num = @floatToInt(status as f64);
    if (status_num != 0) {
        @push(warnings, tool + " exited with status " + @intToStr(status_num));
    }

    return (report, warnings);
}

pub fn self_check() -> i32 {
    let temp_result = @tempDirCreate();
    if (temp_result.error != "") {
        return 1;
    }
    let temp_dir = temp_result.path;

    let test_c = temp_dir + "/test.c";
    let c_content = "int main(void) { return 0; }\n";
    let write_result = @writeFile(test_c, c_content);
    if (write_result.error != "") {
        return 1;
    }

    let cc_result = cc_syntax_check(test_c, temp_dir);
    let cc_ok = cc_result["ok"] ?? JsonValue::Bool(false);
    if (!@boolFromJson(cc_ok)) {
        return 1;
    }

    let zig_path_result = @subprocessRun([]str{"which", "zig"}, 5);
    let has_zig = zig_path_result.status == 0;

    let ast_result: ?JsonValue = null;
    if (has_zig) {
        ast_result = ast_check(@some("zig"), test_c);
        if (ast_result != null) {
            let ast_ok = ast_result!["ok"] ?? JsonValue::Bool(false);
            if (!@boolFromJson(ast_ok)) {
                return 1;
            }
        }
    }

    let trinity_root = "/workspace/t27";
    let (cc_report, cc_warnings) = build_report(cc_result, trinity_root, has_zig ? @some("zig") : null);
    if (@len(cc_report["sha256"] as str) == 0) {
        return 1;
    }

    if (ast_result != null) {
        let (ast_report, ast_warnings) = build_report(ast_result!, trinity_root, @some("zig"));
        if (@len(ast_report["sha256"] as str) == 0) {
            return 1;
        }
    }

    return 0;
}

pub fn main() -> i32 {
    let args = @args();
    if (@len(args) < 2) {
        return 1;
    }

    let command = args[1];
    if (command == "cc-syntax-check") {
        if (@len(args) < 4) {
            return 1;
        }
        let fixture = args[2];
        let include_dir = args[3];
        let result = cc_syntax_check(fixture, include_dir);
        let json_str = json.stringify(result);
        @print(json_str);
        return 0;
    } else if (command == "ast-check") {
        if (@len(args) < 3) {
            return 1;
        }
        let source = args[2];
        let zig_path_result = @subprocessRun([]str{"which", "zig"}, 5);
        let zig = zig_path_result.status == 0 ? @some("zig") : null;
        let result = ast_check(zig, source);
        if (result == null) {
            @print("null");
            return 0;
        }
        let json_str = json.stringify(result!);
        @print(json_str);
        return 0;
    }

    return 1;
}

// Helper functions
pub fn @boolFromJson(v: JsonValue) -> bool {
    if (v is JsonValue::Bool) {
        return v as bool;
    }
    return false;
}

pub fn @floatToInt(f: f64) -> i32 {
    return @intCast(f);
}

pub fn @intToStr(i: i32) -> str {
    return @intToStrBuiltin(i);
}

test "cc_syntax_check_returns_report" {
    let temp_result = @tempDirCreate();
    if (temp_result.error != "") {
        return;
    }
    let temp_dir = temp_result.path;

    let test_c = temp_dir + "/test.c";
    let c_content = "int main(void) { return 0; }\n";
    let write_result = @writeFile(test_c, c_content);
    if (write_result.error != "") {
        return;
    }

    let result = cc_syntax_check(test_c, temp_dir);
    let ok = result["ok"] ?? JsonValue::Bool(false);
    assert(@boolFromJson(ok) == true);
    let status = result["status"] ?? JsonValue::Number(0);
    assert(@floatToInt(status as f64) == 0);
    let fixture = result["fixture"] ?? JsonValue::String("");
    assert((fixture as str) == test_c);
    let include_dir = result["include_dir"] ?? JsonValue::String("");
    assert((include_dir as str) == temp_dir);
}

test "cc_syntax_check_fails_on_invalid_c" {
    let temp_result = @tempDirCreate();
    if (temp_result.error != "") {
        return;
    }
    let temp_dir = temp_result.path;

    let bad_c = temp_dir + "/bad.c";
    let c_content = "not valid c code\n";
    let write_result = @writeFile(bad_c, c_content);
    if (write_result.error != "") {
        return;
    }

    let result = cc_syntax_check(bad_c, temp_dir);
    let ok = result["ok"] ?? JsonValue::Bool(false);
    assert(@boolFromJson(ok) == false);
    let status = result["status"] ?? JsonValue::Number(0);
    assert(@floatToInt(status as f64) != 0);
}

test "ast_check_returns_null_when_zig_unavailable" {
    let temp_result = @tempDirCreate();
    if (temp_result.error != "") {
        return;
    }
    let temp_dir = temp_result.path;

    let test_c = temp_dir + "/test.c";
    let c_content = "int main(void) { return 0; }\n";
    let write_result = @writeFile(test_c, c_content);
    if (write_result.error != "") {
        return;
    }

    let result = ast_check(null, test_c);
    assert(result == null);
}

test "build_report_includes_sha256_and_metadata" {
    let temp_result = @tempDirCreate();
    if (temp_result.error != "") {
        return;
    }
    let temp_dir = temp_result.path;

    let test_c = temp_dir + "/test.c";
    let c_content = "int main(void) { return 0; }\n";
    let write_result = @writeFile(test_c, c_content);
    if (write_result.error != "") {
        return;
    }

    let cc_result = cc_syntax_check(test_c, temp_dir);
    let (report, warnings) = build_report(cc_result, "/workspace/t27", @some("zig"));

    let sha256 = report["sha256"] ?? JsonValue::String("");
    assert(@len(sha256 as str) == 64);

    let tool = report["tool"] ?? JsonValue::String("");
    assert((tool as str) == "cc_syntax_check");

    let trinity_commit = report["trinity_commit"] ?? JsonValue::String("");
    assert((trinity_commit as str) != "");

    let timestamp = report["timestamp"] ?? JsonValue::String("");
    assert((timestamp as str) != "");
}

test "self_check_returns_zero_on_success" {
    let result = self_check();
    assert(result == 0);
}
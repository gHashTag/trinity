    undefined;
}

// Helper functions for string manipulation

fn starts_with(s: []const u8, prefix: []const u8) bool {
    if (prefix.len > s.len) return false;
    for (i, c) in prefix {
        if (s[i] != c) return false;
    }
    return true;
}

fn trim(s: []const u8) []const u8 {
    var start: usize = 0;
    while (start < s.len and (s[start] == ' ' or s[start] == '\t' or s[start] == '\n' or s[start] == '\r')) {
        start += 1;
    }
    var end = s.len;
    while (end > start and (s[end - 1] == ' ' or s[end - 1] == '\t' or s[end - 1] == '\n' or s[end - 1] == '\r')) {
        end -= 1;
    }
    return s[start..end];
}

fn trim_left(s: []const u8) []const u8 {
    var start: usize = 0;
    while (start < s.len and (s[start] == ' ' or s[start] == '\t')) {
        start += 1;
    }
    return s[start..];
}

fn split_lines(s: []const u8) [][]const u8 {
    // Simplified - in reality would return a slice of lines
    // For testing purposes we'll use a fixed array
    undefined;
}

fn parse_u32(s: []const u8) ?u32 {
    var result: u32 = 0;
    for (c) in s {
        if (c < '0' or c > '9') return null;
        result = result * 10 + (c - '0');
    }
    return result;
}

// ============================================================================
// TESTS
// ============================================================================

test parse_coverage_output_basic {
    const output = "Functions: 15\nUntested:  3\n--- untested functions\nfoo\nbar\nbaz\n";
    const result = parse_coverage_output(output) orelse { assert(false); };
    assert(result.functions == 15);
    assert(result.untested == 3);
    assert(result.names.len == 3);
    assert(result.names[0] == "foo");
    assert(result.names[1] == "bar");
    assert(result.names[2] == "baz");
}

test parse_coverage_output_missing_lines {
    const output = "Functions: 10\nSome other line\n";
    const result = parse_coverage_output(output);
    assert(result == null);
}

test parse_coverage_output_zero_untested {
    const output = "Functions: 5\nUntested:  0\n--- untested functions\n";
    const result = parse_coverage_output(output) orelse { assert(false); };
    assert(result.functions == 5);
    assert(result.untested == 0);
    assert(result.names.len == 0);
}

test parse_coverage_output_invalid_names_filtered {
    const output = "Functions: 10\nUntested:  2\n--- untested functions\nvalid_name\n123invalid\nanother-valid\n";
    const result = parse_coverage_output(output) orelse { assert(false); };
    assert(result.untested == 2);
    assert(result.names.len == 2);
    assert(result.names[0] == "valid_name");
    assert(result.names[1] == "another-valid");
}

test signature_of_simple {
    const text = "pub fn foo(i32) -> i32 {";
    const sig = signature_of(text, "foo") orelse { assert(false); };
    assert(sig == "pub fn foo(i32) -> i32");
}

test signature_of_with_generics {
    const text = "fn bar<T>(T) -> T;";
    const sig = signature_of(text, "bar") orelse { assert(false); };
    assert(sig == "fn bar<T>(T) -> T");
}

test signature_of_not_found {
    const text = "fn other() {}";
    const sig = signature_of(text, "foo");
    assert(sig == null);
}

test signature_of_extern {
    const text = "extern fn baz() -> void;";
    const sig = signature_of(text, "baz") orelse { assert(false); };
    assert(sig == "extern fn baz() -> void");
}

test validate_coverage_for_build_valid {
    const cov = CoverageResult { .functions = 10, .untested = 3, .names = &[_][]const u8{"a", "b", "c"} };
    assert(validate_coverage_for_build(cov) == true);
}

test validate_coverage_for_build_untested_zero {
    const cov = CoverageResult { .functions = 10, .untested = 0, .names = &[_][]const u8{} };
    assert(validate_coverage_for_build(cov) == false);
}

test validate_coverage_for_build_untested_too_many {
    const cov = CoverageResult { .functions = 10, .untested = 9, .names = &[_][]const u8{"a", "b", "c", "d", "e", "f", "g", "h", "i"} };
    assert(validate_coverage_for_build(cov) == false);
}

test validate_coverage_for_build_names_mismatch {
    const cov = CoverageResult { .functions = 10, .untested = 3, .names = &[_][]const u8{"a", "b"} };
    assert(validate_coverage_for_build(cov) == false);
}

test validate_signatures_all_found {
    const sigs = &[_]SignatureResult{
        { .name = "a", .signature = "fn a()" },
        { .name = "b", .signature = "fn b()" },
    };
    assert(validate_signatures(sigs) == true);
}

test validate_signatures_one_missing {
    const sigs = &[_]SignatureResult{
        { .name = "a", .signature = "fn a()" },
        { .name = "b", .signature = null },
    };
    assert(validate_signatures(sigs) == false);
}

test validate_shell_counts_valid {
    assert(validate_shell_counts("5", "10") == true);
}

test validate_shell_counts_invalid {
    assert(validate_shell_counts("5", "abc") == false);
    assert(validate_shell_counts("", "10") == false);
    assert(validate_shell_counts("5a", "10") == false);
}

test validate_status_non_empty {
    assert(validate_status("IMPLEMENTED") == true);
    assert(validate_status("PARTIAL") == true);
}

test validate_status_empty {
    assert(validate_status("") == false);
}

test categorize_spec_none {
    assert(categorize_spec(0) == .none);
}

test categorize_spec_small {
    assert(categorize_spec(1) == .small);
    assert(categorize_spec(8) == .small);
}

test categorize_spec_big {
    assert(categorize_spec(9) == .big);
    assert(categorize_spec(100) == .big);
}

test sort_population_entries_by_untested_then_rel {
    var entries: [4]PopulationEntry = .{
        { .rel = "specs/c.t27", .untested = 3 },
        { .rel = "specs/a.t27", .untested = 1 },
        { .rel = "specs/b.t27", .untested = 1 },
        { .rel = "specs/d.t27", .untested = 2 },
    };
    sort_population_entries(&entries);
    assert(entries[0].rel == "specs/a.t27" and entries[0].untested == 1);
    assert(entries[1].rel == "specs/b.t27" and entries[1].untested == 1);
    assert(entries[2].rel == "specs/d.t27" and entries[2].untested == 2);
    assert(entries[3].rel == "specs/c.t27" and entries[3].untested == 3);
}

test is_valid_identifier_valid {
    assert(is_valid_identifier("foo") == true);
    assert(is_valid_identifier("_foo") == true);
    assert(is_valid_identifier("foo123") == true);
    assert(is_valid_identifier("FooBar") == true);
}

test is_valid_identifier_invalid {
    assert(is_valid_identifier("") == false);
    assert(is_valid_identifier("123foo") == false);
    assert(is_valid_identifier("foo-bar") == false);
    assert(is_valid_identifier("foo bar") == false);
}

test find_number_after_functions {
    const out = "Functions: 15\nUntested: 3\n";
    const n = find_number_after(out, "Functions:") orelse { assert(false); };
    assert(n == 15);
}

test find_number_after_untested {
    const out = "Functions: 15\nUntested:  3\n";
    const n = find_number_after(out, "Untested:") orelse { assert(false); };
    assert(n == 3);
}

test find_number_after_missing {
    const out = "Something else\n";
    const n = find_number_after(out, "Functions:");
    assert(n == null);
}

test parse_u32_valid {
    assert(parse_u32("0") == 0);
    assert(parse_u32("42") == 42);
    assert(parse_u32("1000") == 1000);
}

test parse_u32_invalid {
    assert(parse_u32("") == null);
    assert(parse_u32("abc") == null);
    assert(parse_u32("12a") == null);
}

test collapse_whitespace_simple {
    // This test just verifies the function exists and returns something
    const result = collapse_whitespace("hello");
    assert(result.len > 0);
}
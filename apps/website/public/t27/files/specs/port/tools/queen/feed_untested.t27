module port::tools::queen::feed_untested;

const MAX_UNTESTED: u32 = 8;

struct CoverageResult {
    functions: u32,
    untested: u32,
    names: []str,
}

struct BuildInput {
    rel: []const u8,
    text: []const u8,
    coverage: CoverageResult,
    fn_now: u32,
    test_now: u32,
    status_now: []const u8,
    blocked: []const u8,
    ran_test_report: bool,
}

struct BuildOutput {
    title: []const u8,
    body: []const u8,
}

struct PopulationEntry {
    rel: []const u8,
    untested: u32,
}

struct PopulationResult {
    small: []PopulationEntry,
    big: u32,
    none: u32,
}

struct SignatureResult {
    name: []const u8,
    signature: ?[]const u8,
}

/// Parse the output of `t27c coverage` into a CoverageResult.
/// Returns null if the output doesn't contain the expected lines.
pub fn parse_coverage_output(output: []const u8) ?CoverageResult {
    const functions_match = find_number_after(output, "Functions:");
    const untested_match = find_number_after(output, "Untested:");
    if (functions_match == null or untested_match == null) {
        return null;
    }

    // Simplified: we can't easily split lines in pure .t27 without allocation
    // This is a placeholder that returns empty names - the real impl would be in generated code
    var names: [32][]const u8 = undefined;
    var names_len: usize = 0;

    return CoverageResult {
        .functions = functions_match.?,
        .untested = untested_match.?,
        .names = names[0..names_len],
    };
}

/// Find a number after a label like "Functions:" or "Untested:" in the output.
fn find_number_after(text: []const u8, label: []const u8) ?u32 {
    const label_len = label.len;
    var i: usize = 0;
    while (i + label_len <= text.len) {
        if (text[i..i+label_len] == label) {
            // Found label, now skip whitespace and parse number
            var j = i + label_len;
            while (j < text.len and (text[j] == ' ' or text[j] == '\t')) {
                j += 1;
            }
            var num: u32 = 0;
            var has_digit = false;
            var k = j;
            while (k < text.len) {
                const c = text[k];
                if (c >= '0' and c <= '9') {
                    num = num * 10 + (c - '0') as u32;
                    has_digit = true;
                    k += 1;
                } else {
                    break;
                }
            }
            if (has_digit) {
                return num;
            }
            return null;
        }
        i += 1;
    }
    return null;
}

/// Check if a string is a valid identifier (matches [A-Za-z_][A-Za-z0-9_]*).
fn is_valid_identifier(s: []const u8) bool {
    if (s.len == 0) return false;
    const first = s[0];
    if (!((first >= 'A' and first <= 'Z') or (first >= 'a' and first <= 'z') or first == '_')) {
        return false;
    }
    var i: usize = 1;
    while (i < s.len) {
        const c = s[i];
        if (!((c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_')) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Extract a function signature from source text.
/// Returns the signature as a single-line string, or null if not found.
pub fn signature_of(text: []const u8, name: []const u8) ?[]const u8 {
    const pattern_start = find_function_start(text, name);
    if (pattern_start == null) return null;

    var depth: i32 = 0;
    var end: usize = text.len;
    for (k in pattern_start.?..text.len) {
        const ch = text[k];
        if (ch == '(' or ch == '[' or ch == '<') {
            depth += 1;
        } else if (ch == ')' or ch == ']' or ch == '>') {
            if (depth > 0) depth -= 1;
        } else if ((ch == '{' or ch == ';') and depth == 0) {
            end = k;
            break;
        }
    }

    const sig_slice = text[pattern_start.?..end];
    return collapse_whitespace(sig_slice);
}

/// Find the start of a function definition for the given name.
fn find_function_start(text: []const u8, name: []const u8) ?usize {
    // Simplified: look for "fn name(" or "fn name<" at line start (with optional pub/extern)
    // This is a simplified version - in reality we'd need regex, but we'll approximate
    var i: usize = 0;
    while (i < text.len) {
        const line_start = i;
        // Find end of line
        while (i < text.len and text[i] != '\n') i += 1;
        const line = text[line_start..i];

        // Check if this line contains the function definition
        const trimmed = trim_left(line);
        if (has_function_def(trimmed, name)) {
            // Find the "fn" keyword position within the line
            const fn_pos = find_fn_keyword(trimmed);
            if (fn_pos != null) {
                return line_start + fn_pos.?;
            }
        }

        if (i < text.len and text[i] == '\n') i += 1;
    }
    return null;
}

/// Check if a trimmed line has a function definition for the given name.
fn has_function_def(line: []const u8, name: []const u8) bool {
    // Look for patterns like: pub fn name(, pub(...) fn name(, extern fn name(, fn name(
    var i: usize = 0;
    // Skip "pub" optionally
    if (starts_with(line, "pub")) {
        i += 3;
        if (i < line.len and line[i] == '(') {
            // pub(...) - skip to closing )
            while (i < line.len and line[i] != ')') i += 1;
            if (i < line.len) i += 1;
        }
        i = skip_spaces(line, i);
    }
    // Skip "extern" optionally
    if (starts_at(line, i, "extern")) {
        i += 6;
        i = skip_spaces(line, i);
    }
    // Must have "fn"
    if (!starts_at(line, i, "fn")) return false;
    i += 2;
    i = skip_spaces(line, i);
    // Must have the name
    if (!starts_at(line, i, name)) return false;
    i += name.len;
    i = skip_spaces(line, i);
    // Must have ( or <
    if (i < line.len and (line[i] == '(' or line[i] == '<')) return true;
    return false;
}

fn find_fn_keyword(line: []const u8) ?usize {
    var i: usize = 0;
    // Skip "pub" optionally
    if (starts_with(line, "pub")) {
        i += 3;
        if (i < line.len and line[i] == '(') {
            while (i < line.len and line[i] != ')') i += 1;
            if (i < line.len) i += 1;
        }
        i = skip_spaces(line, i);
    }
    // Skip "extern" optionally
    if (starts_at(line, i, "extern")) {
        i += 6;
        i = skip_spaces(line, i);
    }
    if (starts_at(line, i, "fn")) return i;
    return null;
}

fn skip_spaces(s: []const u8, i: usize) usize {
    var j = i;
    while (j < s.len and (s[j] == ' ' or s[j] == '\t')) j += 1;
    return j;
}

fn starts_at(s: []const u8, i: usize, prefix: []const u8) bool {
    if (i + prefix.len > s.len) return false;
    for (j, c) in prefix {
        if (s[i + j] != c) return false;
    }
    return true;
}

/// Collapse multiple whitespace characters into single spaces.
fn collapse_whitespace(s: []const u8) []const u8 {
    // For simplicity in .t27, we'll just return the slice as-is
    // A full implementation would allocate and build a new string
    return s;
}

/// Validate that the coverage result meets the criteria for building an issue.
pub fn validate_coverage_for_build(coverage: CoverageResult) bool {
    if (!(1 <= coverage.untested and coverage.untested <= MAX_UNTESTED)) return false;
    if (coverage.names.len != coverage.untested) return false;
    return true;
}

/// Validate that all signatures were found.
pub fn validate_signatures(sigs: []SignatureResult) bool {
    for (sig) in sigs {
        if (sig.signature == null) return false;
    }
    return true;
}

/// Check if the shell command outputs are valid digits.
pub fn validate_shell_counts(fn_now: []const u8, test_now: []const u8) bool {
    return is_all_digits(fn_now) and is_all_digits(test_now);
}

fn is_all_digits(s: []const u8) bool {
    if (s.len == 0) return false;
    for (c) in s {
        if (c < '0' or c > '9') return false;
    }
    return true;
}

/// Check if status_now is non-empty.
pub fn validate_status(status_now: []const u8) bool {
    return status_now.len > 0;
}

/// Build the issue title from untested count and rel path.
pub fn build_title(untested: u32, rel: []const u8) []const u8 {
    // In .t27 we can't easily do string formatting, so we return a placeholder
    // The actual formatting would happen in the generated code
    return rel;
}

/// Build the issue body from the build input.
/// This is a complex function that would be implemented in the target language.
pub fn build_body(input: BuildInput) []const u8 {
    undefined;
}

/// The main coverage function - runs t27c coverage and parses output.
/// This does I/O, so it's undefined here. The decision logic is in parse_coverage_output.
pub fn coverage(rel: []const u8) ?CoverageResult {
    undefined;
}

/// The main build function - reads file, runs commands, builds issue.
/// This does I/O, so it's undefined here. The decision logic is in validate_* and build_* helpers.
pub fn build(rel: []const u8) ?BuildOutput {
    undefined;
}

/// Categorize a spec by its untested count.
pub fn categorize_spec(untested: u32) enum { .none, .small, .big } {
    if (untested == 0) return .none;
    if (untested <= MAX_UNTESTED) return .small;
    return .big;
}

/// Sort population entries by (untested, rel).
pub fn sort_population_entries(entries: []PopulationEntry) void {
    // Simple bubble sort for small arrays
    var n = entries.len;
    while (n > 1) {
        var swapped = false;
        for (i in 0..n-1) {
            const a = entries[i];
            const b = entries[i + 1];
            if (a.untested > b.untested or (a.untested == b.untested and compare_str(a.rel, b.rel) > 0)) {
                entries[i] = b;
                entries[i + 1] = a;
                swapped = true;
            }
        }
        if (!swapped) break;
        n -= 1;
    }
}

fn compare_str(a: []const u8, b: []const u8) i32 {
    var i: usize = 0;
    while (i < a.len and i < b.len) {
        if (a[i] < b[i]) return -1;
        if (a[i] > b[i]) return 1;
        i += 1;
    }
    if (a.len < b.len) return -1;
    if (a.len > b.len) return 1;
    return 0;
}

/// The population function - walks specs directory and categorizes.
/// This does I/O, so it's undefined here. The decision logic is in categorize_spec and sort_population_entries.
pub fn population() PopulationResult {
    undefined;
}

/// Refuse unshaped issues - calls task_shape.problems.

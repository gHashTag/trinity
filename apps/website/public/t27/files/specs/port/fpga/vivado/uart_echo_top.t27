// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/vivado/uart_echo_top.t27
// Port of fpga/vivado/uart_echo_top.v to .t27 for silicon target (t27c gen-verilog).
// UART echo top with ring oscillator clock, UART RX/TX, and LED outputs.
// phi^2 + 1/phi^2 = 3 | TRINITY

module uart_echo_top {

    // === Module interface ===

    pub struct ModuleInterface {
        uart_rx_pin : bool,
        uart_tx_pin : bool,
        led_r23 : bool,
        led_t23 : bool,
    }

    // === Ring oscillator constants ===

    pub const OSC_CHAIN_LENGTH : u32 = 20;
    pub const COUNTER_WIDTH : u32 = 23;

    // === UART constants ===

    pub const CLK_DIV : u32 = 175;
    pub const UART_DATA_WIDTH : u32 = 8;

    // === State machine states ===

    pub enum State {
        IDLE,
        SEND_ECHO,
    }

    // === Ring oscillator state ===

    pub struct OscillatorState {
        chain : [20]bool,
    }

    // === Counter state ===

    pub struct CounterState {
        value : u32,  // 23-bit counter stored in u32
    }

    // === UART RX interface ===

    pub struct UartRxInterface {
        clk : bool,
        rx : bool,
        valid : bool,
        data : u8,
    }

    // === UART TX interface ===

    pub struct UartTxInterface {
        clk : bool,
        data : u8,
        start : bool,
        tx : bool,
        done : bool,
    }

    // === Echo state machine state ===

    pub struct EchoState {
        state : State,
        tx_data : u8,
        tx_start : bool,
    }

    // === Constructor helpers ===

    fn init_oscillator_state() -> OscillatorState {
        return OscillatorState{
            .chain = [false, false, false, false, false, false, false, false,
                      false, false, false, false, false, false, false, false,
                      false, false, false, false],
        };
    }

    fn init_counter_state() -> CounterState {
        return CounterState{ .value = 0 };
    }

    fn init_echo_state() -> EchoState {
        return EchoState{
            .state = State.IDLE,
            .tx_data = 0,
            .tx_start = false,
        };
    }

    // === Ring oscillator logic ===

    fn update_oscillator_chain(state: OscillatorState) -> OscillatorState {
        var new_state : OscillatorState = state;
        
        // chain[0] = ~chain[19] (ring oscillator feedback)
        new_state.chain[0] = !state.chain[19];
        
        // Propagate through chain: chain[i] = chain[i-1]
        var i : u32 = 1;
        while (i < OSC_CHAIN_LENGTH) {
            new_state.chain[i] = state.chain[i-1];
            i = i + 1;
        }
        
        return new_state;
    }

    fn get_oscillator_output(state: OscillatorState) -> bool {
        return state.chain[19];  // osc = chain[19]
    }

    // === Counter logic ===

    fn increment_counter(counter: CounterState) -> CounterState {
        var new_counter : CounterState = counter;
        new_counter.value = counter.value + 1;
        return new_counter;
    }

    // Extract bit N from counter (0-indexed from LSB)
    fn get_counter_bit(counter: CounterState, bit: u32) -> bool {
        let mask : u32 = 1 << bit;
        return (counter.value & mask) != 0;
    }

    // === UART RX simulation (behavioral model) ===
    // In hardware, uart_rx is an external module. Here we model its interface.
    // The actual Verilog generation will instantiate uart_rx as a submodule.

    fn uart_rx_step(rx_if: UartRxInterface) -> UartRxInterface {
        // Behavioral model: on rising edge of clk, sample rx
        // This is a simplified model - actual hardware uses CLK_DIV for baud rate
        var new_if : UartRxInterface = rx_if;
        // In real hardware, this would be a full UART RX state machine
        // For simulation/testing, we just pass through
        new_if.valid = false;  // Default
        new_if.data = 0;
        return new_if;
    }

    // === UART TX simulation (behavioral model) ===

    fn uart_tx_step(tx_if: UartTxInterface) -> UartTxInterface {
        var new_if : UartTxInterface = tx_if;
        // In real hardware, this would transmit data over multiple cycles
        // For simulation, we assert done immediately when start is asserted
        if (tx_if.start) {
            new_if.done = true;
            new_if.tx = false;  // Start bit (simplified)
            new_if.start = false;
        } else {
            new_if.done = false;
            new_if.tx = true;  // Line idle high
        }
        return new_if;
    }

    // === Echo state machine ===

    fn echo_state_machine(
        echo: EchoState,
        rx_valid: bool,
        rx_data: u8,
        tx_done: bool
    ) -> EchoState {
        var new_echo : EchoState = echo;
        
        // Default: tx_start stays low unless asserted
        new_echo.tx_start = false;
        
        if (echo.state == State.IDLE) {
            if (rx_valid) {
                new_echo.tx_data = 0xAA;  // Original sends 0xAA, not rx_data
                new_echo.tx_start = true;
                new_echo.state = State.SEND_ECHO;
            }
        } else if (echo.state == State.SEND_ECHO) {
            if (tx_done) {
                new_echo.state = State.IDLE;
            }
        }
        
        return new_echo;
    }

    // === LED output logic ===

    fn get_led_outputs(counter: CounterState) -> ModuleInterface {
        return ModuleInterface{
            .uart_rx_pin = false,  // Input, not driven here
            .uart_tx_pin = false,  // Driven by UART TX
            .led_r23 = !get_counter_bit(counter, 20),  // ~counter[20]
            .led_t23 = !get_counter_bit(counter, 19),  // ~counter[19]
        };
    }

    // === Main simulation step (one clock cycle) ===

    fn simulate_step(
        osc_state: OscillatorState,
        counter_state: CounterState,
        echo_state: EchoState,
        uart_rx_pin: bool
    ) -> (OscillatorState, CounterState, EchoState, ModuleInterface) {
        
        // Update oscillator chain
        let new_osc_state = update_oscillator_chain(osc_state);
        let osc_clock = get_oscillator_output(new_osc_state);
        
        // Previous oscillator output for edge detection
        let prev_osc = get_oscillator_output(osc_state);
        let pos_edge = osc_clock and !prev_osc;
        
        var new_counter_state = counter_state;
        var new_echo_state = echo_state;
        
        // On positive edge of osc, increment counter
        if (pos_edge) {
            new_counter_state = increment_counter(counter_state);
        }
        
        // Simulate UART RX (combinational for test purposes)
        let rx_if = UartRxInterface{
            .clk = osc_clock,
            .rx = uart_rx_pin,
            .valid = false,
            .data = 0,
        };
        let rx_if_next = uart_rx_step(rx_if);
        
        // Echo state machine
        new_echo_state = echo_state_machine(
            echo_state,
            rx_if_next.valid,
            rx_if_next.data,
            false  // tx_done from UART TX
        );
        
        // Simulate UART TX
        let tx_if = UartTxInterface{
            .clk = osc_clock,
            .data = new_echo_state.tx_data,
            .start = new_echo_state.tx_start,
            .tx = false,
            .done = false,
        };
        let tx_if_next = uart_tx_step(tx_if);
        
        // Re-run echo state machine with actual tx_done
        new_echo_state = echo_state_machine(
            new_echo_state,
            rx_if_next.valid,
            rx_if_next.data,
            tx_if_next.done
        );
        
        // Get LED outputs
        let interface = get_led_outputs(new_counter_state);
        interface.uart_tx_pin = tx_if_next.tx;
        
        return (new_osc_state, new_counter_state, new_echo_state, interface);
    }

    // === Tests ===

    test oscillator_chain_initialization
        given state = init_oscillator_state()
        then state.chain[0] == false
        and state.chain[19] == false

    test oscillator_ring_feedback
        given state = init_oscillator_state()
        let new_state = update_oscillator_chain(state)
        then new_state.chain[0] == true   // !chain[19] = !false = true
        and new_state.chain[1] == false   // chain[0] was false

    test oscillator_output_from_last_element
        given state = OscillatorState{.chain = [true, false, false, false, false, false,
                                               false, false, false, false, false, false,
                                               false, false, false, false, false, false,
                                               false, false]}
        then get_oscillator_output(state) == false  // chain[19] = false

    test_counter_initial_value
        given counter = init_counter_state()
        then counter.value == 0

    test_counter_increment
        given counter = init_counter_state()
        let new_counter = increment_counter(counter)
        then new_counter.value == 1

    test_counter_bit_extraction
        given counter = CounterState{.value = 1}  // binary: ...0001
        then get_counter_bit(counter, 0) == true
        and get_counter_bit(counter, 1) == false
        and get_counter_bit(counter, 19) == false
        and get_counter_bit(counter, 20) == false

    test_counter_bit_19_set
        given counter = CounterState{.value = 524288}  // 2^19
        then get_counter_bit(counter, 19) == true
        and get_counter_bit(counter, 20) == false

    test_counter_bit_20_set
        given counter = CounterState{.value = 1048576}  // 2^20
        then get_counter_bit(counter, 19) == false
        and get_counter_bit(counter, 20) == true

    test_echo_state_machine_idle_to_send
        given echo = init_echo_state()
        let new_echo = echo_state_machine(echo, true, 0x42, false)
        then new_echo.state == State.SEND_ECHO
        and new_echo.tx_data == 0xAA
        and new_echo.tx_start == true

    test_echo_state_machine_send_to_idle
        given echo = EchoState{.state = State.SEND_ECHO, .tx_data = 0xAA, .tx_start = false}
        let new_echo = echo_state_machine(echo, false, 0, true)  // tx_done = true
        then new_echo.state == State.IDLE
        and new_echo.tx_start == false

    test_echo_state_machine_stays_in_send
        given echo = EchoState{.state = State.SEND_ECHO, .tx_data = 0xAA, .tx_start = false}
        let new_echo = echo_state_machine(echo, false, 0, false)  // tx_done = false
        then new_echo.state == State.SEND_ECHO

    test_led_outputs_counter_zero
        given counter = init_counter_state()
        let interface = get_led_outputs(counter)
        then interface.led_r23 == true   // ~counter[20] = ~0 = true
        and interface.led_t23 == true    // ~counter[19] = ~0 = true

    test_led_outputs_bit20_set
        given counter = CounterState{.value = 1048576}  // 2^20
        let interface = get_led_outputs(counter)
        then interface.led_r23 == false  // ~counter[20] = ~1 = false
        and interface.led_t23 == true    // ~counter[19] = ~0 = true

    test_led_outputs_bit19_set
        given counter = CounterState{.value = 524288}  // 2^19
        let interface = get_led_outputs(counter)
        then interface.led_r23 == true   // ~counter[20] = ~0 = true
        and interface.led_t23 == false   // ~counter[19] = ~1 = false

    test_full_simulation_step
        given osc = init_oscillator_state()
        given counter = init_counter_state()
        given echo = init_echo_state()
        let (new_osc, new_counter, new_echo, interface) = simulate_step(osc, counter, echo, false)
        // After one step, oscillator chain has propagated
        then new_osc.chain[0] == true
        // Counter increments on positive edge (osc went from 0->1)
        and new_counter.value == 1
        // Echo state unchanged (no rx_valid)
        and new_echo.state == State.IDLE
        // LEDs based on new counter
        and interface.led_r23 == true
        and interface.led_t23 == true

    // === Invariants ===

    invariant oscillator_chain_length_constant
        given state = init_oscillator_state()
        assert state.chain.len == OSC_CHAIN_LENGTH

    invariant counter_width_sufficient
        given counter = CounterState{.value = 0x7FFFFF}  // 23 bits all 1
        assert counter.value < (1 << COUNTER_WIDTH)

    invariant uart_clk_div_constant
        assert CLK_DIV == 175

    invariant led_outputs_are_inverted_counter_bits
        // led_r23 = ~counter[20], led_t23 = ~counter[19]
        given counter = CounterState{.value = 0}
        var interface = get_led_outputs(counter)
        assert interface.led_r23 == !get_counter_bit(counter, 20)
        and interface.led_t23 == !get_counter_bit(counter, 19)

    // === Benchmarks ===

    bench oscillator_update_latency
        measure: nanoseconds to update_oscillator_chain(init_oscillator_state())
        target: < 10ns

    bench counter_increment_latency
        measure: nanoseconds to increment_counter(init_counter_state())
        target: < 5ns

    bench echo_state_machine_latency
        measure: nanoseconds to echo_state_machine(init_echo_state(), true, 0x42, false)
        target: < 5ns

    bench led_output_latency
        measure: nanoseconds to get_led_outputs(init_counter_state())
        target: < 5ns

    bench full_step_latency
        measure: nanoseconds to simulate_step(init_oscillator_state(), init_counter_state(), init_echo_state(), false)
        target: < 50ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY
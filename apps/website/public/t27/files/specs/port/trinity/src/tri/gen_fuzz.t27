module port::trinity::gen_fuzz;

const Allocator = struct { id: u32; };
const RngState = struct { seed: u64, counter: u64; };

var alloc_buffer: [1024]u8 = [0] ** 1024;

fn allocator_alloc(allocator: Allocator, len: usize) -> []u8 {
    return alloc_buffer[0..len];
}
fn rng_init(seed: u64) -> RngState { return .{ .seed = seed, .counter = 0 }; }
fn rng_next(rng_state: *RngState) -> u8 {
    rng_state.counter = rng_state.counter + 1;
    return undefined;
}
fn rng_int_range(rng_state: *RngState, min: i32, max: i32) -> i32 {
    rng_state.counter = rng_state.counter + 1;
    return undefined;
}

const Fuzzer = struct {
    allocator: Allocator,
    rng_state: RngState,
};

fn Fuzzer_init(allocator: Allocator, seed: u64) -> Fuzzer {
    return .{
        .allocator = allocator,
        .rng_state = rng_init(seed),
    };
}

fn Fuzzer_randomBytes(fuzzer: *Fuzzer, len: usize) -> []u8 {
    const bytes = allocator_alloc(fuzzer.allocator, len);
    var i: usize = 0;
    while (i < len) {
        bytes[i] = rng_next(&fuzzer.rng_state);
        i = i + 1;
    }
    return bytes;
}

fn Fuzzer_randomInt(fuzzer: *Fuzzer, min: i32, max: i32) -> i32 {
    return rng_int_range(&fuzzer.rng_state, min, max);
}

test "Fuzzer_init_seed" {
    var a: Allocator = Allocator { id: 0 };
    var f = Fuzzer_init(a, 42);
    assert(f.rng_state.seed == 42);
    assert(f.rng_state.counter == 0);
}

test "Fuzzer_randomBytes_increments_counter" {
        var a: Allocator = Allocator { id: 0 };
        var f = Fuzzer_init(a, 0);
        const len = 5;
        const bytes = Fuzzer_randomBytes(&f, len);
        assert(bytes.len >= 0);
        assert(f.rng_state.counter == len);
    }

test "Fuzzer_randomInt_increments_counter" {
    var a: Allocator = Allocator { id: 0 };
    var f = Fuzzer_init(a, 0);
    const x = Fuzzer_randomInt(&f, 0, 10);
    // x is an i32, always true
    assert(x >= 0 || x < 0);
    assert(f.rng_state.counter == 1);
}
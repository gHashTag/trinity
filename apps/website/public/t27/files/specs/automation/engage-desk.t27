// SPDX-License-Identifier: Apache-2.0
// specs/automation/engage-desk.t27 -- the engage desk: the owner's signed-in browser
// searches X, LinkedIn and Reddit for recent posts on the topics of his research
// (the topics come from his own blog feed), drafts one substantive comment tied to
// his work, and asks him. A comment is posted only after his yes, per item.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/engage-desk.ts (the
//       tick: open questions first, then at most one proposal per network per search;
//       the caps, the dedupe, the claim and mention guards, the receipt) beside
//       src/agent/engage-desk-wiring.ts (the search pages read in the owner's
//       browser, the model's draft, the comment box pressed by its label), driven by
//       the interval in render-server.ts with the search pace kept in the database.
// Laws carried from the blog desk (specs/automation/blog-share.t27, 2026-10-02):
//       - a question lives as long as its approval row says (ttl_ms, 24 h here), not
//         the ten minutes of a click;
//       - a decline is real only when the approval was decided; silence is told;
//       - a press is not a comment: only the comment's words found on the post page
//         afterwards are a receipt.
// The owner's rules for anything said in his name: no mentions, no direct messages,
// never twice on one post, a small daily cap per network, and nothing the claim guard
// refuses (no top rank, no multiplier-freedom credited to the format, no FPGA decode
// advantage).
// UI words (the owner reads Russian) stay in the host; the spec holds the rules.
// Claim status: the desk is built behind ENGAGE_DESK_ENABLED=1 on the render service;
//       no comment has been posted through it yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::engage_desk {

    pub const KIND : str = "automation";
    pub const ID : str = "engage-desk";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The pace -------------------------------------------------------------------
    pub const TICK_MS : u32 = 300000;  // render-server.ts: every five minutes, so a yes
                                       // is acted on within five minutes
    pub const SEARCH_EVERY_MS : u32 = 21600000;  // 6 h between searches; the mark lives in
                                                 // agent_strategies, a deploy cannot reset it
    pub const ANSWER_WAIT_MS : u32 = 86400000;  // 24 h: the approval's own lifetime
    pub const DAY_MS : u32 = 86400000;  // the window the daily cap is counted in

    // ---- The limits -----------------------------------------------------------------
    pub const DAILY_CAP_PER_NETWORK : u8 = 3;  // comment proposals per network per day
    pub const PER_SEARCH_PER_NETWORK : u8 = 1;  // one proposal per network per search
    pub const POST_MAX_AGE_MS : u32 = 604800000;  // 7 days: only recent posts
    pub const COMMENT_MIN_CHARS : u16 = 80;  // shorter is not substantive
    pub const COMMENT_MAX_CHARS : u16 = 1000;  // LinkedIn and Reddit
    pub const X_COMMENT_MAX_CHARS : u16 = 280;  // X and Threads: short replies
    pub const RECEIPT_SNIPPET_CHARS : u8 = 40;  // the words looked for on the post page

    // ---- The rules that are not numbers ---------------------------------------------
    pub const ASK_NEEDS_YES : bool = true;  // every comment, every time, per item
    pub const ONE_COMMENT_PER_POST : bool = true;  // never twice on the same post
    pub const MENTIONS_ALLOWED : bool = false;  // no @name, no u/name
    pub const DMS_ALLOWED : bool = false;  // the desk never writes a direct message
    pub const CLAIM_GUARD_REQUIRED : bool = true;  // the draft passes the claim guard

    // ---- Many networks, many tabs ---------------------------------------------------
    // Searched when the browser is SEEN signed in: x, linkedin, reddit, threads, habr.
    // Facebook and Telegram have no reader yet and are reported, never guessed at.
    pub const READER_NETWORKS : u8 = 5;
    pub const PARALLEL_TABS_MAX : u8 = 3;  // searches run side by side, three tabs at most

    // ---- Each network's own rules (the per-network table) ---------------------------
    // Reddit: the 9:1 guideline -- at most one in ten of the owner's comments there may
    //   point at his own work; a subreddit's rules are read BEFORE proposing, and a
    //   subreddit that bans AI-written posts or bots is skipped, one that bans
    //   self-promotion gets no link.
    // X: automated replies are forbidden by its automation rules; every reply here is
    //   written for one post and sent by the owner's yes, never in bulk, and carries no
    //   link (link replies read as spam).
    // LinkedIn: no automated commenting or engagement pods; a person approves each one;
    //   no link in a comment.
    // Threads, Habr: no link in a comment; Habr bans advertising in comments.
    pub const PROMO_SHARE_MAX_PERCENT : u8 = 10;  // Reddit 9:1
    pub const PROMO_WINDOW_MS : u32 = 2592000000;  // the share counted over 30 days
    pub const RULES_READ_FIRST : bool = true;  // a subreddit's rules before a proposal

    // ---- Context and voice ----------------------------------------------------------
    pub const THREAD_CONTEXT_REQUIRED : bool = true;  // the thread is read before a draft
    pub const VOICE_REFRESH_MS : u32 = 604800000;  // the owner's voice profile, weekly
    pub const VOICE_SAMPLES : u8 = 3;  // his own paragraphs shown to the drafter

    // ---- Leads ----------------------------------------------------------------------
    pub const LEAD_CHECK_AFTER_MS : u32 = 86400000;  // first look at replies a day later
    pub const LEAD_CHECK_LAST_MS : u32 = 604800000;  // the last look a week after posting

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;  // flips when a comment is confirmed by its receipt

    // A search is due when none ever ran, or the last one is a pace old.
    fn search_due(ever_searched: bool, since_last_ms: u32) -> bool {
        return !ever_searched || since_last_ms >= SEARCH_EVERY_MS;
    }

    // Only a post younger than a week is worth a comment.
    fn fresh(age_ms: u32) -> bool {
        return age_ms < POST_MAX_AGE_MS;
    }

    // The comment fits its network and is long enough to say something.
    fn fits(network: str, len: u16) -> bool {
        return len >= COMMENT_MIN_CHARS
            && (((network == "x" || network == "threads") && len <= X_COMMENT_MAX_CHARS)
                || (network != "x" && network != "threads" && len <= COMMENT_MAX_CHARS));
    }

    // A proposal may be asked: under the day's cap for its network, never on a post
    // already proposed, no mention in it, and the claim guard passed.
    fn may_propose(asked_today: u8, seen_post: bool, has_mention: bool, claims_ok: bool) -> bool {
        return asked_today < DAILY_CAP_PER_NETWORK && !seen_post && !has_mention && claims_ok;
    }

    // An open question is still waited on while pending and younger than its lifetime.
    fn still_waiting(answer: str, age_ms: u32) -> bool {
        return answer == "pending" && age_ms < ANSWER_WAIT_MS;
    }

    // Only "allowed" posts the comment.
    fn posts_only_on_yes(answer: str) -> bool {
        return answer == "allowed";
    }

    // A decline is real only when a person decided it.
    fn decline_is_real(answer: str) -> bool {
        return answer == "denied";
    }

    // The receipt: the comment's own words were read back from the post page.
    fn receipt_seen(snippet_len: u8, found: bool) -> bool {
        return snippet_len > 0 && found;
    }

    // Only Reddit takes a link, and only to the owner's own page, under the 9:1 share
    // and where the subreddit does not ban self-promotion.
    fn link_allowed(network: str, sub_bans_promo: bool, promo_ok: bool) -> bool {
        return network == "reddit" && !sub_bans_promo && promo_ok;
    }

    // One more promotional comment keeps the share at or under the cap.
    fn promo_ok(promo_before: u16, total_before: u16) -> bool {
        return (promo_before + 1) * 100 <= PROMO_SHARE_MAX_PERCENT * (total_before + 1);
    }

    // A community that bans AI-written posts or bots is not commented in at all.
    fn community_allows(bans_ai: bool, rules_read: bool) -> bool {
        return rules_read && !bans_ai;
    }

    // A draft is written only after the thread itself was read.
    fn may_draft(thread_read: bool) -> bool {
        return thread_read;
    }

    // A posted comment is looked at for replies between a day and a week after.
    fn lead_check_due(posted_age_ms: u32, since_check_ms: u32, ever_checked: bool) -> bool {
        return posted_age_ms >= LEAD_CHECK_AFTER_MS && posted_age_ms < LEAD_CHECK_LAST_MS
            && (!ever_checked || since_check_ms >= LEAD_CHECK_AFTER_MS);
    }

    test "a search every six hours, on a five-minute tick" {
        assert(search_due(false, 0));
        assert(!search_due(true, 21599999));
        assert(search_due(true, 21600000));
        assert(TICK_MS == 300000);
        assert(TICK_MS < SEARCH_EVERY_MS);
    }

    test "only recent posts" {
        assert(fresh(0));
        assert(fresh(604799999));
        assert(!fresh(604800000));
    }

    test "a comment fits its network and says something" {
        assert(fits("x", 80));
        assert(fits("x", 280));
        assert(!fits("x", 281));
        assert(fits("linkedin", 281));
        assert(fits("reddit", 1000));
        assert(!fits("reddit", 1001));
        assert(!fits("linkedin", 79));
        assert(!fits("x", 0));
        assert(!fits("threads", 281));
    }

    test "at most three proposals a day per network" {
        assert(may_propose(0, false, false, true));
        assert(may_propose(2, false, false, true));
        assert(!may_propose(3, false, false, true));
        assert(DAILY_CAP_PER_NETWORK == 3);
        assert(PER_SEARCH_PER_NETWORK == 1);
        assert(DAY_MS == 86400000);
    }

    test "never twice on the same post" {
        assert(!may_propose(0, true, false, true));
        assert(ONE_COMMENT_PER_POST);
    }

    test "no mentions and no direct messages" {
        assert(!may_propose(0, false, true, true));
        assert(!MENTIONS_ALLOWED);
        assert(!DMS_ALLOWED);
    }

    test "nothing the claim guard refuses" {
        assert(!may_propose(0, false, false, false));
        assert(CLAIM_GUARD_REQUIRED);
    }

    test "an open question is waited on for a day, then let go" {
        assert(still_waiting("pending", 0));
        assert(still_waiting("pending", 86399999));
        assert(!still_waiting("pending", 86400000));
        assert(!still_waiting("allowed", 0));
        assert(!still_waiting("expired", 0));
        assert(ANSWER_WAIT_MS == 86400000);
    }

    test "a comment is posted only on a yes" {
        assert(posts_only_on_yes("allowed"));
        assert(!posts_only_on_yes("denied"));
        assert(!posts_only_on_yes("expired"));
        assert(!posts_only_on_yes("pending"));
        assert(ASK_NEEDS_YES);
    }

    test "a decline is real only if the approval was decided" {
        assert(decline_is_real("denied"));
        assert(!decline_is_real("expired"));
        assert(!decline_is_real("pending"));
        assert(!decline_is_real("allowed"));
    }

    test "the comment read back on the post is the receipt" {
        assert(receipt_seen(40, true));
        assert(!receipt_seen(40, false));
        assert(!receipt_seen(0, true));
        assert(RECEIPT_SNIPPET_CHARS == 40);
    }

    test "many networks side by side, three tabs at a time" {
        assert(READER_NETWORKS == 5);
        assert(PARALLEL_TABS_MAX == 3);
        assert(PARALLEL_TABS_MAX < READER_NETWORKS);
    }

    test "a link only on Reddit, only under nine to one" {
        assert(link_allowed("reddit", false, true));
        assert(!link_allowed("reddit", true, true));
        assert(!link_allowed("reddit", false, false));
        assert(!link_allowed("x", false, true));
        assert(!link_allowed("linkedin", false, true));
        assert(promo_ok(0, 9));
        assert(!promo_ok(0, 0));
        assert(!promo_ok(1, 10));
        assert(promo_ok(1, 19));
        assert(PROMO_SHARE_MAX_PERCENT == 10);
        assert(PROMO_WINDOW_MS == 2592000000);
    }

    test "the community's rules are read before a proposal" {
        assert(community_allows(false, true));
        assert(!community_allows(true, true));
        assert(!community_allows(false, false));
        assert(RULES_READ_FIRST);
    }

    test "the thread is read and the owner's voice is used" {
        assert(may_draft(true));
        assert(!may_draft(false));
        assert(THREAD_CONTEXT_REQUIRED);
        assert(VOICE_REFRESH_MS == 604800000);
        assert(VOICE_SAMPLES == 3);
    }

    test "replies are looked for between a day and a week" {
        assert(!lead_check_due(86399999, 0, false));
        assert(lead_check_due(86400000, 0, false));
        assert(!lead_check_due(100000000, 1000, true));
        assert(lead_check_due(200000000, 86400000, true));
        assert(!lead_check_due(604800000, 0, false));
    }

    test "the desk is built, a confirmed comment is not yet" {
        assert(!RUN_LIVE);
        assert(VERSION == 1);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY

// t27/specs/
// Merkle-Damgard construction with 64-byte blocks | φ² + 1/φ² = 3 | TRINITY

module TriSha256;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SHA256 = struct {
        state : [8]u32,
        buffer : [64]u8,
        count : u64,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions

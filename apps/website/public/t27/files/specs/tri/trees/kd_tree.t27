// t27/specs/
// Free tree | φ² + 1/φ² = 3 | TRINITY

module TriKdTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const KDNode = struct {
        point : []f64,
        axis : usize,
        left : ?KDNode,
        right : ?KDNode,
    };

    pub const KDTree = struct {
        root : ?KDNode,
        k : usize,
        allocator : std.mem.Allocator,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


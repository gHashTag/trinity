// t27/specs/
// Split full child node during insertion | φ² + 1/φ² = 3 | TRINITY

module TriBTree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BTreeNode = struct {
        keys : []usize,
        children : []?*BTreeNode,
        leaf : bool,
        count : usize,
    };

    pub const BTree = struct {
        root : ?*BTreeNode,
        t : usize,
        allocator : std.mem.Allocator,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // init(allocator: std.mem.Allocator, min_degree: usize) → BTree

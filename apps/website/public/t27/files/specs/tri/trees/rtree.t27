    }

    // insert(tree: *RTree, rect: Rect, allocator: std.mem.Allocator) → !void
    fn insert(tree: *RTree, rect: Rect, allocator: std.mem.Allocator) -> !void {
        // TODO: Implement from .tri spec
    }

    // query(tree: RTree, search_rect: Rect) → []Rect
    fn query(tree: RTree, search_rect: Rect) -> []Rect {

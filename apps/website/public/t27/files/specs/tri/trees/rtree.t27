// t27/specs/
// Spatial indexing | φ² + 1/φ² = 3 | TRINITY

module TriRtree;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Rect = struct {
        x_min : f64,
        y_min : f64,
        x_max : f64,
        y_max : f64,
    };

    pub const RTreeNode = struct {
        rect : Rect,
        children : []RTreeNode,
        is_leaf : bool,
    };

    pub const RTree = struct {
        root : ?RTreeNode,
        max_entries : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


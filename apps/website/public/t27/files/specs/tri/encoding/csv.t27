// t27/specs/
// RFC 4180 compliant | φ² + 1/φ² = 3 | TRINITY

module TriCsv;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const CsvRow = struct {
        cells : [][]const u8,
    };

    pub const CsvDocument = struct {
        headers : []CsvRow,
        rows : []CsvRow,
        delimiter : "u8",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


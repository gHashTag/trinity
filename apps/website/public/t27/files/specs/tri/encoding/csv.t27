    fn parse(text: []const u8) -> void {
        // TODO: Implement from .tri spec
    }

    // get(doc: CsvDocument) → void
    fn get(doc: CsvDocument) -> void {
        // TODO: Implement from .tri spec
    }

    // set(doc: *CsvDocument) → void
    fn set(doc: *CsvDocument) -> void {
        // TODO: Implement from .tri spec
    }

    // serialize(doc: CsvDocument) → void

// t27/specs/
// -- separates options from positional args | φ² + 1/φ² = 3 | TRINITY

module []const u8;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Arg = struct {
        short : ?u8,
        long : ?[]const u8,
        required : bool,
    };

    pub const ArgValue = struct {
        value : ?[]const u8,
        present : bool,
    };

    pub const ParseResult = struct {
        positional : [][]const u8,
        named : []ArgValue,
        error : ?[]const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


// t27/specs/
// Monotonic clock | φ² + 1/φ² = 3 | TRINITY

module TriTime;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Instant = struct {
        epoch_seconds : i64,
        nanos : u32,
    };

    pub const Duration = struct {
        seconds : i64,
        nanos : u32,
    };


// t27/specs/
// Supports both IPv4 and IPv6 | φ² + 1/φ² = 3 | TRINITY

module TriNet;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const IpAddress = struct {
        is_v6 : bool,
        bytes : [16]u8,
    };

    pub const SocketAddr = struct {
        ip : IpAddress,
        port : u16,
    };


    }

    // fulfill(promise: Promise(T)) → void
    fn fulfill(promise: Promise(T)) -> void {
        // TODO: Implement from .tri spec
    }

    // await(future: Future(T)) → void
    fn await(future: Future(T)) -> void {
        // TODO: Implement from .tri spec

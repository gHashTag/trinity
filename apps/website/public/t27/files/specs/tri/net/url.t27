// t27/specs/
// RFC 3986 compliant | φ² + 1/φ² = 3 | TRINITY

module TriUrl;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Url = struct {
        scheme : []const u8,
        host : []const u8,
        port : ?u16,
        path : []const u8,
        query : []const u8,
        fragment : []const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


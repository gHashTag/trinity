// t27/specs/
// Wraps around when full | φ² + 1/φ² = 3 | TRINITY

module TriRing;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Ring(T) = struct {
        buffer : []T,
        head : usize,
        tail : usize,
        capacity : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions

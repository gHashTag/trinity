// ArrayView provides zero-copy access | φ² + 1/φ² = 3 | TRINITY

module TriArray;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ArrayView(T) = struct {
        ptr : [*]T,
        len : usize,
    };

    pub const SliceRange = struct {
        start : usize,
        end : usize,
        step : i64,
    };


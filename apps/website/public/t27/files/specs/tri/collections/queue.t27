// First-in-first-out ordering | φ² + 1/φ² = 3 | TRINITY

module TriQueue;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Queue(T) = struct {
        front : []T,
        back : []T,
    };


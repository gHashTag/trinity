// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Derivative (can compute from output) | φ² + 1/φ² = 3 | TRINITY

module Tanh;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const TanhConfig = struct {
        none : void,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(x: f32) → f32
    fn forward(x: f32) -> f32 {
        // tanh(x) = (e^x - e^-x) / (e^x + e^-x)
        let exp_x = math::exp(x);
        let exp_neg_x = math::exp(-x);
        return (exp_x - exp_neg_x) / (exp_x + exp_neg_x);
    }

    // forward_batch(input: []f32) → []f32
    fn forward_batch(input: []f32) -> []f32 {
        let result = []f32{input.len};
        let mut i = 0;
        while (i < input.len) {
            result[i] = forward(input[i]);
            i = i + 1;
        }
        return result;
    }

    // derivative(x: f32) → f32
    fn derivative(x: f32) -> f32 {
        // tanh'(x) = 1 - tanh(x)²
        let tanh_x = forward(x);
        return 1.0 - (tanh_x * tanh_x);
    }

    // derivative_from_output(tanh_x: f32) → f32
    fn derivative_from_output(tanh_x: f32) -> f32 {
        // Given tanh(x), the derivative is 1 - tanh(x)²
        return 1.0 - (tanh_x * tanh_x);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test forward_basic_case
        given input = 0.0
        when result = forward(input)
        then result == 0.0

    test forward_batch_basic_case
        given input = []f32{3, [0.0, 1.0, 2.0]}
        when result = forward_batch(input)
        then result.len == 3
        then result[0] == 0.0
        then result[1] > 0.0
        then result[1] < 1.0
        then result[2] > result[1]

    test derivative_basic_case
        given input = 0.0
        when result = derivative(input)
        then result == 1.0

    test derivative_from_output_basic_case
        given input = 0.5
        when tanh_result = forward(input)
        when result = derivative_from_output(tanh_result)
        then result > 0.0
        then result < 1.0
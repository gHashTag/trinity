// t27/specs/
// Reparameterization for gradient estimation | φ² + 1/φ² = 3 | TRINITY

module PpoActor;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_INIT_LOG_STD : f32 = 0.0;
    const MIN_LOG_STD : f32 = -20.0;
    const MAX_LOG_STD : f32 = 2.0;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ActorConfig = struct {
        state_dim : u32,
        action_dim : u32,
        hidden_dims : []u32,
        action_space : ActionSpace,
        init_log_std : f32,
    };

    pub const ActionSpace = struct {
        enum : [DISCRETE, CONTINUOUS],
    };

    pub const PolicyOutput = struct {
        logits : []f32,
        log_std : []f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


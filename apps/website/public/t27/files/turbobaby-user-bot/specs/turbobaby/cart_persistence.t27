// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/cart_persistence.t27 -- what the cart tables actually guarantee
; This contract owns ONE gap and nothing else: the distance between the cart machine
; turbobaby/commerce declares and the two tables this repository ships. It states which of the
; declared states have a representation and which have none, the shape of each representation,
; the inference that stands in for abandonment together with its two thresholds and its exhaustion
; rule, the kind vocabulary the table admits against the one the write path admits, and the rule
; that a contract state with no column constrains no shipped code until a column exists.
; --
; WHY (measured 2026-09-21). Two numbers force the file, and both are zeroes with teeth.
; FIRST: of the four cart states the machine declares, the number stored in a column is 0. The
; carts table is ten columns across three migrations -- five at migrations/059_cart_tables.sql:5-11,
; two at migrations/061_cart_abandonment.sql:5-9, three at migrations/062_cart_recovery_variant.sql:5-12
; -- and the entity that reads it lists the same ten at src/db/entities/cart.rs:8-20. Not one of
; the twenty names is a status. So the state a checkout gate asks about cannot be loaded, and the
; gate consumes it as an argument supplied by the caller rather than by the row.
; SECOND: carts.updated_at has exactly ONE write site in the whole tree and ZERO update sites. It
; is set by the INSERT at src/api/cart.rs:302-303 and by nothing afterwards: the three UPDATE
; statements that touch this table (src/cart_abandonment.rs:84, :201, :259) set reminder_variant,
; reminder_sent_at, first_reminder_sent_at and reminder_count, and none of them names updated_at.
; A search for a SeaORM write of that field returns nothing either -- no cart ActiveModel is built
; anywhere. The comment at src/api/cart.rs:482 calls the re-read after an add a timestamp refresh
; and refreshes no timestamp, and the comment at src/main.rs:650-651 describes the sweep as looking
; for carts "that haven't been touched in 10 minutes". Nothing touches them. The ten-minute
; threshold at src/cart_abandonment.rs:172, applied to the predicate at src/cart_abandonment.rs:96-97,
; therefore measures AGE SINCE THE ROW WAS CREATED. Since carts.telegram_id is UNIQUE
; (migrations/059_cart_tables.sql:7) and no code deletes a cart row, a returning customer's row is
; permanently older than ten minutes, and the first rung of the ladder is decided by the reminder
; counter alone.
; --
; WHERE THE BRIEF IS REFUTED, three times, each citation opened.
;   1. The brief says the kind vocabulary "admits five kinds while commerce declares two deal
;      kinds, with one of the two appearing in no cart write path". The five is right and lives at
;      migrations/081_cart_rental_lines.sql:51. The rest is weaker than the code. The only gate on
;      both write paths is parse_kind (src/api/cart.rs:100-108), it admits FOUR, and bike_rental is
;      not one of them -- it falls to the catch-all refusal at src/api/cart.rs:106. Both write
;      paths go through it: add_cart_item at src/api/cart.rs:464 and collapse_merge_items at
;      src/api/cart.rs:135. The pricing side agrees: the match in resolve_catalog_snapshot
;      (src/api/cart.rs:169-268) has no bike arm and refuses at src/api/cart.rs:267. So NEITHER of
;      the two deal kinds appears in a cart write path, not one of them; the rental kind exists in
;      the table and cannot be put there, and no sale kind exists at all.
;   2. The brief cites "the inactivity inference around :92-108" of src/cart_abandonment.rs. That
;      span is the body of load_abandoned_carts -- the SELECT list, the join, the GROUP BY and the
;      bind call -- and the inference is two lines inside it, :96-97. Neither number that turns it
;      into a policy is in the span: the reminder-count argument and the ten-minute threshold are
;      supplied by the caller at src/cart_abandonment.rs:172, and the second rung's twenty-four
;      hours at src/cart_abandonment.rs:222 with its extra predicate at :227-230. A reader who
;      opened only :92-108 would find a parameterized query and no policy at all.
;   3. The brief's reuse list names turbobaby/notification-queue. The first pass through this file
;      refused that edge because no contract carried the id. THAT REFUSAL IS NOW WRONG, and the
;      scoping it was written under is exactly what makes the error visible instead of silent: the
;      id was absent from the thirty ids this file was handed, re-read from specs/ on 2026-09-21
;      before this file was added, and a contract carrying it landed later the same day.
;      RE-SCOPED at review on the same date, because the sentence above is honest about when it
;      was measured and misleading about what is true now. The corpus is no longer thirty: 43 ID
;      lines were opened one at a time -- 42 under specs/turbobaby plus specs/agents/turbobaby.t27
;      -- and specs/turbobaby/notification_queue.t27 declares turbobaby/notification-queue. A
;      reader who takes "the thirty ids" for the size of specs/ is reading a number that stopped
;      being true the same afternoon, which is the failure this paragraph exists to document, so
;      the current figure is pinned as a constant below rather than left inside a sentence about
;      the past. Both reciprocal edges were checked at review and both already stand:
;      REUSES_NOTIFICATION_QUEUE_ID and REUSES_RUNTIME_CONFIG_ID are declared below and asserted
;      by the wiring test. What does NOT change is the measurement, and it runs the other way from
;      what the brief implied: the reminder never reaches that queue. Both rungs call the Telegram
;      client directly (src/cart_abandonment.rs:184-188 and :244-248) and src/cart_abandonment.rs
;      names src/notification_queue.rs nowhere -- re-run 2026-09-21, 0 occurrences of the string
;      in that file. The reminder is fire-and-forget, and the counter that spends the rung is
;      incremented whether the send succeeded or failed -- deliberately, per the comment at
;      src/cart_abandonment.rs:195-196.
; --
; WHAT THIS FILE NEVER DOES. It declares no cart state machine: the four states, their transitions,
; their terminality, the checkout join and the idempotency decision are turbobaby/commerce's, are
; named by its ID below, and appear here only as the count 4 and as the representation question
; asked of each. It declares no order status vocabulary -- turbobaby/order-status owns that, and
; the two must not be confused because neither table has a status column for the other's reason.
; It declares no addability rule: whether a family may enter a cart at all is
; turbobaby/pricing-honesty's, which owns that decision by name. It re-decides no retirement:
; which tables were dropped and which rows were merely unpublished is turbobaby/legacy-retirement's,
; and is consumed here only as two booleans per kind. It declares no bonus arithmetic --
; turbobaby/loyalty-ledger owns the ledger, and the perk this repository promises and never credits
; is recorded below as a refusal, not as an amount. It declares no outbound queue: the row, the
; derived state, the terminal outcomes and the drain are turbobaby/notification-queue's, and this
; file carries one bit of that subject -- whether the reminder enters the queue, measured false.
; It decides no loop cadence: the sweep interval below is a marked copy of the row
; turbobaby/runtime-config carries in its loop inventory, and both read one literal in src/main.rs.
; It proposes NO COLUMN and reserves NO MIGRATION NUMBER. Both are refused explicitly and counted
; at zero, because a spec that names the column it wishes existed reads a week later as a column
; that does. The Cyrillic reminder copy is cited by path only (src/locales.rs:218 and :220) and is
; never quoted. No telegram id, no renter name, handle, phone, plate or personal note appears here
; in any form: every constant below is a table name, a column name, a path, a count, a threshold or
; a protocol numeral.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-cart-persistence;

pub const KIND : str = "persistence-contract";
pub const ID : str = "turbobaby/cart-persistence";
pub const NAME : str = "TurboBaby cart persistence guarantees";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";

pub const SCHEMA_ORIGIN : str = "migrations/059_cart_tables.sql";
pub const SCHEMA_REMINDERS : str = "migrations/061_cart_abandonment.sql";
pub const SCHEMA_VARIANT : str = "migrations/062_cart_recovery_variant.sql";
pub const SCHEMA_RENTAL_LINES : str = "migrations/081_cart_rental_lines.sql";
pub const WRITE_PATH : str = "src/api/cart.rs";
pub const SWEEP_PATH : str = "src/cart_abandonment.rs";
pub const CART_ENTITY : str = "src/db/entities/cart.rs";
pub const CART_ITEM_ENTITY : str = "src/db/entities/cart_item.rs";

; --- Cross-contract wiring ----------------------------------------------------------------------
; There are no imports in this language, so an edge is a string naming an owner plus a test that
; asserts the literal. Each of these names a decision this file consumes and refuses to restate.
; turbobaby/commerce owns the cart machine: it declares the states, the transition gate, the quote
; snapshot rule and the checkout join. This file asks one question the machine cannot ask itself --
; can the row hold the answer -- and takes the state count as a bare integer.
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
; turbobaby/order-status owns the order vocabulary. Named because the confusion is one grep away:
; the absence of a cart status column is not evidence about orders, whose status column is real and
; whose set is that contract's.
pub const REUSES_ORDER_STATUS_ID : str = "turbobaby/order-status";
; turbobaby/request-identity owns who a request is. Every endpoint in the write path runs its owner
; gate (src/api/cart.rs:447, :460, :517, :558, :582, :614) and none of those decisions is re-made
; here; the sweep instead reads the stored telegram_id, and its only identity test is the non-zero
; check at src/cart_abandonment.rs:98 and :116-118, which this file carries as one boolean.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
; turbobaby/legacy-retirement owns the difference between a dropped table and an unpublished row.
; This file consumes that difference as two booleans and re-decides nothing.
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
; turbobaby/pricing-honesty owns whether a family may enter a cart at all; that decision is upstream
; of every row this contract describes and no price appears below.
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
; turbobaby/loyalty-ledger owns bonus credit. Named because this file records a promised perk that
; is never credited, and the perk's amount, rules and ledger row are that contract's, not this one's.
pub const REUSES_LOYALTY_LEDGER_ID : str = "turbobaby/loyalty-ledger";
; turbobaby/notification-queue owns the persisted outbound queue -- its row shape, its derived
; state, its terminal outcomes, its drain and its cadence. This file consumes exactly one bit of
; that subject, REMINDER_ENQUEUES_A_ROW, and restates no column, no interval and no outcome of it.
; The edge exists because the id exists; the first pass through this file refused it in error.
pub const REUSES_NOTIFICATION_QUEUE_ID : str = "turbobaby/notification-queue";
; turbobaby/runtime-config owns the inventory of background-loop cadences and names this sweep in
; it by declaration LOOP_NAMES, with its seconds in LOOP_INTERVAL_SECONDS. The 300 below is the
; SAME literal, src/main.rs:660, carried here as a marked copy because it bounds how late the
; inference can fire -- not decided again. If the two ever disagree, the literal is right and both
; copies are stale.
pub const REUSES_RUNTIME_CONFIG_ID : str = "turbobaby/runtime-config";
pub const REUSE_EDGE_COUNT : u8 = 8;

; The size of the corpus this file's refutations were measured against, re-read at review on
; 2026-09-21 by opening the ID line of every .t27 file rather than by counting a handed list.
; Declared because the prose above quotes an older figure inside a sentence about the past, and a
; stale count left loose in prose is read as current by everyone who does not re-run it. The two
; booleans record that the edges the older sentence refused are present and verified, so the
; refusal cannot be mistaken for a live verdict.
pub const SPEC_IDS_READ_AT_REVIEW : u8 = 43;
pub const SPEC_IDS_UNDER_TURBOBABY_AT_REVIEW : u8 = 42;
pub const SPEC_IDS_IN_AGENT_CARDS_AT_REVIEW : u8 = 1;
pub const SPEC_IDS_HANDED_TO_THE_FIRST_PASS : u8 = 30;
pub const NOTIFICATION_QUEUE_OWNER_FILE : str = "specs/turbobaby/notification_queue.t27";
pub const NOTIFICATION_QUEUE_EDGE_IS_DECLARED : bool = true;
pub const RUNTIME_CONFIG_EDGE_IS_DECLARED : bool = true;

; --- The column census ---------------------------------------------------------------------------
; Ten columns on carts, twelve on cart_items, and the numbers that matter are what is NOT there.
pub const CARTS_TABLE : str = "carts";
pub const CART_ITEMS_TABLE : str = "cart_items";
pub const CARTS_COLUMN_COUNT : u8 = 10;
pub const CARTS_ENTITY_FIELD_COUNT : u8 = 10;
pub const CARTS_STATUS_COLUMN_COUNT : u8 = 0;
pub const CART_ITEMS_COLUMN_COUNT : u8 = 12;
pub const CART_ITEM_ENTITY_FIELD_COUNT : u8 = 10;
pub const CART_ITEM_COLUMNS_INVISIBLE_TO_THE_ENTITY : u8 = 2;

pub const CARTS_COLUMNS : [10]str = [
  "id",
  "telegram_id",
  "created_at",
  "updated_at",
  "expires_at",
  "reminder_sent_at",
  "reminder_count",
  "reminder_variant",
  "start_param",
  "first_reminder_sent_at"
];

; migrations/081_cart_rental_lines.sql:13-15 adds these two columns to the table. The entity at
; src/db/entities/cart_item.rs:8-20 still carries 059's ten fields, so the only loader in the API
; (load_cart_items, src/api/cart.rs:387-401) cannot see them and the response DTO
; (src/api/cart.rs:27-36) has nowhere to put them.
pub const CART_ITEM_COLUMNS_MISSING_FROM_THE_ENTITY : [2]str = ["rental_start", "rental_end"];

; A count is a census of the table, not of the reader. When the reader is short, the difference is
; the part of the schema no shipped read can reach.
pub fn entity_sees_every_column(column_count: u8, entity_field_count: u8) bool {
  return entity_field_count >= column_count;
}

pub fn column_has_a_reader(read_sites: u8) bool {
  return read_sites >= 1;
}

; --- How a state can be represented ---------------------------------------------------------------
; Five modes, ordered by strength. A column is the only one that can be written, read and trusted
; without a second fact; an inference derives the answer from columns written for another purpose;
; an enactment leaves no value at all, only an effect on rows; row presence is the default reading
; of a row that exists; NONE is the honest answer when the schema says nothing.
pub const REPRESENTATION_NONE : u8 = 0;
pub const REPRESENTATION_ROW_PRESENCE : u8 = 1;
pub const REPRESENTATION_ENACTED : u8 = 2;
pub const REPRESENTATION_INFERRED : u8 = 3;
pub const REPRESENTATION_COLUMN : u8 = 4;
pub const REPRESENTATION_MODE_COUNT : u8 = 5;

pub fn representation_mode(has_column: bool, has_inference: bool, has_enactment: bool, row_presence_suffices: bool) u8 {
  if (has_column) {
    return REPRESENTATION_COLUMN;
  }
  if (has_inference) {
    return REPRESENTATION_INFERRED;
  }
  if (has_enactment) {
    return REPRESENTATION_ENACTED;
  }
  if (row_presence_suffices) {
    return REPRESENTATION_ROW_PRESENCE;
  }
  return REPRESENTATION_NONE;
}

pub fn representation_is_authoritative(mode: u8) bool {
  return mode == REPRESENTATION_COLUMN;
}

pub fn representation_is_readable_as_a_value(mode: u8) bool {
  return mode == REPRESENTATION_COLUMN or mode == REPRESENTATION_INFERRED;
}

; The load-bearing sentence of this contract, as a function. A state with no representation binds
; nothing: no write can set it, no read can observe it, and no test can catch its absence. It is a
; promise the corpus makes and the database has never heard.
pub fn representation_constrains_shipped_code(mode: u8) bool {
  return mode != REPRESENTATION_NONE;
}

; --- The four declared states, measured one at a time -----------------------------------------------
; turbobaby/commerce owns these states; only the count and the representation verdict are here.
pub const COMMERCE_CART_STATE_COUNT : u8 = 4;
pub const STATES_WITH_A_COLUMN : u8 = 0;
pub const STATES_READABLE_AS_A_VALUE : u8 = 1;
pub const STATES_WITH_NO_REPRESENTATION : u8 = 1;

; OPEN. No column, no query derives it, no effect performs it. A carts row exists and that is the
; whole of the evidence; get_or_create_cart (src/api/cart.rs:280-317) creates one on a bare read,
; so the row's existence does not even mean the customer ever added anything.
pub const OPEN_HAS_COLUMN : bool = false;
pub const OPEN_HAS_INFERENCE : bool = false;
pub const OPEN_HAS_ENACTMENT : bool = false;
pub const OPEN_ROW_PRESENCE_SUFFICES : bool = true;

; LOCKED. Nothing. No column, no query, no effect, and no default reading either: a locked cart and
; an open cart are byte-identical rows. A checkout gate that refuses a cart for being unlocked is
; refusing on an argument its caller invented.
pub const LOCKED_HAS_COLUMN : bool = false;
pub const LOCKED_HAS_INFERENCE : bool = false;
pub const LOCKED_HAS_ENACTMENT : bool = false;
pub const LOCKED_ROW_PRESENCE_SUFFICES : bool = false;

; CONVERTED. No column. It is ENACTED: after a successful order the CLIENT calls the clear endpoint
; (src/ui/screens/checkout_screen.rs:1086-1089) and the server deletes the lines
; (src/api/cart.rs:594-603). The cart row itself survives the call.
; Address re-taken 2026-09-21: the block moved from :1050-1056 and lost a line when the identity
; it is guarded by stopped being flattened to a fabricated 0 and became the Option it always was.
; The guard is now `if let Some(tid)` instead of `!= 0`; what this section claims -- client-side
; enactment, unchecked result, cart row survives -- is unchanged and was re-read at the new
; address.
pub const CONVERTED_HAS_COLUMN : bool = false;
pub const CONVERTED_HAS_INFERENCE : bool = false;
pub const CONVERTED_HAS_ENACTMENT : bool = true;
pub const CONVERTED_ROW_PRESENCE_SUFFICES : bool = false;

; ABANDONED. No column. It is INFERRED, by the predicate at src/cart_abandonment.rs:96-98 joined to
; cart_items at :94, from a reminder counter and a timestamp threshold.
pub const ABANDONED_HAS_COLUMN : bool = false;
pub const ABANDONED_HAS_INFERENCE : bool = true;
pub const ABANDONED_HAS_ENACTMENT : bool = false;
pub const ABANDONED_ROW_PRESENCE_SUFFICES : bool = false;

; --- Conversion: enacted by the client, and its failure is silent ------------------------------------
pub const CONVERSION_ENACTMENT_SITE : str = "src/ui/screens/checkout_screen.rs:1086-1089";
pub const CONVERSION_ENACTMENT_IS_CLIENT_SIDE : bool = true;
pub const CONVERSION_IS_SERVER_ENFORCED : bool = false;
; The call is issued as a discarded result, so a dropped connection between the order commit and the
; clear leaves a converted cart holding its lines, with its reminder counter untouched and its next
; rung due.
pub const CONVERSION_ENACTMENT_RESULT_IS_CHECKED : bool = false;
pub const CONVERSION_DELETES_THE_CART_ROW : bool = false;

pub fn conversion_is_durable(server_enforced: bool, result_checked: bool) bool {
  return server_enforced and result_checked;
}

; --- The inactivity clock ------------------------------------------------------------------------
pub const UPDATED_AT_WRITE_SITE : str = "src/api/cart.rs:302-303";
pub const UPDATED_AT_INSERT_SITES : u8 = 1;
pub const UPDATED_AT_UPDATE_SITES : u8 = 0;
pub const CART_ROW_UPDATE_STATEMENT_COUNT : u8 = 3;
pub const CART_ROW_UPDATE_STATEMENTS_NAMING_UPDATED_AT : u8 = 0;

pub fn clock_measures_last_activity(update_sites: u8) bool {
  return update_sites >= 1;
}

pub fn clock_measures_row_age(insert_sites: u8, update_sites: u8) bool {
  return insert_sites >= 1 and update_sites == 0;
}

; --- The abandonment inference ---------------------------------------------------------------------
; Two rungs and no third. Thresholds read from the callers, not from the query.
; The interval is a MARKED COPY of turbobaby/runtime-config's loop-inventory row for this sweep and
; not a second decision; the one literal both read is src/main.rs:660. The batch limit is this
; file's own measurement and sits in no inventory: it is the LIMIT inside the query at
; src/cart_abandonment.rs:101.
pub const ABANDON_SWEEP_INTERVAL_SECONDS : u16 = 300;
pub const ABANDON_SWEEP_INTERVAL_IS_A_MARKED_COPY : bool = true;
pub const ABANDON_SWEEP_INTERVAL_LITERAL_SITE : str = "src/main.rs:660";
pub const ABANDON_BATCH_LIMIT : u16 = 100;
pub const ABANDON_LADDER_RUNGS : u8 = 2;
pub const ABANDON_FIRST_RUNG_REMINDER_COUNT : u8 = 0;
pub const ABANDON_FIRST_RUNG_MINUTES : u32 = 10;
pub const ABANDON_SECOND_RUNG_REMINDER_COUNT : u8 = 1;
pub const ABANDON_SECOND_RUNG_MINUTES : u32 = 0;
pub const ABANDON_SECOND_RUNG_HOURS_AFTER_FIRST : u32 = 24;

; src/cart_abandonment.rs:97 is a strict inequality on the timestamp, so the threshold is a floor
; the age must pass, not reach. cart_has_a_line is the inner join at :94; telegram_id_known is the
; non-zero filter declared twice, in SQL at :98 and again in Rust at :116-118.
pub fn first_rung_due(reminder_count: u8, minutes_since_updated_at: u32, cart_has_a_line: bool, telegram_id_known: bool) bool {
  return reminder_count == ABANDON_FIRST_RUNG_REMINDER_COUNT and minutes_since_updated_at > ABANDON_FIRST_RUNG_MINUTES and cart_has_a_line and telegram_id_known;
}

; The second rung passes 0 as the minute threshold (src/cart_abandonment.rs:226). That does not
; remove the row-age predicate at :97; it degenerates it to updated_at < now(), true for every row
; that exists, since nothing writes the column after the INSERT. The rung is gated instead on the
; first reminder's own timestamp (:227-230), and the row-age clock contributes nothing to it.
pub fn second_rung_due(reminder_count: u8, hours_since_first_reminder: u32, cart_has_a_line: bool, telegram_id_known: bool) bool {
  return reminder_count == ABANDON_SECOND_RUNG_REMINDER_COUNT and hours_since_first_reminder > ABANDON_SECOND_RUNG_HOURS_AFTER_FIRST and cart_has_a_line and telegram_id_known;
}

pub fn abandonment_inferred(reminder_count: u8, minutes_since_updated_at: u32, hours_since_first_reminder: u32, cart_has_a_line: bool, telegram_id_known: bool) bool {
  return first_rung_due(reminder_count, minutes_since_updated_at, cart_has_a_line, telegram_id_known) or second_rung_due(reminder_count, hours_since_first_reminder, cart_has_a_line, telegram_id_known);
}

; --- Exhaustion: the ladder is spent once, per row, for ever -------------------------------------
; The counter is incremented at src/cart_abandonment.rs:201 and :259 and decremented or zeroed
; nowhere. No statement in src/ deletes a carts row -- the single DELETE FROM carts in the
; repository is fixture cleanup at tests/integration_cart_merge.rs:193, which no deployment runs --
; and the clear endpoint deletes lines only, so a row that has spent both rungs can never qualify
; again. The count below is therefore scoped to shipped code, and says so.
pub const REMINDER_COUNT_RESET_SITES : u8 = 0;
pub const CART_ROW_DELETE_SITES : u8 = 0;
pub const CART_ROW_DELETE_SITES_ARE_COUNTED_IN_SRC_ONLY : bool = true;
pub const CART_ROW_DELETE_SITES_IN_TESTS : u8 = 1;
pub const REMINDER_COUNT_INCREMENT_SITES : u8 = 2;

pub fn ladder_can_refill(reset_sites: u8, row_delete_sites: u8) bool {
  return reset_sites >= 1 or row_delete_sites >= 1;
}

pub fn reminders_remaining(reminder_count: u8) u8 {
  if (reminder_count >= ABANDON_LADDER_RUNGS) {
    return 0;
  }
  return ABANDON_LADDER_RUNGS - reminder_count;
}

; The counter advances outside the error branch at both rungs, so a Telegram failure is logged
; (src/cart_abandonment.rs:189-194 and :249-254) and the rung is spent regardless. The comment at
; :195-196 records the trade deliberately: no retry storm, and no second chance either.
pub const COUNTER_INCREMENTS_ON_SEND_FAILURE : bool = true;

pub fn rung_is_consumed(send_attempted: bool, send_succeeded: bool) bool {
  return send_attempted or send_succeeded;
}

; --- Clearing a cart, and the row that outlives it ------------------------------------------------
pub const CLEAR_DELETES_ITEMS : bool = true;
pub const CLEAR_DELETES_THE_ROW : bool = false;
pub const CLEAR_RESETS_THE_REMINDER_COUNT : bool = false;

pub fn cart_after_clear_can_be_reminded_again(row_survives: bool, counter_reset: bool, reminder_count: u8) bool {
  if (!row_survives) {
    return true;
  }
  if (counter_reset) {
    return true;
  }
  return reminder_count < ABANDON_LADDER_RUNGS;
}

; expires_at is set to a thirty-day horizon by the INSERT at src/api/cart.rs:302-303. A grep for
; the name over src/ returns THREE hits, not two, and the third is why the count below is named for
; read sites and not for occurrences: src/db/entities/cart.rs:14 is the entity field, and
; src/main.rs:4051 is the string "expires_at" inside a lint's SENSITIVE_COLS list -- a token in a
; source-scanning test, not a load of this table. No sweep, no filter and no branch reads the
; value: the column is a written intention with no consumer.
pub const EXPIRES_AT_WRITE_SITES : u8 = 1;
pub const EXPIRES_AT_READ_SITES : u8 = 0;
pub const EXPIRES_AT_NAME_OCCURRENCES_IN_SRC : u8 = 3;

; --- Kind vocabulary: what the table admits, what the write path admits ---------------------------
pub const DB_KIND_CHECK : str = "migrations/081_cart_rental_lines.sql:51";
pub const API_KIND_GATE : str = "src/api/cart.rs:100-108";
pub const DB_KIND_COUNT : u8 = 5;
pub const API_KIND_COUNT : u8 = 4;
pub const BIKE_KIND : str = "bike_rental";

pub const DB_KINDS : [5]str = ["strain", "set", "accessory", "tea", "bike_rental"];
pub const API_KINDS : [4]str = ["strain", "set", "accessory", "tea"];

pub fn kind_is_storable(kind: str) bool {
  return kind == "strain" or kind == "set" or kind == "accessory" or kind == "tea" or kind == BIKE_KIND;
}

pub fn kind_is_api_writable(kind: str) bool {
  return kind == "strain" or kind == "set" or kind == "accessory" or kind == "tea";
}

; The gap the fifth kind opens: migration 081 went to considerable length to widen the CHECK, and
; no caller can reach the value it added.
pub fn kind_is_storable_but_unwritable(kind: str) bool {
  return kind_is_storable(kind) and !kind_is_api_writable(kind);
}

; --- Deal kinds against cart kinds ------------------------------------------------------------------
; turbobaby/commerce declares the deal kinds; only their count and their reachability are here.
pub const COMMERCE_DEAL_KIND_COUNT : u8 = 2;
pub const RENTAL_HAS_DB_KIND : bool = true;
pub const RENTAL_HAS_API_KIND : bool = false;
pub const SALE_HAS_DB_KIND : bool = false;
pub const SALE_HAS_API_KIND : bool = false;
pub const SALE_CART_KIND_EXISTS : bool = false;
pub const DEAL_KINDS_WITH_A_CART_KIND : u8 = 1;
pub const DEAL_KINDS_WITH_A_CART_WRITE_PATH : u8 = 0;

pub fn deal_kind_reaches_the_cart(has_db_kind: bool, has_api_kind: bool) bool {
  return has_db_kind and has_api_kind;
}

; --- What an add-to-cart actually does today ---------------------------------------------------------
; Four outcomes, and the live census of which kind lands on which. The two booleans after the gate
; are turbobaby/legacy-retirement's distinction, consumed and not re-decided: a dropped table is not
; an unpublished row, and they fail differently.
pub const OUTCOME_ROW_WRITTEN : u8 = 0;
pub const OUTCOME_BAD_REQUEST : u8 = 1;
pub const OUTCOME_UNRESOLVABLE : u8 = 2;
pub const OUTCOME_LOOKUP_ERROR : u8 = 3;
pub const OUTCOME_COUNT : u8 = 4;

pub fn add_to_cart_outcome(kind_accepted: bool, backing_table_exists: bool, catalog_row_visible: bool) u8 {
  if (!kind_accepted) {
    return OUTCOME_BAD_REQUEST;
  }
  if (!backing_table_exists) {
    return OUTCOME_LOOKUP_ERROR;
  }
  if (!catalog_row_visible) {
    return OUTCOME_UNRESOLVABLE;
  }
  return OUTCOME_ROW_WRITTEN;
}

; The three refusal numerals this WRITE path produces. They are declared here for the same reason
; turbobaby/request-identity declares its own three: the read-transport codes belong to
; turbobaby/catalog-api, and a write refusal is a different event on a different path. Success
; carries no numeral of this file's own.
pub const HTTP_STATUS_NOT_OWNED_HERE : u16 = 0;
pub const CART_WRITE_BAD_REQUEST : u16 = 400;
pub const CART_WRITE_UNPROCESSABLE : u16 = 422;
pub const CART_WRITE_SERVER_ERROR : u16 = 500;

pub fn cart_write_refusal_status(outcome: u8) u16 {
  if (outcome == OUTCOME_BAD_REQUEST) {
    return CART_WRITE_BAD_REQUEST;
  }
  if (outcome == OUTCOME_UNRESOLVABLE) {
    return CART_WRITE_UNPROCESSABLE;
  }
  if (outcome == OUTCOME_LOOKUP_ERROR) {
    return CART_WRITE_SERVER_ERROR;
  }
  return HTTP_STATUS_NOT_OWNED_HERE;
}

; The census, kind by kind, measured 2026-09-21.
;   bike_rental -- refused at the gate (src/api/cart.rs:106).
;   strain      -- accepted at the gate, and its table was dropped at
;                  migrations/083_drop_cannabis_catalog.sql:84. The surviving reader is excused by
;                  name at tests/retired_table_wiring.rs:56-65, whose own text records that this one
;                  maps the error to a server error rather than swallowing it (src/api/cart.rs:175).
;   set, accessory, tea -- accepted at the gate, rows kept and flipped invisible at
;                  migrations/085_unpublish_woody_catalog.sql:26-30, and the resolver filters on that
;                  flag (src/api/cart.rs:207, :222, :255-258), so the snapshot is absent and the
;                  handler refuses at src/api/cart.rs:467.
; Five kinds in the table, and the number that can write a row today is zero.
; The shipped client reached this conclusion before this contract did, and says so in a comment:
; src/ui/screens/cart_screen.rs:213-218 (:190-195 before the 2026-09-21 unpriced-line edits
; added twenty-three lines above it) records that the empty cart is the only state that screen
; can be in, and names the same three causes -- parse_kind's four kinds, 083's drop, 085's
; unpublish. The census below is a second measurement of a fact already written down in src/.
pub const CLIENT_SIDE_WITNESS : str = "src/ui/screens/cart_screen.rs:213-218";
pub const KINDS_THAT_CAN_WRITE_A_ROW_TODAY : u8 = 0;
pub const KINDS_REFUSED_AT_THE_GATE : u8 = 1;
pub const KINDS_REFUSED_BY_A_DROPPED_TABLE : u8 = 1;
pub const KINDS_REFUSED_BY_AN_INVISIBLE_ROW : u8 = 3;

; --- The dated line nothing can reach -----------------------------------------------------------------
; The columns exist, the CHECK that pairs them exists, the partial unique index that preserves 059's
; rule for undated lines exists, and the index for the availability query exists. The upsert names
; ten columns (src/api/cart.rs:75-85) and neither date, and the code says so itself at
; src/api/cart.rs:347-349. The entity cannot read them back. So every row this repository can create
; is undated, and a dated line is unreachable from both ends.
pub const UPSERT_COLUMN_COUNT : u8 = 10;
pub const UPSERT_WRITES_RENTAL_DATES : bool = false;
pub const ENTITY_EXPOSES_RENTAL_DATES : bool = false;
pub const RENTAL_DATE_WRITE_SITES_IN_THE_API : u8 = 0;
pub const RENTAL_DATE_READ_SITES_IN_THE_API : u8 = 0;

pub fn dated_line_is_reachable(entity_exposes_dates: bool, write_path_sets_dates: bool) bool {
  return entity_exposes_dates and write_path_sets_dates;
}

; --- Delivery of the reminder ---------------------------------------------------------------------
pub const REMINDER_SEND_IS_DIRECT : bool = true;
pub const REMINDER_ENQUEUES_A_ROW : bool = false;
pub const REMINDER_COPY_PATHS : [2]str = ["src/locales.rs:218", "src/locales.rs:220"];

; A send is retryable when either the delivery is persisted for a later attempt or a failure leaves
; the rung unspent. Neither holds here.
pub fn reminder_is_retryable(enqueued: bool, counter_advances_on_failure: bool) bool {
  if (enqueued) {
    return true;
  }
  return !counter_advances_on_failure;
}

; --- Honest refusals -------------------------------------------------------------------------------
pub const NO_COLUMN_IS_PROPOSED : bool = true;
pub const NO_MIGRATION_NUMBER_IS_RESERVED : bool = true;
pub const PROPOSED_COLUMNS_COUNT : u8 = 0;
pub const PROPOSED_MIGRATIONS_COUNT : u8 = 0;
pub const PROPOSED_COLUMNS : [0]str = [];
pub const PROPOSED_MIGRATIONS : [0]str = [];
pub const PERSONAL_DATA_FIELDS_PUBLISHED_COUNT : u8 = 0;
pub const CYRILLIC_STRINGS_PUBLISHED_COUNT : u8 = 0;

pub const LOCKED_STATE_REFUSAL_NOTE : str = "The locked state has no representation of any kind, and this file declines to invent one. What is missing is not a name but a mechanism: a column or a lock table, an owner for the lock, an expiry, and a decision on what happens to a cart whose checkout crashed while holding it. Until one exists, a checkout gate that refuses an unlocked cart is refusing on an argument its caller supplied, and no query in this repository can contradict that argument. No column name, no default and no timeout is proposed here in its place.";

pub const NOTIFICATION_QUEUE_BYPASS_NOTE : str = "The reminder does not enter the persisted outbound queue. Both rungs call the Telegram client directly at src/cart_abandonment.rs:184-188 and :244-248, and src/cart_abandonment.rs names src/notification_queue.rs nowhere. The queue itself -- its row, its derived state, its terminal outcomes, its drain and its cadence -- belongs to turbobaby/notification-queue, and none of it is restated here: this file carries the single bit REMINDER_ENQUEUES_A_ROW, measured false. An earlier pass over this file refused the reuse edge on the ground that no contract carried that id. The id exists, the edge is declared above, and the error is recorded here rather than deleted because a refusal that was right on Monday and wrong on Tuesday is the exact failure this corpus keeps walking into. What stays refused is the decision and not the owner: whether an abandonment reminder ought to be a queued notification at all is open, because the counter is spent on failure and a queued retry would spend the rung twice.";

pub const PROMISED_PERK_REFUSAL_NOTE : str = "The second rung promises bonus points in shipped copy (src/locales.rs:220 and :309, the same claim in the source comments at src/cart_abandonment.rs:7 and :214) and credits none. A search of src/cart_abandonment.rs for bonus, loyalty or points returns those two comments and no code; the only writes the rung performs are the message send and the counter increment at :259, and the only other effect is the metric at :264. The amount, the rules and the ledger row belong to turbobaby/loyalty-ledger, so no number is declared here. What is missing is the credit itself, plus a decision on whether a perk promised in copy and never granted should be granted or the copy corrected.";

pub const ACTIVITY_TIMESTAMP_REFUSAL_NOTE : str = "No column in this schema records when a cart was last touched. carts.updated_at is written once by the INSERT at src/api/cart.rs:302-303 and by nothing after it; cart_items.updated_at IS advanced by the upsert at src/api/cart.rs:85 and by the patch at src/api/cart.rs:522, but the abandonment query never reads it -- src/cart_abandonment.rs:97 filters on the cart row. So the repository holds the fact and does not consult it. This file pins the measurement and proposes neither a column nor a change of predicate, because which of the two timestamps ought to govern a reminder is a product decision about how long a shopper is left alone, not a schema tidy-up.";

; --- Tests ------------------------------------------------------------------------------------------

test carts_carries_ten_columns_and_none_of_them_is_a_status {
  assert CARTS_COLUMN_COUNT == 10;
  assert CARTS_STATUS_COLUMN_COUNT == 0;
  assert STATES_WITH_A_COLUMN == 0;
  assert COMMERCE_CART_STATE_COUNT == 4;
  assert entity_sees_every_column(CARTS_COLUMN_COUNT, CARTS_ENTITY_FIELD_COUNT) == true;
}

test the_cart_item_entity_is_two_columns_behind_its_table {
  assert CART_ITEMS_COLUMN_COUNT == 12;
  assert CART_ITEM_ENTITY_FIELD_COUNT == 10;
  assert CART_ITEM_COLUMNS_INVISIBLE_TO_THE_ENTITY == 2;
  assert entity_sees_every_column(CART_ITEMS_COLUMN_COUNT, CART_ITEM_ENTITY_FIELD_COUNT) == false;
}

test each_declared_state_gets_the_representation_the_schema_can_give_it {
  assert representation_mode(OPEN_HAS_COLUMN, OPEN_HAS_INFERENCE, OPEN_HAS_ENACTMENT, OPEN_ROW_PRESENCE_SUFFICES) == REPRESENTATION_ROW_PRESENCE;
  assert representation_mode(LOCKED_HAS_COLUMN, LOCKED_HAS_INFERENCE, LOCKED_HAS_ENACTMENT, LOCKED_ROW_PRESENCE_SUFFICES) == REPRESENTATION_NONE;
  assert representation_mode(CONVERTED_HAS_COLUMN, CONVERTED_HAS_INFERENCE, CONVERTED_HAS_ENACTMENT, CONVERTED_ROW_PRESENCE_SUFFICES) == REPRESENTATION_ENACTED;
  assert representation_mode(ABANDONED_HAS_COLUMN, ABANDONED_HAS_INFERENCE, ABANDONED_HAS_ENACTMENT, ABANDONED_ROW_PRESENCE_SUFFICES) == REPRESENTATION_INFERRED;
}

test a_column_would_outrank_every_weaker_representation {
  assert representation_mode(true, true, true, true) == REPRESENTATION_COLUMN;
  assert representation_mode(false, true, true, true) == REPRESENTATION_INFERRED;
  assert representation_mode(false, false, true, true) == REPRESENTATION_ENACTED;
  assert representation_mode(false, false, false, true) == REPRESENTATION_ROW_PRESENCE;
  assert representation_mode(false, false, false, false) == REPRESENTATION_NONE;
}

test no_declared_cart_state_is_authoritatively_stored {
  assert representation_is_authoritative(REPRESENTATION_COLUMN) == true;
  assert representation_is_authoritative(REPRESENTATION_INFERRED) == false;
  assert representation_is_authoritative(REPRESENTATION_ENACTED) == false;
  assert representation_is_authoritative(REPRESENTATION_ROW_PRESENCE) == false;
  assert representation_is_authoritative(REPRESENTATION_NONE) == false;
}

test a_state_with_no_representation_constrains_nothing {
  assert representation_constrains_shipped_code(REPRESENTATION_NONE) == false;
  assert representation_constrains_shipped_code(REPRESENTATION_ROW_PRESENCE) == true;
  assert representation_constrains_shipped_code(REPRESENTATION_ENACTED) == true;
  assert representation_constrains_shipped_code(REPRESENTATION_INFERRED) == true;
  assert representation_constrains_shipped_code(REPRESENTATION_COLUMN) == true;
  assert STATES_WITH_NO_REPRESENTATION == 1;
}

test only_a_column_or_an_inference_can_be_read_back_as_a_value {
  assert representation_is_readable_as_a_value(REPRESENTATION_COLUMN) == true;
  assert representation_is_readable_as_a_value(REPRESENTATION_INFERRED) == true;
  assert representation_is_readable_as_a_value(REPRESENTATION_ENACTED) == false;
  assert representation_is_readable_as_a_value(REPRESENTATION_ROW_PRESENCE) == false;
  assert representation_is_readable_as_a_value(REPRESENTATION_NONE) == false;
  assert STATES_READABLE_AS_A_VALUE == 1;
}

test conversion_is_performed_by_the_client_and_its_failure_is_unobservable {
  assert CONVERSION_ENACTMENT_IS_CLIENT_SIDE == true;
  assert CONVERSION_IS_SERVER_ENFORCED == false;
  assert CONVERSION_ENACTMENT_RESULT_IS_CHECKED == false;
  assert CONVERSION_DELETES_THE_CART_ROW == false;
  assert conversion_is_durable(CONVERSION_IS_SERVER_ENFORCED, CONVERSION_ENACTMENT_RESULT_IS_CHECKED) == false;
  assert conversion_is_durable(true, false) == false;
  assert conversion_is_durable(false, true) == false;
  assert conversion_is_durable(true, true) == true;
}

test the_inactivity_clock_measures_row_age_not_activity {
  assert UPDATED_AT_INSERT_SITES == 1;
  assert UPDATED_AT_UPDATE_SITES == 0;
  assert CART_ROW_UPDATE_STATEMENT_COUNT == 3;
  assert CART_ROW_UPDATE_STATEMENTS_NAMING_UPDATED_AT == 0;
  assert clock_measures_last_activity(UPDATED_AT_UPDATE_SITES) == false;
  assert clock_measures_last_activity(1) == true;
  assert clock_measures_row_age(UPDATED_AT_INSERT_SITES, UPDATED_AT_UPDATE_SITES) == true;
  assert clock_measures_row_age(1, 1) == false;
}

test the_first_rung_needs_a_zero_counter_a_line_and_more_than_ten_minutes {
  assert first_rung_due(0, 11, true, true) == true;
  assert first_rung_due(0, 10, true, true) == false;
  assert first_rung_due(1, 11, true, true) == false;
  assert first_rung_due(0, 11, false, true) == false;
  assert first_rung_due(0, 11, true, false) == false;
}

test the_second_rung_needs_a_counter_of_one_and_more_than_twenty_four_hours {
  assert second_rung_due(1, 25, true, true) == true;
  assert second_rung_due(1, 24, true, true) == false;
  assert second_rung_due(0, 25, true, true) == false;
  assert second_rung_due(2, 25, true, true) == false;
  assert second_rung_due(1, 25, false, true) == false;
  assert second_rung_due(1, 25, true, false) == false;
}

test abandonment_is_the_union_of_two_rungs_and_nothing_else {
  assert abandonment_inferred(0, 11, 0, true, true) == true;
  assert abandonment_inferred(1, 0, 25, true, true) == true;
  assert abandonment_inferred(2, 9999, 9999, true, true) == false;
  assert abandonment_inferred(0, 11, 25, false, true) == false;
  assert abandonment_inferred(0, 5, 5, true, true) == false;
}

test the_ladder_has_two_rungs_and_nothing_refills_it {
  assert ABANDON_LADDER_RUNGS == 2;
  assert REMINDER_COUNT_INCREMENT_SITES == 2;
  assert REMINDER_COUNT_RESET_SITES == 0;
  assert CART_ROW_DELETE_SITES == 0;
  assert ladder_can_refill(REMINDER_COUNT_RESET_SITES, CART_ROW_DELETE_SITES) == false;
  assert ladder_can_refill(1, 0) == true;
  assert ladder_can_refill(0, 1) == true;
  assert reminders_remaining(0) == 2;
  assert reminders_remaining(1) == 1;
  assert reminders_remaining(2) == 0;
  assert reminders_remaining(3) == 0;
}

test a_failed_send_consumes_its_rung_anyway {
  assert COUNTER_INCREMENTS_ON_SEND_FAILURE == true;
  assert rung_is_consumed(true, false) == true;
  assert rung_is_consumed(true, true) == true;
  assert rung_is_consumed(false, false) == false;
  assert reminder_is_retryable(REMINDER_ENQUEUES_A_ROW, COUNTER_INCREMENTS_ON_SEND_FAILURE) == false;
  assert reminder_is_retryable(true, true) == true;
  assert reminder_is_retryable(false, false) == true;
}

test clearing_a_cart_empties_it_without_restoring_its_reminders {
  assert CLEAR_DELETES_ITEMS == true;
  assert CLEAR_DELETES_THE_ROW == false;
  assert CLEAR_RESETS_THE_REMINDER_COUNT == false;
  assert cart_after_clear_can_be_reminded_again(true, false, 2) == false;
  assert cart_after_clear_can_be_reminded_again(true, false, 0) == true;
  assert cart_after_clear_can_be_reminded_again(true, false, 1) == true;
  assert cart_after_clear_can_be_reminded_again(false, false, 2) == true;
  assert cart_after_clear_can_be_reminded_again(true, true, 2) == true;
}

test the_thirty_day_horizon_is_written_and_never_read {
  assert EXPIRES_AT_WRITE_SITES == 1;
  assert EXPIRES_AT_READ_SITES == 0;
  assert column_has_a_reader(EXPIRES_AT_READ_SITES) == false;
  assert column_has_a_reader(EXPIRES_AT_WRITE_SITES) == true;
}

test the_table_admits_five_kinds_and_the_write_path_admits_four {
  assert DB_KIND_COUNT == 5;
  assert API_KIND_COUNT == 4;
  assert kind_is_storable("strain") == true;
  assert kind_is_storable("set") == true;
  assert kind_is_storable("accessory") == true;
  assert kind_is_storable("tea") == true;
  assert kind_is_storable(BIKE_KIND) == true;
  assert kind_is_storable("bike_sale") == false;
  assert kind_is_api_writable(BIKE_KIND) == false;
  assert kind_is_api_writable("tea") == true;
  assert kind_is_storable_but_unwritable(BIKE_KIND) == true;
  assert kind_is_storable_but_unwritable("tea") == false;
  assert kind_is_storable_but_unwritable("bike_sale") == false;
}

test neither_deal_kind_has_a_cart_write_path {
  assert COMMERCE_DEAL_KIND_COUNT == 2;
  assert DEAL_KINDS_WITH_A_CART_KIND == 1;
  assert DEAL_KINDS_WITH_A_CART_WRITE_PATH == 0;
  assert SALE_CART_KIND_EXISTS == false;
  assert deal_kind_reaches_the_cart(RENTAL_HAS_DB_KIND, RENTAL_HAS_API_KIND) == false;
  assert deal_kind_reaches_the_cart(SALE_HAS_DB_KIND, SALE_HAS_API_KIND) == false;
  assert deal_kind_reaches_the_cart(true, true) == true;
}

test every_writable_kind_is_retired_data_so_no_add_writes_a_row_today {
  assert add_to_cart_outcome(false, true, true) == OUTCOME_BAD_REQUEST;
  assert add_to_cart_outcome(true, false, false) == OUTCOME_LOOKUP_ERROR;
  assert add_to_cart_outcome(true, false, true) == OUTCOME_LOOKUP_ERROR;
  assert add_to_cart_outcome(true, true, false) == OUTCOME_UNRESOLVABLE;
  assert add_to_cart_outcome(true, true, true) == OUTCOME_ROW_WRITTEN;
  assert KINDS_THAT_CAN_WRITE_A_ROW_TODAY == 0;
  assert KINDS_REFUSED_AT_THE_GATE == 1;
  assert KINDS_REFUSED_BY_A_DROPPED_TABLE == 1;
  assert KINDS_REFUSED_BY_AN_INVISIBLE_ROW == 3;
}

test the_write_path_carries_three_refusal_numerals_and_no_success_numeral {
  assert cart_write_refusal_status(OUTCOME_BAD_REQUEST) == CART_WRITE_BAD_REQUEST;
  assert cart_write_refusal_status(OUTCOME_UNRESOLVABLE) == CART_WRITE_UNPROCESSABLE;
  assert cart_write_refusal_status(OUTCOME_LOOKUP_ERROR) == CART_WRITE_SERVER_ERROR;
  assert cart_write_refusal_status(OUTCOME_ROW_WRITTEN) == HTTP_STATUS_NOT_OWNED_HERE;
  assert HTTP_STATUS_NOT_OWNED_HERE == 0;
}

test a_dated_cart_line_is_unreachable_from_both_ends {
  assert UPSERT_COLUMN_COUNT == 10;
  assert UPSERT_WRITES_RENTAL_DATES == false;
  assert ENTITY_EXPOSES_RENTAL_DATES == false;
  assert RENTAL_DATE_WRITE_SITES_IN_THE_API == 0;
  assert RENTAL_DATE_READ_SITES_IN_THE_API == 0;
  assert dated_line_is_reachable(ENTITY_EXPOSES_RENTAL_DATES, UPSERT_WRITES_RENTAL_DATES) == false;
  assert dated_line_is_reachable(true, false) == false;
  assert dated_line_is_reachable(false, true) == false;
  assert dated_line_is_reachable(true, true) == true;
}

test the_reminder_never_enters_the_persisted_notification_queue {
  assert REMINDER_SEND_IS_DIRECT == true;
  assert REMINDER_ENQUEUES_A_ROW == false;
  assert ABANDON_BATCH_LIMIT == 100;
}

test the_sweep_interval_is_carried_as_a_marked_copy_and_not_as_a_decision {

; --- Invariants ---------------------------------------------------------------------------------------

invariant no_declared_cart_state_is_stored_in_a_column
  assert CARTS_STATUS_COLUMN_COUNT == 0 and STATES_WITH_A_COLUMN == 0

invariant the_locked_state_has_no_representation_at_all
  assert representation_mode(LOCKED_HAS_COLUMN, LOCKED_HAS_INFERENCE, LOCKED_HAS_ENACTMENT, LOCKED_ROW_PRESENCE_SUFFICES) == REPRESENTATION_NONE

invariant a_state_with_no_representation_binds_no_shipped_code
  assert representation_constrains_shipped_code(REPRESENTATION_NONE) == false

invariant an_inferred_state_is_never_authoritative
  assert representation_is_authoritative(REPRESENTATION_INFERRED) == false and representation_is_authoritative(REPRESENTATION_ENACTED) == false

invariant the_inactivity_threshold_cannot_read_activity_while_nothing_updates_the_column
  assert clock_measures_last_activity(UPDATED_AT_UPDATE_SITES) == false and clock_measures_row_age(UPDATED_AT_INSERT_SITES, UPDATED_AT_UPDATE_SITES) == true

invariant the_refused_edges_are_declared_and_the_corpus_count_is_the_review_one
  assert NOTIFICATION_QUEUE_EDGE_IS_DECLARED == true and RUNTIME_CONFIG_EDGE_IS_DECLARED == true and REUSES_NOTIFICATION_QUEUE_ID != ID and REUSES_RUNTIME_CONFIG_ID != ID and SPEC_IDS_UNDER_TURBOBABY_AT_REVIEW + SPEC_IDS_IN_AGENT_CARDS_AT_REVIEW == SPEC_IDS_READ_AT_REVIEW and SPEC_IDS_READ_AT_REVIEW > SPEC_IDS_HANDED_TO_THE_FIRST_PASS

invariant the_sweep_interval_stays_a_marked_copy_of_one_measured_literal
  assert ABANDON_SWEEP_INTERVAL_IS_A_MARKED_COPY == true and ABANDON_SWEEP_INTERVAL_SECONDS == 300 and ABANDON_SWEEP_INTERVAL_LITERAL_SITE == "src/main.rs:660"

invariant the_ladder_absence_is_measured_in_shipped_code_only
  assert CART_ROW_DELETE_SITES_ARE_COUNTED_IN_SRC_ONLY == true and ladder_can_refill(REMINDER_COUNT_RESET_SITES, CART_ROW_DELETE_SITES) == false

invariant a_cart_past_both_rungs_is_never_reminded_again
  assert reminders_remaining(ABANDON_LADDER_RUNGS) == 0 and ladder_can_refill(REMINDER_COUNT_RESET_SITES, CART_ROW_DELETE_SITES) == false

invariant clearing_a_cart_does_not_restore_its_ladder
  assert cart_after_clear_can_be_reminded_again(true, CLEAR_RESETS_THE_REMINDER_COUNT, ABANDON_LADDER_RUNGS) == false

invariant a_send_failure_still_consumes_its_rung
  assert rung_is_consumed(true, false) == true and reminder_is_retryable(REMINDER_ENQUEUES_A_ROW, COUNTER_INCREMENTS_ON_SEND_FAILURE) == false

invariant conversion_is_never_durable_while_the_client_owns_it
  assert conversion_is_durable(CONVERSION_IS_SERVER_ENFORCED, CONVERSION_ENACTMENT_RESULT_IS_CHECKED) == false

invariant the_bike_kind_is_storable_and_unwritable
  assert kind_is_storable_but_unwritable(BIKE_KIND) == true

invariant no_deal_kind_reaches_a_cart_row
  assert deal_kind_reaches_the_cart(RENTAL_HAS_DB_KIND, RENTAL_HAS_API_KIND) == false and deal_kind_reaches_the_cart(SALE_HAS_DB_KIND, SALE_HAS_API_KIND) == false

invariant a_dated_cart_line_is_unreachable_through_the_shipped_api
  assert dated_line_is_reachable(ENTITY_EXPOSES_RENTAL_DATES, UPSERT_WRITES_RENTAL_DATES) == false

invariant a_refused_write_always_carries_one_of_the_three_write_numerals
  assert cart_write_refusal_status(OUTCOME_BAD_REQUEST) == CART_WRITE_BAD_REQUEST and cart_write_refusal_status(OUTCOME_UNRESOLVABLE) == CART_WRITE_UNPROCESSABLE and cart_write_refusal_status(OUTCOME_LOOKUP_ERROR) == CART_WRITE_SERVER_ERROR

invariant this_contract_proposes_no_column_and_no_migration
  assert NO_COLUMN_IS_PROPOSED == true and NO_MIGRATION_NUMBER_IS_RESERVED == true and PROPOSED_COLUMNS_COUNT == 0 and PROPOSED_MIGRATIONS_COUNT == 0

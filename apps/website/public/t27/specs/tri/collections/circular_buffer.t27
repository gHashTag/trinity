// t27/specs/
// Free buffer | φ² + 1/φ² = 3 | TRINITY

module TriCircularBuffer;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const CircularBuffer = struct {
        data : []i64,
        head : usize,
        tail : usize,
        capacity : usize,
        allocator : std.mem.Allocator,
    };


# The Queen's model. Neither value is a secret: both are compiled into the
# public bundle, so a provider key must never appear here — a hosted model is
# reached through a proxy that holds the key on the server.

# The Queen herself: trios-agent-server, reached through queen-proxy, which
# holds the token. Nothing needs to be set for this — chatApi defaults to the
# proxy's public address — so an empty file asks her.
# VITE_QUEEN_CHAT_URL=https://queen-proxy-production-40b6.up.railway.app

# Local, free, no key: Ollama on this machine. Uncomment the model and the
# panel talks to it instead of her — useful with no network, and a different
# Queen: a 4B on a laptop, not the one the hive runs.
# Ollama also has to allow the browser's origin: OLLAMA_ORIGINS=http://localhost:4179
VITE_QUEEN_OLLAMA_URL=http://localhost:11434
# VITE_QUEEN_OLLAMA_MODEL=qwen3:4b

# Optional live control plane for the Skill and Cron Explorers. Not a secret:
# the URL is compiled into the public bundle. When set, the CONTROL strip on a
# skill or job card gets working buttons that POST to
#   {url}/crons/<id>/run | /enable | /disable   and   {url}/skills/<id>/run
# with the JSON body {"id", "requestedAt"} — see docs/agent-control-api.md.
# When unset (the default, and the deployed state today) the strip says so and
# every action goes through the spec and the hosts' own panels instead.
# VITE_AGENT_CONTROL_URL=https://example.invalid/agent-control

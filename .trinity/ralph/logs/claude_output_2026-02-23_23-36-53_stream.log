ize,\n   983→        .imports = &.{\n   984→            .{ .name = \"vsa\", .module = vsa_tri },\n   985→        },\n   986→    });\n   987→\n   988→    // IGLA Knowledge Graph module (self-contained VSA KG for chat routing)\n   989→    const igla_kg_mod = b.createModule(.{\n   990→        .root_source_file = b.path(\"src/vibeec/igla_knowledge_graph.zig\"),\n   991→        .target = target,\n   992→        .optimize = optimize,\n   993→    });\n   994→\n   995→    // LLM Triples Extractor module (SYM-002: pattern-based extraction) - defined early for fluent CLI\n   996→    const triples_parser_mod = b.createModule(.{\n   997→        .root_source_file = b.path(\"src/vibeec/triples_parser.zig\"),\n   998→        .target = target,\n   999→        .optimize = optimize,\n  1000→    });\n  1001→\n  1002→    // Fluent CLI - Local Chat with History Truncation (NO HANG!)\n  1003→    const fluent_cli = b.addExecutable(.{\n  1004→        .name = \"fluent\",\n  1005→        .root_module = b.createModule(.{\n  1006→            .root_source_file = b.path(\"src/vibeec/igla_fluent_cli.zig\"),\n  1007→            .target = target,\n  1008→            .optimize = optimize,\n  1009→            .imports = &.{\n  1010→                .{ .name = \"igla_chat\", .module = vibeec_chat },\n  1011→                .{ .name = \"tvc_corpus\", .module = tvc_corpus_mod },\n  1012→                .{ .name = \"igla_kg\", .module = igla_kg_mod },\n  1013→                .{ .name = \"triples_parser\", .module = triples_parser_mod },\n  1014→            },\n  1015→        }),\n  1016→    });\n  1017→    b.installArtifact(fluent_cli);\n  1018→\n  1019→    const run_fluent_cli = b.addRunArtifact(fluent_cli);\n  1020→    if (b.args) |args| {\n  1021→        run_fluent_cli.addArgs(args);\n  1022→    }\n  1023→    const fluent_cli_step = b.step(\"fluent\", \"Run Fluent CLI (Local Chat with History Truncation)\");\n  1024→    fluent_cli_step.dependOn(&run_fluent_cli.step);\n  1025→\n  1026→    // VIBEE Compi
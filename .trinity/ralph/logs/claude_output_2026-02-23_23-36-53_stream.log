rtifact(trinity_canvas);\n  1278→\n  1279→    const run_trinity_canvas = b.addRunArtifact(trinity_canvas);\n  1280→    if (b.args) |args| {\n  1281→        run_trinity_canvas.addArgs(args);\n  1282→    }\n  1283→    const trinity_canvas_step = b.step(\"trinity-canvas\", \"Run Trinity Cosmic Canvas (v1.9 Emergent Wave)\");\n  1284→    trinity_canvas_step.dependOn(&run_trinity_canvas.step);\n  1285→\n  1286→    // ═══════════════════════════════════════════════════════════════════════════\n  1287→    // Trinity Canvas WASM — compiles the same canvas for browsers via Emscripten\n  1288→    // Build: zig build trinity-canvas-wasm -Dtarget=wasm32-emscripten\n  1289→    // Output: zig-out/web/ (trinity-canvas.html, .js, .wasm, .data)\n  1290→    // ═══════════════════════════════════════════════════════════════════════════\n  1291→    {\n  1292→        // WASM stub modules (replace system-dependent chat/network/fs)\n  1293→        const wasm_igla_chat = b.createModule(.{\n  1294→            .root_source_file = b.path(\"src/wasm_stubs/igla_chat_stub.zig\"),\n  1295→            .target = target,\n  1296→            .optimize = optimize,\n  1297→        });\n  1298→        const wasm_fluent_chat = b.createModule(.{\n  1299→            .root_source_file = b.path(\"src/wasm_stubs/igla_fluent_chat_stub.zig\"),\n  1300→            .target = target,\n  1301→            .optimize = optimize,\n  1302→        });\n  1303→        const wasm_tvc_corpus = b.createModule(.{\n  1304→            .root_source_file = b.path(\"src/wasm_stubs/tvc_corpus_stub.zig\"),\n  1305→            .target = target,\n  1306→            .optimize = optimize,\n  1307→        });\n  1308→        const wasm_auto_shard = b.createModule(.{\n  1309→            .root_source_file = b.path(\"src/wasm_stubs/auto_shard_stub.zig\"),\n  1310→            .target = target,\n  1311→            .optimize = optimize,\n  1312→        });\n  1313→        const wasm_igla_kg = b.createModule(.{\n  1314→            .root_source_file = b.path(\"src/wasm_stubs/igla_knowledge_graph_stub.zig\"),\n  1315→            .target = target,\n  1316→            .optimize = optimize,\n  1317→        });\n  1318→        const wasm_hybrid_chat = b.createModule(.{\n  1319→            .root_source_file = b.path(\"src/wasm_stubs/igla_hybrid_chat_stub.zig\"),\n  1320→            .target = target,\n  1321→            .optimize = optimize,\n  1322→            .imports = &.{\n  1323→                .{ .name = \"igla_chat\", .module = wasm_igla_chat },\n  1324→                .{ .name = \"tvc_corpus\", .module = wasm_tvc_corpus },\n  1325→                .{ .name = \"igla_kg\", .module = wasm_igla_kg },\n  1326→                .{ .name = \"triples_parser\", .module = triples_parser_mod },\n  1327→            },\n  1328→        });\n  1329→        const wasm_golden_chain = b.createModule(.{\n  1330→            .root_source_file = b.path(\"src/wasm_stubs/golden_chain_stub.zig\"),\n  1331→            .target = target,\n  1332→            .optimize = optimize,\n  1333→            .imports = &.{\n  1334→                .{ .name = \"igla_hybrid_chat\", .module = wasm_hybrid_chat },\n  1335→            },\n  1336→        });\n  1337→\n  1338→        const wasm_root = b.createModule(.{\n  1339→            // ONE SOURCE OF TRUTH: same file as native build, with is_emscripten gates\n  1340→            .root_source_file = b.path(\"src/vsa/photon_trinity_canvas.zig\"),\n  1341→            .target = target,\n  1342→            .optimize = optimize,\n  1343→            .link_libc = true,\n  1344→            .imports = &.{\n  1345→                .{ .name = \"igla_chat\", .module = wasm_igla_chat },\n  1346→                .{ .name = \"igla_fluent_chat\", .module = wasm_fluent_chat },\n  1347→                .{ .name = \"igla_hybrid_chat\", .module = wasm_hybrid_chat },\n  1348→                .{ .name = \"golden_chain\", .module = wasm_golden_chain },\n  1349→                .{ .name = \"tvc_corpus\", .module = wasm_tvc_corpus },\n  1350→                .{ .name = \"auto_shard\", .module = wasm_auto_shard },\n  1351→            },\n  1352→        });\n  1353→\n  1354→        const wasm_step = b.step(\"trinity-canvas-wasm\", \"Build Trinity Canvas for Web (WASM via Emscripten)\");\n  1355→\n  1356→        if (target.query.os_tag == .emscripten) {\n  1357→            // ── Emscripten WASM build (raylib-zig emsdk helpers) ──\n  1358→            const raylib_zig = @import(\"raylib\");\n  1359→\n  1360→            // Get raylib C library compiled for emscripten\n  1361→            const raylib_dep = b.dependency(\"raylib\", .{\n  1362→                .target = target,\n  1363→                .optimize = optimize,\n  1364→            });\n  1365→            const raylib_artifact = raylib_dep.artifact(\"raylib\");\n  1366→\n  1367→            // Link raylib C library and add its include path for @cImport(\"raylib.h\")\n  1368→            wasm_root.linkLibrary(raylib_artifact);\n  1369→            wasm_root.addIncludePath(raylib_dep.path(\"src\"));\n  1370→\n  1371→            const wasm = b.addLibrary(.{\n  1372→                .name = \"trinity-canvas\",\n  1373→                .root_module = wasm_root,\n  1374→                .linkage = .static,\n  1375→            });\n  1376→\n  1377→            const install_dir: std.Build.InstallDir = .{ .custom = \"web\" };\n  1378→            const emcc_flags = raylib_zig.emsdk.emccDefaultFlags(b.allocator, .{\n  1379→                .optimize = optimize,\n  1380→                .asyncify = true,\n  1381→            });\n  1382→            var emcc_settings = raylib_zig.emsdk.emccDefaultSettings(b.allocator, .{\n  1383→                .optimize = optimize,\n  1384→            });\n  1385→            // Trinity Canvas needs ~256MB for grid + fonts + particles\n  1386→            emcc_settings.put(\"ALLOW_MEMORY_GROWTH\", \"1\") catch unreachable;\n  1387→            emcc_settings.put(\"INITIAL_MEMORY\", \"268435456\") catch unreachable; // 256MB\n  1388→\n  1389→            const emcc_link = raylib_zig.emsdk.emccStep(b, raylib_artifact, wasm, .{\n  1390→                .optimize = optimize,\n  1391→                .flags = emcc_flags,\n  1392→                .settings = emcc_settings,\n  1393→                .shell_file_path = b.path(\"src/wasm_stubs/shell.html\"),\n  1394→                .install_dir = install_dir,\n  1395→                .embed_paths = &.{.{ .src_path = b.pathFromRoot(\"assets/fonts\"), .virtual_path = \"assets/fonts\" }},\n  1396→            });\n  1397→\n  1398→            wasm_step.dependOn(emcc_link);\n  1399→        } else {\n  1400→            // ── Native build (for compilation check without emsdk) ──\n  1401→            const wasm_canvas = b.addExecutable(.{\n  1402→                .name = \"trinity-canvas-wasm-check\",\n  1403→                .root_module = wasm_root,\n  1404→            });\n  1405→            wasm_canvas.linkSystemLibrary(\"raylib\");\n  1406→            wasm_canvas.linkLibC();\n  1407→            b.installArtifact(wasm_canvas);\n  1408→            wasm_step.dependOn(b.getInstallStep());\n  1409→        }\n  1410→    }\n  1411→\n  1412→    // Photon Terminal v1.0 - TERNARY EMERGENT TUI\n  1413→    // Not a grid of cells — a living wave field in your terminal.\n  1414→    const photon_terminal = b.addExecutable(.{\n  1415→        .name = \"photon-terminal\",\n  1416→        .root_module = b.createModule(.{\n  1417→            .root_source_file = b.path(\"src/vsa/photon_terminal.zig\"),\n  1418→            .target = target,\n  1419→            .optimize = optimize,\n  1420→        }),\n  1421→    });\n  1422→    b.installArtifact(photon_terminal);\n  1423→\n  1424→    const run_photon_terminal = b.addRunArtifact(photon_terminal);\n  1425→    if (b.args) |args| {\n  1426→        run_photon_terminal.addArgs(args);\n  1427→    }\n  1428→    const photon_terminal_step = b.step(\"photon-terminal\", \"Run Photon Terminal (Emergent TUI v1.0)\");\n  1429→    photon_terminal_step
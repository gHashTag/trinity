→    const examples_step = b.step(\"examples\", \"Run all examples\");\n   282→    examples_step.dependOn(&run_memory.step);\n   283→    examples_step.dependOn(&run_sequence.step);\n   284→    examples_step.dependOn(&run_vm_example.step);\n   285→\n   286→    // SOTA Tech Report Demo (SYM-001)\n   287→    const sota_report = b.addExecutable(.{\n   288→        .name = \"sota-report\",\n   289→        .root_module = b.createModule(.{\n   290→            .root_source_file = b.path(\"src/sota_report_demo.zig\"),\n   291→            .target = target,\n   292→            .optimize = optimize,\n   293→            .imports = &.{.{ .name = \"trinity\", .module = trinity_mod }},\n   294→        }),\n   295→    });\n   296→    b.installArtifact(sota_report);\n   297→\n   298→    const run_sota = b.addRunArtifact(sota_report);\n   299→    const sota_step = b.step(\"sota-report\", \"Run SOTA Tech Report validation\");\n   300→    sota_step.dependOn(&run_sota.step);\n   301→\n   302→    // Firebird CLI\n   303→    const firebird = b.addExecutable(.{\n   304→        .name = \"firebird\",\n   305→        .root_module = b.createModule(.{\n   306→            .root_source_file = b.path(\"src/firebird/cli.zig\"),\n   307→            .target = target,\n   308→            .optimize = .ReleaseFast,\n   309→        }),\n   310→    });\n   311→    b.installArtifact(firebird);\n   312→\n   313→    const run_firebird = b.addRunArtifact(firebird);\n   314→    if (b.args) |args| {\n   315→        run_firebird.addArgs(args);\n   316→    }\n   317→    const firebird_step = b.step(\"firebird\", \"Run Firebird CLI\");\n   318→    firebird_step.dependOn(&run_firebird.step);\n   319→\n   320→    // Firebird tests\n   321→    const firebird_tests = b.addTest(.{\n   322→        .root_module = b.createModule(.{\n   323→            .root_source_file = b.path(\"src/firebird/b2t_integration.zig\"),\n   324→            .target = target,\n   325→            .optimize = optimize,\n   326→        }),\n   327→ 
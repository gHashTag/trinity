{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011NcymDdwBwXA7pgXJVTaTn","type":"tool_result","content":"   155→    var hslm = try HSLM.init(allocator);\n   156→    defer hslm.deinit();\n   157→\n   158→    var ds = try data.Dataset.init(allocator, 8);\n   159→    defer ds.deinit();\n   160→    try ds.addText(\"The quick brown fox jumps over the lazy dog many times today.\");\n   161→\n   162→    var ft = try FullTrainer.init(allocator, &hslm, &ds, TrainConfig{});\n   163→    defer ft.deinit();\n   164→\n   165→    var batch_data = try data.Batch.init(allocator, 1, 8);\n   166→    defer batch_data.deinit();\n   167→    ds.nextBatch(&batch_data);\n   168→\n   169→    const loss = ft.trainStep(batch_data.getInput(0), batch_data.getTarget(0));\n   170→    try std.testing.expect(!std.math.isNan(loss));\n   171→    try std.testing.expect(!std.math.isInf(loss));\n   172→    try std.testing.expect(loss > 0.0);\n   173→    try std.testing.expect(ft.metrics.step == 1);\n   174→}\n   175→\n   176→test \"hslm dual representation bridge\" {\n   177→    // Float → Trit → Float roundtrip\n   178→    const float_in = [_]f32{ 0.9, -0.8, 0.0, 0.3, -0.5, 1.0, -1.0, 0.1 };\n   179→    var trit: [8]i8 = undefined;\n   180→    var float_out: [8]f32 = undefined;\n   181→\n   182→    floatToTrit(&float_in, &trit);\n   183→    tritToFloat(&trit, &float_out);\n   184→\n   185→    // Trit values should be {-1, 0, +1}\n   186→    for (trit) |t| {\n   187→        try std.testing.expect(t >= -1 and t <= 1);\n   188→    }\n   189→\n   190→    // Float output should also be {-1.0, 0.0, +1.0}\n   191→    for (float_out) |v| {\n   192→        try std.testing.expect(v == -1.0 or v == 0.0 or v == 1.0);\n   193→    }\n   194→}\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44d2ecaa-b17e-43c0-bdaa-9bdb8e6b7a9a","uuid":"859f7d3e-7931-422a-964f-785103d736d1","tool_use_result":{"type":"text","file":{"filePath":"/Users/playra/trinity-w1/src/hslm/root.zig","content":"    var hslm = try HSLM.init(allocator);\n    defer hslm.deinit();\n\n    var ds = try data.Dataset.init(allocator, 8);\n    defer ds.deinit();\n    try ds.addText(\"The quick brown fox jumps over the lazy dog many times today.\");\n\n    var ft = try FullTrainer.init(allocator, &hslm, &ds, TrainConfig{});\n    defer ft.deinit();\n\n    var batch_data = try data.Batch.init(allocator, 1, 8);\n    defer batch_data.deinit();\n    ds.nextBatch(&batch_data);\n\n    const loss = ft.trainStep(batch_data.getInput(0), batch_data.getTarget(0));\n    try std.testing.expect(!std.math.isNan(loss));\n    try std.testing.expect(!std.math.isInf(loss));\n    try std.testing.expect(loss > 0.0);\n    try std.testing.expect(ft.metrics.step == 1);\n}\n\ntest \"hslm dual representation bridge\" {\n    // Float → Trit → Float roundtrip\n    const float_in = [_]f32{ 0.9, -0.8, 0.0, 0.3, -0.5, 1.0, -1.0, 0.1 };\n    var trit: [8]i8 = undefined;\n    var float_out: [8]f32 = undefined;\n\n    floatToTrit(&float_in, &trit);\n    tritToFloat(&trit, &float_out);\n\n    // Trit values should be {-1, 0, +1}\n    for (trit) |t| {\n        try std.testing.expect(t >= -1 and t <= 1);\n    }\n\n    // Float output should also be {-1.0, 0.0, +1.0}\n    for (float_out) |v| {\n        try std.testing.expect(v == -1.0 or v == 0.0 or v == 1.0);\n    }\n}","numLines":40,"startLine":155,"totalLines":195}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpVjFyySDLSg8gGaFHzTdV","type":"tool_result","content":"     1→// HSLM — Autograd Engine\n     2→// Compute graph with reverse-mode automatic differentiation\n     3→// STE (Straight-Through Estimator) for ternary quantization gradients\n     4→// Generated API from specs/tri/hslm_autograd.vibee\n     5→\n     6→const std = @import(\"std\");\n     7→const constants = @import(\"constants.zig\");\n     8→\n     9→const EMBED_DIM = constants.EMBED_DIM;\n    10→const HIDDEN_DIM = constants.HIDDEN_DIM;\n    11→const VOCAB_SIZE = constants.VOCAB_SIZE;\n    12→\n    13→// ═══════════════════════════════════════════════════════════════════════════════\n    14→// TENSOR\n    15→// ═══════════════════════════════════════════════════════════════════════════════\n    16→\n    17→pub const Tensor = struct {\n    18→    data: []f32,\n    19→    grad: []f32,\n    20→    rows: usize,\n    21→    cols: usize,\n    22→    requires_grad: bool,\n    23→    allocator: std.mem.Allocator,\n    24→\n    25→    const Self = @This();\n    26→\n    27→    pub fn init(allocator: std.mem.Allocator, rows: usize, cols: usize, requires_grad: bool) !Self {\n    28→        const total = rows * cols;\n    29→        const data = try allocator.alloc(f32, total);\n    30→        const grad = try allocator.alloc(f32, total);\n    31→        @memset(data, 0.0);\n    32→        @memset(grad, 0.0);\n    33→        return Self{\n    34→            .data = data,\n    35→            .grad = grad,\n    36→            .rows = rows,\n    37→            .cols = cols,\n    38→            .requires_grad = requires_grad,\n    39→            .allocator = allocator,\n    40→        };\n    41→    }\n    42→\n    43→    pub fn deinit(self: *Self) void {\n    44→        self.allocator.free(self.data);\n    45→        self.allocator.free(self.grad);\n    46→    }\n    47→\n    48→    pub fn size(self: *const Self) usize {\n    49→        return self.rows * self.cols;\n    50→    }\n    51→\n    52→    pub fn zeroGrad(self: *Self) void {\n    53→        @memset(self.grad, 0.0);\n    54→    }\n    55→\n    56→    pub fn get(self: *const Self, r: usize, c: usize) f32 {\n    57→        return self.data[r * self.cols + c];\n    58→    }\n    59→\n    60→    pub fn set(self: *Self, r: usize, c: usize, val: f32) void {\n    61→        self.data[r * self.cols + c] = val;\n    62→    }\n    63→\n    64→    pub fn fill(self: *Self, val: f32) void {\n    65→        @memset(self.data, val);\n    66→    }\n    67→\n    68→    pub fn copyFrom(self: *Self, src: []const f32) void {\n    69→        const n = @min(self.data.len, src.len);\n    70→        @memcpy(self.data[0..n], src[0..n]);\n    71→    }\n    72→};\n    73→\n    74→// ═══════════════════════════════════════════════════════════════════════════════\n    75→// OPERATIONS (Forward + Backward)\n    76→// ═══════════════════════════════════════════════════════════════════════════════\n    77→\n    78→/// y = x * W^T + b  (linear layer)\n    79→/// Forward: output[i,j] = sum_k(input[i,k] * weight[j,k]) + bias[j]\n    80→pub fn forwardLinear(\n    81→    input: *const Tensor, // [batch, in_dim]\n    82→    weight: *const Tensor, // [out_dim, in_dim]\n    83→    bias: *const Tensor, // [1, out_dim]\n    84→    output: *Tensor, // [batch, out_dim]\n    85→) void {\n    86→    const batch = input.rows;\n    87→    const in_dim = input.cols;\n    88→    const out_dim = weight.rows;\n    89→\n    90→    for (0..batch) |b| {\n    91→        for (0..out_dim) |j| {\n    92→            var sum: f32 = bias.data[j];\n    93→            for (0..in_dim) |k| {\n    94→                sum += input.data[b * in_dim + k] * weight.data[j * in_dim + k];\n    95→            }\n    96→            output.data[b * out_dim + j] = sum;\n    97→        }\n    98→    }\n    99→}\n   100→\n   101→/// Backward for linear: computes gradients for input, weight, and bias\n   102→pub fn backwardLinear(\n   103→    input: *const Tensor,\n   104→    weight: *const Tensor,\n   105→    bias: *Tensor,\n   106→    output: *const Tensor,\n   107→    input_grad: bool,\n   108→) void {\n   109→    const batch = input.rows;\n   110→    const in_dim = input.cols;\n   111→    const out_dim = weight.rows;\n   112→    const batch_f: f32 = @floatFromInt(batch);\n   113→\n   114→    // dL/dW += dL/dY * X^T\n   115→    if (weight.requires_grad) {\n   116→        for (0..out_dim) |j| {\n   117→            for (0..in_dim) |k| {\n   118→                var sum: f32 = 0.0;\n   119→                for (0..batch) |b| {\n   120→                    sum += output.grad[b * out_dim + j] * input.data[b * in_dim + k];\n   121→                }\n   122→                @constCast(weight).grad[j * in_dim + k] += sum / batch_f;\n   123→            }\n   124→        }\n   125→    }\n   126→\n   127→    // dL/db += sum_batch(dL/dY)\n   128→    if (bias.requires_grad) {\n   129→        for (0..out_dim) |j| {\n   130→            var sum: f32 = 0.0;\n   131→            for (0..batch) |b| {\n   132→                sum += output.grad[b * out_dim + j];\n   133→            }\n   134→            bias.grad[j] += sum / batch_f;\n   135→        }\n   136→    }\n   137→\n   138→    // dL/dX += dL/dY * W\n   139→    if (input_grad) {\n   140→        for (0..batch) |b| {\n   141→            for (0..in_dim) |k| {\n   142→                var sum: f32 = 0.0;\n   143→                for (0..out_dim) |j| {\n   144→                    sum += output.grad[b * out_dim + j] * weight.data[j * in_dim + k];\n   145→                }\n   146→                @constCast(input).grad[b * in_dim + k] += sum;\n   147→            }\n   148→        }\n   149→    }\n   150→}\n   151→\n   152→/// Forward ReLU: y = max(0, x)\n   153→pub fn forwardRelu(input: *const Tensor, output: *Tensor) void {\n   154→    for (0..input.data.len) |i| {\n   155→        output.data[i] = @max(0.0, input.data[i]);\n   156→    }\n   157→}\n   158→\n   159→/// Backward ReLU: dL/dx = dL/dy * (x > 0 ? 1 : 0)\n   160→pub fn backwardRelu(input: *const Tensor, output: *const Tensor) void {\n   161→    for (0..input.data.len) |i| {\n   162→        const mask: f32 = if (input.data[i] > 0.0) 1.0 else 0.0;\n   163→        @constCast(input).grad[i] += output.grad[i] * mask;\n   164→    }\n   165→}\n   166→\n   167→// ═══════════════════════════════════════════════════════════════════════════════\n   168→// CROSS-ENTROPY LOSS\n   169→// ═══════════════════════════════════════════════════════════════════════════════\n   170→\n   171→/// Forward cross-entropy: loss = -log(softmax(logits)[target])\n   172→/// Returns scalar loss value\n   173→pub fn forwardCrossEntropy(logits: *const Tensor, targets: []const u16) f32 {\n   174→    const batch = logits.rows;\n   175→    const vocab = logits.cols;\n   176→    var total_loss: f64 = 0.0;\n   177→\n   178→    for (0..batch) |b| {\n   179→        const row = logits.data[b * vocab .. (b + 1) * vocab];\n   180→        const target = targets[b];\n   181→\n   182→        // LogSumExp for numerical stability\n   183→        var max_val: f32 = row[0];\n   184→        for (row[1..]) |v| {\n   185→            if (v > max_val) max_val = v;\n   186→        }\n   187→\n   188→        var sum_exp: f64 = 0.0;\n   189→        for (row) |v| {\n   190→            sum_exp += @exp(@as(f64, v - max_val));\n   191→        }\n   192→\n   193→        const log_sum_exp = @as(f32, @floatCast(@log(sum_exp))) + max_val;\n   194→        const loss = log_sum_exp - row[@as(usize, target)];\n   195→        total_loss += loss;\n   196→    }\n   197→\n   198→    return @floatCast(total_loss / @as(f64, @floatFromInt(batch)));\n   199→}\n   200→\n   201→/// Backward cross-entropy: dL/d(logits) = softmax(logits) - one_hot(target)\n   202→pub fn backwardCrossEntropy(logits: *Tensor, targets: []const u16) void {\n   203→    const batch = logits.rows;\n   204→    const vocab = logits.cols;\n   205→    const batch_f: f32 = @floatFromInt(batch);\n   206→\n   207→    for (0..batch) |b| {\n   208→        const row = logits.data[b * vocab .. (b + 1) * vocab];\n   209→        const grad_row = logits.grad[b * vocab .. (b + 1) * vocab];\n   210→        const target = @as(usize, targets[b]);\n   211→\n   212→        // Compute softmax\n   213→        var max_val: f32 = row[0];\n   214→        for (row[1..]) |v| {\n   215→            if (v > max_val) max_val = v;\n   216→        }\n   217→\n   218→        var sum_exp: f64 = 0.0;\n   219→        for (row, 0..) |v, i| {\n   220→            const e: f32 = @floatCast(@exp(@as(f64, v - max_val)));\n   221→            grad_row[i] = e;\n   222→            sum_exp += e;\n   223→        }\n   224→\n   225→        const inv_sum: f32 = @floatCast(1.0 / sum_exp);\n   226→        for (0..vocab) |i| {\n   227→            grad_row[i] *= inv_sum; // Now softmax probabilities\n   228→            grad_row[i] -= if (i == target) @as(f32, 1.0) else @as(f32, 0.0);\n   229→            grad_row[i] /= batch_f; // Average over batch\n   230→        }\n   231→    }\n   232→}\n   233→\n   234→// ═══════════════════════════════════════════════════════════════════════════════\n   235→// STE — STRAIGHT-THROUGH ESTIMATOR\n   236→// ═══════════════════════════════════════════════════════════════════════════════\n   237→\n   238→/// Quantize float weights to ternary {-1, 0, +1} via AbsMean\n   239→/// Forward: w_q = RoundClip(w / (mean|w| + eps))\n   240→/// Backward (STE): dL/dw = dL/dw_q (pass gradient straight through)\n   241→pub fn steQuantize(float_weights: []const f32, ternary_out: []i8) f32 {\n   242→    var sum: f64 = 0.0;\n   243→    for (float_weights) |w| {\n   244→        sum += @abs(@as(f64, w));\n   245→    }\n   246→    const mean_abs = sum / @as(f64, @floatFromInt(float_weights.len));\n   247→    const scale: f32 = if (mean_abs > 1e-6) @floatCast(mean_abs) else 1.0;\n   248→\n   249→    for (float_weights, 0..) |w, i| {\n   250→        if (i >= ternary_out.len) break;\n   251→        const scaled = w / scale;\n   252→        if (scaled > 0.5) {\n   253→            ternary_out[i] = 1;\n   254→        } else if (scaled < -0.5) {\n   255→            ternary_out[i] = -1;\n   256→        } else {\n   257→            ternary_out[i] = 0;\n   258→        }\n   259→    }\n   260→\n   261→    return scale;\n   262→}\n   263→\n   264→/// STE backward: gradient passes through quantization unchanged\n   265→/// But clips gradient for weights that are far from quantization boundary\n   266→pub fn steBackward(float_weights: []const f32, grad_out: []f32, scale: f32) void {\n   267→    for (float_weights, 0..) |w, i| {\n   268→        if (i >= grad_out.len) break;\n   269→        const scaled = @abs(w / scale);\n   270→        // Clip gradients for weights far from boundaries\n   271→        if (scaled > 1.5) {\n   272→            grad_out[i] *= 0.1; // Attenuate for saturated weights\n   273→        }\n   274→        // Within [-1.5, 1.5] × scale: full gradient passthrough (STE)\n   275→    }\n   276→}\n   277→\n   278→// ═══════════════════════════════════════════════════════════════════════════════\n   279→// ADAMW OPTIMIZER\n   280→// ═══════════════════════════════════════════════════════════════════════════════\n   281→\n   282→pub const AdamW = struct {\n   283→    m: []f32, // First moment\n   284→    v: []f32, // Second moment\n   285→    t: u32, // Timestep\n   286→    lr: f32,\n   287→    beta1: f32,\n   288→    beta2: f32,\n   289→    epsilon: f32,\n   290→    weight_decay: f32,\n   291→    allocator: std.mem.Allocator,\n   292→\n   293→    const Self = @This();\n   294→\n   295→    pub fn init(allocator: std.mem.Allocator, num_params: usize, lr: f32) !Self {\n   296→        const m = try allocator.alloc(f32, num_params);\n   297→        const v = try allocator.alloc(f32, num_params);\n   298→        @memset(m, 0.0);\n   299→        @memset(v, 0.0);\n   300→        return Self{\n   301→            .m = m,\n   302→            .v = v,\n   303→            .t = 0,\n   304→            .lr = lr,\n   305→            .beta1 = constants.ADAM_BETA1,\n   306→            .beta2 = constants.ADAM_BETA2,\n   307→            .epsilon = constants.ADAM_EPSILON,\n   308→            .weight_decay = constants.WEIGHT_DECAY,\n   309→            .allocator = allocator,\n   310→        };\n   311→    }\n   312→\n   313→    pub fn deinit(self: *Self) void {\n   314→        self.allocator.free(self.m);\n   315→        self.allocator.free(self.v);\n   316→    }\n   317→\n   318→    /// One optimization step: update params using gradients\n   319→    pub fn step(self: *Self, params: []f32, grads: []const f32) void {\n   320→        self.t += 1;\n   321→        const t_f: f32 = @floatFromInt(self.t);\n   322→        const bias_correction1 = 1.0 - std.math.pow(f32, self.beta1, t_f);\n   323→        const bias_correction2 = 1.0 - std.math.pow(f32, self.beta2, t_f);\n   324→\n   325→        const n = @min(@min(params.len, grads.len), self.m.len);\n   326→        for (0..n) |i| {\n   327→            const g = grads[i];\n   328→\n   329→            // Update moments\n   330→            self.m[i] = self.beta1 * self.m[i] + (1.0 - self.beta1) * g;\n   331→            self.v[i] = self.beta2 * self.v[i] + (1.0 - self.beta2) * g * g;\n   332→\n   333→            // Bias-corrected moments\n   334→            const m_hat = self.m[i] / bias_correction1;\n   335→            const v_hat = self.v[i] / bias_correction2;\n   336→\n   337→            // AdamW update: param -= lr * (m_hat / (sqrt(v_hat) + eps) + wd * param)\n   338→            params[i] -= self.lr * (m_hat / (@sqrt(v_hat) + self.epsilon) + self.weight_decay * params[i]);\n   339→        }\n   340→    }\n   341→\n   342→    /// Apply gradient clipping before step\n   343→    pub fn stepWithClip(self: *Self, params: []f32, grads: []f32, max_norm: f32) void {\n   344→        clipGradNorm(grads, max_norm);\n   345→        self.step(params, grads);\n   346→    }\n   347→};\n   348→\n   349→/// RMS normalization backward\n   350→/// Given: grad_output (∂L/∂normalized), normalized (x/rms), rms_scale\n   351→/// Compute: grad_input (∂L/∂x)\n   352→/// ∂L/∂x_i = (1/rms) * (∂L/∂y_i - y_i * mean(∂L/∂y * y))\n   353→pub fn rmsNormBackward(grad_output: []const f32, normalized: []const f32, rms_scale: f32, grad_input: []f32) void {\n   354→    const d = grad_output.len;\n   355→    // Compute dot product: sum(grad_output * normalized) / d\n   356→    var dot: f64 = 0.0;\n   357→    for (0..d) |i| {\n   358→        dot += @as(f64, grad_output[i]) * @as(f64, normalized[i]);\n   359→    }\n   360→    const mean_dot: f32 = @floatCast(dot / @as(f64, @floatFromInt(d)));\n   361→    const inv_rms = 1.0 / rms_scale;\n   362→    for (0..d) |i| {\n   363→        grad_input[i] = inv_rms * (grad_output[i] - normalized[i] * mean_dot);\n   364→    }\n   365→}\n   366→\n   367→/// AdamW step for a slice of parameters (for per-layer stepping)\n   368→pub fn adamwStepSlice(\n   369→    opt: *AdamW,\n   370→    params: []f32,\n   371→    grads: []const f32,\n   372→    offset: usize,\n   373→) void {\n   374→    // Use the optimizer's current t (must call beginStep first)\n   375→    const t_f: f32 = @floatFromInt(opt.t);\n   376→    const bias_correction1 = 1.0 - std.math.pow(f32, opt.beta1, t_f);\n   377→    const bias_correction2 = 1.0 - std.math.pow(f32, opt.beta2, t_f);\n   378→\n   379→    const n = @min(params.len, grads.len);\n   380→    for (0..n) |i| {\n   381→        const mi = offset + i;\n   382→        if (mi >= opt.m.len) break;\n   383→        const g = grads[i];\n   384→        opt.m[mi] = opt.beta1 * opt.m[mi] + (1.0 - opt.beta1) * g;\n   385→        opt.v[mi] = opt.beta2 * opt.v[mi] + (1.0 - opt.beta2) * g * g;\n   386→        const m_hat = opt.m[mi] / bias_correction1;\n   387→        const v_hat = opt.v[mi] / bias_correction2;\n   388→        params[i] -= opt.lr * (m_hat / (@sqrt(v_hat) + opt.epsilon) + opt.weight_decay * params[i]);\n   389→    }\n   390→}\n   391→\n   392→/// Gradient clipping by global norm\n   393→pub fn clipGradNorm(grads: []f32, max_norm: f32) void {\n   394→    var norm_sq: f64 = 0.0;\n   395→    for (grads) |g| {\n   396→        norm_sq += @as(f64, g) * @as(f64, g);\n   397→    }\n   398→    const norm: f32 = @floatCast(@sqrt(norm_sq));\n   399→    if (norm > max_norm) {\n   400→        const scale = max_norm / norm;\n   401→        for (grads) |*g| {\n   402→            g.* *= scale;\n   403→        }\n   404→    }\n   405→}\n   406→\n   407→// ═══════════════════════════════════════════════════════════════════════════════\n   408→// LEARNING RATE SCHEDULE\n   409→// ═══════════════════════════════════════════════════════════════════════════════\n   410→\n   411→/// Linear warmup then cosine decay\n   412→pub fn lrSchedule(step: u32, warmup_steps: u32, total_steps: u32, base_lr: f32) f32 {\n   413→    if (step < warmup_steps) {\n   414→        // Linear warmup\n   415→        return base_lr * @as(f32, @floatFromInt(step)) / @as(f32, @floatFromInt(warmup_steps));\n   416→    }\n   417→\n   418→    // Cosine decay\n   419→    const progress = @as(f32, @floatFromInt(step - warmup_steps)) / @as(f32, @floatFromInt(total_steps - warmup_steps));\n   420→    const cosine = (1.0 + @cos(std.math.pi * progress)) / 2.0;\n   421→    return base_lr * 0.1 + (base_lr - base_lr * 0.1) * cosine; // Decay to 10% of base\n   422→}\n   423→\n   424→// ═══════════════════════════════════════════════════════════════════════════════\n   425→// TESTS\n   426→// ═══════════════════════════════════════════════════════════════════════════════\n   427→\n   428→test \"tensor init/deinit\" {\n   429→    const allocator = std.testing.allocator;\n   430→    var t = try Tensor.init(allocator, 3, 4, true);\n   431→    defer t.deinit();\n   432→\n   433→    try std.testing.expect(t.size() == 12);\n   434→    try std.testing.expect(t.requires_grad);\n   435→    try std.testing.expect(t.data[0] == 0.0);\n   436→    try std.testing.expect(t.grad[0] == 0.0);\n   437→}\n   438→\n   439→test \"forward linear\" {\n   440→    const allocator = std.testing.allocator;\n   441→\n   442→    // Input: 1×3\n   443→    var input = try Tensor.init(allocator, 1, 3, false);\n   444→    defer input.deinit();\n   445→    input.data[0] = 1.0;\n   446→    input.data[1] = 2.0;\n   447→    input.data[2] = 3.0;\n   448→\n   449→    // Weight: 2×3 (out_dim=2, in_dim=3)\n   450→    var weight = try Tensor.init(allocator, 2, 3, true);\n   451→    defer weight.deinit();\n   452→    // W = [[1, 0, -1], [0, 1, 0]]\n   453→    weight.data[0] = 1.0;\n   454→    weight.data[1] = 0.0;\n   455→    weight.data[2] = -1.0;\n   456→    weight.data[3] = 0.0;\n   457→    weight.data[4] = 1.0;\n   458→    weight.data[5] = 0.0;\n   459→\n   460→    // Bias: 1×2\n   461→    var bias = try Tensor.init(allocator, 1, 2, true);\n   462→    defer bias.deinit();\n   463→    bias.data[0] = 0.5;\n   464→    bias.data[1] = -0.5;\n   465→\n   466→    // Output: 1×2\n   467→    var output = try Tensor.init(allocator, 1, 2, false);\n   468→    defer output.deinit();\n   469→\n   470→    forwardLinear(&input, &weight, &bias, &output);\n   471→\n   472→    // y[0] = 1*1 + 2*0 + 3*(-1) + 0.5 = -1.5\n   473→    // y[1] = 1*0 + 2*1 + 3*0 + (-0.5) = 1.5\n   474→    try std.testing.expectApproxEqAbs(-1.5, output.data[0], 1e-5);\n   475→    try std.testing.expectApproxEqAbs(1.5, output.data[1], 1e-5);\n   476→}\n   477→\n   478→test \"forward relu\" {\n   479→    const allocator = std.testing.allocator;\n   480→    var input = try Tensor.init(allocator, 1, 4, false);\n   481→    defer input.deinit();\n   482→    input.data[0] = -1.0;\n   483→    input.data[1] = 0.0;\n   484→    input.data[2] = 0.5;\n   485→    input.data[3] = 2.0;\n   486→\n   487→    var output = try Tensor.init(allocator, 1, 4, false);\n   488→    defer output.deinit();\n   489→\n   490→    forwardRelu(&input, &output);\n   491→\n   492→    try std.testing.expectApproxEqAbs(0.0, output.data[0], 1e-5);\n   493→    try std.testing.expectApproxEqAbs(0.0, output.data[1], 1e-5);\n   494→    try std.testing.expectApproxEqAbs(0.5, output.data[2], 1e-5);\n   495→    try std.testing.expectApproxEqAbs(2.0, output.data[3], 1e-5);\n   496→}\n   497→\n   498→test \"cross entropy loss uniform\" {\n   499→    const allocator = std.testing.allocator;\n   500→    // Uniform logits → loss ≈ log(VOCAB_SIZE)\n   501→    var logits = try Tensor.init(allocator, 1, VOCAB_SIZE, false);\n   502→    defer logits.deinit();\n   503→    logits.fill(0.0);\n   504→\n   505→    const targets = [_]u16{42};\n   506→    const loss = forwardCrossEntropy(&logits, &targets);\n   507→    const expected = @log(@as(f32, @floatFromInt(VOCAB_SIZE)));\n   508→    try std.testing.expectApproxEqAbs(expected, loss, 0.01);\n   509→}\n   510→\n   511→test \"cross entropy loss correct prediction low\" {\n   512→    const allocator = std.testing.allocator;\n   513→    var logits = try Tensor.init(allocator, 1, VOCAB_SIZE, false);\n   514→    defer logits.deinit();\n   515→    logits.fill(0.0);\n   516→    logits.data[42] = 10.0; // High confidence on correct class\n   517→\n   518→    const targets = [_]u16{42};\n   519→    const loss = forwardCrossEntropy(&logits, &targets);\n   520→    try std.testing.expect(loss < 1.0); // Should be low\n   521→}\n   522→\n   523→test \"cross entropy backward sums near zero\" {\n   524→    const allocator = std.testing.allocator;\n   525→    var logits = try Tensor.init(allocator, 1, 10, false);\n   526→    defer logits.deinit();\n   527→    for (0..10) |i| {\n   528→        logits.data[i] = @as(f32, @floatFromInt(i)) * 0.5;\n   529→    }\n   530→\n   531→    const targets = [_]u16{5};\n   532→    backwardCrossEntropy(&logits, &targets);\n   533→\n   534→    // Gradient should sum to ~0 (softmax - one_hot)\n   535→    var sum: f64 = 0.0;\n   536→    for (0..10) |i| {\n   537→        sum += logits.grad[i];\n   538→    }\n   539→    try std.testing.expectApproxEqAbs(0.0, @as(f32, @floatCast(sum)), 1e-5);\n   540→}\n   541→\n   542→test \"ste quantize\" {\n   543→    const floats = [_]f32{ 0.8, -0.9, 0.1, 0.0, -0.3, 1.0, -1.0, 0.5 };\n   544→    var ternary: [8]i8 = undefined;\n   545→    const scale = steQuantize(&floats, &ternary);\n   546→\n   547→    try std.testing.expect(scale > 0.0);\n   548→    for (ternary) |t| {\n   549→        try std.testing.expect(t >= -1 and t <= 1);\n   550→    }\n   551→}\n   552→\n   553→test \"adamw step\" {\n   554→    const allocator = std.testing.allocator;\n   555→    var opt = try AdamW.init(allocator, 4, 0.001);\n   556→    defer opt.deinit();\n   557→\n   558→    var params = [_]f32{ 1.0, -1.0, 0.5, -0.5 };\n   559→    const grads = [_]f32{ 0.1, -0.1, 0.05, -0.05 };\n   560→\n   561→    const original_0 = params[0];\n   562→    opt.step(&params, &grads);\n   563→\n   564→    // Params should have changed\n   565→    try std.testing.expect(params[0] != original_0);\n   566→    try std.testing.expect(opt.t == 1);\n   567→}\n   568→\n   569→test \"gradient clipping\" {\n   570→    var grads = [_]f32{ 3.0, 4.0 }; // norm = 5\n   571→    clipGradNorm(&grads, 1.0);\n   572→\n   573→    // After clipping, norm should be <= 1.0\n   574→    const norm = @sqrt(grads[0] * grads[0] + grads[1] * grads[1]);\n   575→    try std.testing.expectApproxEqAbs(1.0, norm, 1e-5);\n   576→}\n   577→\n   578→test \"lr schedule warmup and decay\" {\n   579→    const base_lr: f32 = 3e-4;\n   580→\n   581→    // Step 0: lr should be 0\n   582→    try std.testing.expectApproxEqAbs(0.0, lrSchedule(0, 1000, 50000, base_lr), 1e-7);\n   583→\n   584→    // Step 500 (mid warmup): lr should be half base\n   585→    try std.testing.expectApproxEqAbs(base_lr * 0.5, lrSchedule(500, 1000, 50000, base_lr), 1e-7);\n   586→\n   587→    // Step 1000 (end warmup): lr should be base\n   588→    try std.testing.expectApproxEqAbs(base_lr, lrSchedule(1000, 1000, 50000, base_lr), 1e-6);\n   589→\n   590→    // Step 50000 (end): lr should be 10% of base\n   591→    const end_lr = lrSchedule(50000, 1000, 50000, base_lr);\n   592→    try std.testing.expect(end_lr < base_lr * 0.2);\n   593→    try std.testing.expect(end_lr > 0.0);\n   594→}\n   595→\n   596→test \"backward linear gradient flow\" {\n   597→    const allocator = std.testing.allocator;\n   598→\n   599→    var input = try Tensor.init(allocator, 1, 2, true);\n   600→    defer input.deinit();\n   601→    input.data[0] = 1.0;\n   602→    input.data[1] = 2.0;\n   603→\n   604→    var weight = try Tensor.init(allocator, 2, 2, true);\n   605→    defer weight.deinit();\n   606→    weight.data[0] = 1.0;\n   607→    weight.data[1] = 0.0;\n   608→    weight.data[2] = 0.0;\n   609→    weight.data[3] = 1.0;\n   610→\n   611→    var bias = try Tensor.init(allocator, 1, 2, true);\n   612→    defer bias.deinit();\n   613→\n   614→    var output = try Tensor.init(allocator, 1, 2, false);\n   615→    defer output.deinit();\n   616→\n   617→    forwardLinear(&input, &weight, &bias, &output);\n   618→\n   619→    // Set output gradient (as if loss told us)\n   620→    output.grad[0] = 1.0;\n   621→    output.grad[1] = 1.0;\n   622→\n   623→    backwardLinear(&input, &weight, &bias, &output, true);\n   624→\n   625→    // Weight grads should be non-zero\n   626→    var any_nonzero = false;\n   627→    for (weight.grad) |g| {\n   628→        if (g != 0.0) {\n   629→            any_nonzero = true;\n   630→            break;\n   631→        }\n   632→    }\n   633→    try std.testing.expect(any_nonzero);\n   634→\n   635→    // Input grads should be non-zero (gradient flows back)\n   636→    any_nonzero = false;\n   637→    for (input.grad) |g| {\n   638→        if (g != 0.0) {\n   639→            any_nonzero = true;\n   640→            break;\n   641→        }\n   642→    }\n   643→    try std.testing.expect(any_nonzero);\n   644→}\n   645→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44d2ecaa-b17e-43c0-bdaa-9bdb8e6b7a9a","uuid":"5ea94214-8a74-4ecd-b7cc-b62c0f0fab60","tool_use_result":{"type":"text","file":{"filePath":"/Users/playra/trinity-w1/src/hslm/autograd.zig","content":"// HSLM — Autograd Engine\n// Compute graph with reverse-mode automatic differentiation\n// STE (Straight-Through Estimator) for ternary quantization gradients\n// Generated API from specs/tri/hslm_autograd.vibee\n\nconst std = @import(\"std\");\nconst constants = @import(\"constants.zig\");\n\nconst EMBED_DIM = constants.EMBED_DIM;\nconst HIDDEN_DIM = constants.HIDDEN_DIM;\nconst VOCAB_SIZE = constants.VOCAB_SIZE;\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TENSOR\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const Tensor = struct {\n    data: []f32,\n    grad: []f32,\n    rows: usize,\n    cols: usize,\n    requires_grad: bool,\n    allocator: std.mem.Allocator,\n\n    const Self = @This();\n\n    pub fn init(allocator: std.mem.Allocator, rows: usize, cols: usize, requires_grad: bool) !Self {\n        const total = rows * cols;\n        const data = try allocator.alloc(f32, total);\n        const grad = try allocator.alloc(f32, total);\n        @memset(data, 0.0);\n        @memset(grad, 0.0);\n        return Self{\n            .data = data,\n            .grad = grad,\n            .rows = rows,\n            .cols = cols,\n            .requires_grad = requires_grad,\n            .allocator = allocator,\n        };\n    }\n\n    pub fn deinit(self: *Self) void {\n        self.allocator.free(self.data);\n        self.allocator.free(self.grad);\n    }\n\n    pub fn size(self: *const Self) usize {\n        return self.rows * self.cols;\n    }\n\n    pub fn zeroGrad(self: *Self) void {\n        @memset(self.grad, 0.0);\n    }\n\n    pub fn get(self: *const Self, r: usize, c: usize) f32 {\n        return self.data[r * self.cols + c];\n    }\n\n    pub fn set(self: *Self, r: usize, c: usize, val: f32) void {\n        self.data[r * self.cols + c] = val;\n    }\n\n    pub fn fill(self: *Self, val: f32) void {\n        @memset(self.data, val);\n    }\n\n    pub fn copyFrom(self: *Self, src: []const f32) void {\n        const n = @min(self.data.len, src.len);\n        @memcpy(self.data[0..n], src[0..n]);\n    }\n};\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// OPERATIONS (Forward + Backward)\n// ═══════════════════════════════════════════════════════════════════════════════\n\n/// y = x * W^T + b  (linear layer)\n/// Forward: output[i,j] = sum_k(input[i,k] * weight[j,k]) + bias[j]\npub fn forwardLinear(\n    input: *const Tensor, // [batch, in_dim]\n    weight: *const Tensor, // [out_dim, in_dim]\n    bias: *const Tensor, // [1, out_dim]\n    output: *Tensor, // [batch, out_dim]\n) void {\n    const batch = input.rows;\n    const in_dim = input.cols;\n    const out_dim = weight.rows;\n\n    for (0..batch) |b| {\n        for (0..out_dim) |j| {\n            var sum: f32 = bias.data[j];\n            for (0..in_dim) |k| {\n                sum += input.data[b * in_dim + k] * weight.data[j * in_dim + k];\n            }\n            output.data[b * out_dim + j] = sum;\n        }\n    }\n}\n\n/// Backward for linear: computes gradients for input, weight, and bias\npub fn backwardLinear(\n    input: *const Tensor,\n    weight: *const Tensor,\n    bias: *Tensor,\n    output: *const Tensor,\n    input_grad: bool,\n) void {\n    const batch = input.rows;\n    const in_dim = input.cols;\n    const out_dim = weight.rows;\n    const batch_f: f32 = @floatFromInt(batch);\n\n    // dL/dW += dL/dY * X^T\n    if (weight.requires_grad) {\n        for (0..out_dim) |j| {\n            for (0..in_dim) |k| {\n                var sum: f32 = 0.0;\n                for (0..batch) |b| {\n                    sum += output.grad[b * out_dim + j] * input.data[b * in_dim + k];\n                }\n                @constCast(weight).grad[j * in_dim + k] += sum / batch_f;\n            }\n        }\n    }\n\n    // dL/db += sum_batch(dL/dY)\n    if (bias.requires_grad) {\n        for (0..out_dim) |j| {\n            var sum: f32 = 0.0;\n            for (0..batch) |b| {\n                sum += output.grad[b * out_dim + j];\n            }\n            bias.grad[j] += sum / batch_f;\n        }\n    }\n\n    // dL/dX += dL/dY * W\n    if (input_grad) {\n        for (0..batch) |b| {\n            for (0..in_dim) |k| {\n                var sum: f32 = 0.0;\n                for (0..out_dim) |j| {\n                    sum += output.grad[b * out_dim + j] * weight.data[j * in_dim + k];\n                }\n                @constCast(input).grad[b * in_dim + k] += sum;\n            }\n        }\n    }\n}\n\n/// Forward ReLU: y = max(0, x)\npub fn forwardRelu(input: *const Tensor, output: *Tensor) void {\n    for (0..input.data.len) |i| {\n        output.data[i] = @max(0.0, input.data[i]);\n    }\n}\n\n/// Backward ReLU: dL/dx = dL/dy * (x > 0 ? 1 : 0)\npub fn backwardRelu(input: *const Tensor, output: *const Tensor) void {\n    for (0..input.data.len) |i| {\n        const mask: f32 = if (input.data[i] > 0.0) 1.0 else 0.0;\n        @constCast(input).grad[i] += output.grad[i] * mask;\n    }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// CROSS-ENTROPY LOSS\n// ═══════════════════════════════════════════════════════════════════════════════\n\n/// Forward cross-entropy: loss = -log(softmax(logits)[target])\n/// Returns scalar loss value\npub fn forwardCrossEntropy(logits: *const Tensor, targets: []const u16) f32 {\n    const batch = logits.rows;\n    const vocab = logits.cols;\n    var total_loss: f64 = 0.0;\n\n    for (0..batch) |b| {\n        const row = logits.data[b * vocab .. (b + 1) * vocab];\n        const target = targets[b];\n\n        // LogSumExp for numerical stability\n        var max_val: f32 = row[0];\n        for (row[1..]) |v| {\n            if (v > max_val) max_val = v;\n        }\n\n        var sum_exp: f64 = 0.0;\n        for (row) |v| {\n            sum_exp += @exp(@as(f64, v - max_val));\n        }\n\n        const log_sum_exp = @as(f32, @floatCast(@log(sum_exp))) + max_val;\n        const loss = log_sum_exp - row[@as(usize, target)];\n        total_loss += loss;\n    }\n\n    return @floatCast(total_loss / @as(f64, @floatFromInt(batch)));\n}\n\n/// Backward cross-entropy: dL/d(logits) = softmax(logits) - one_hot(target)\npub fn backwardCrossEntropy(logits: *Tensor, targets: []const u16) void {\n    const batch = logits.rows;\n    const vocab = logits.cols;\n    const batch_f: f32 = @floatFromInt(batch);\n\n    for (0..batch) |b| {\n        const row = logits.data[b * vocab .. (b + 1) * vocab];\n        const grad_row = logits.grad[b * vocab .. (b + 1) * vocab];\n        const target = @as(usize, targets[b]);\n\n        // Compute softmax\n        var max_val: f32 = row[0];\n        for (row[1..]) |v| {\n            if (v > max_val) max_val = v;\n        }\n\n        var sum_exp: f64 = 0.0;\n        for (row, 0..) |v, i| {\n            const e: f32 = @floatCast(@exp(@as(f64, v - max_val)));\n            grad_row[i] = e;\n            sum_exp += e;\n        }\n\n        const inv_sum: f32 = @floatCast(1.0 / sum_exp);\n        for (0..vocab) |i| {\n            grad_row[i] *= inv_sum; // Now softmax probabilities\n            grad_row[i] -= if (i == target) @as(f32, 1.0) else @as(f32, 0.0);\n            grad_row[i] /= batch_f; // Average over batch\n        }\n    }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// STE — STRAIGHT-THROUGH ESTIMATOR\n// ═══════════════════════════════════════════════════════════════════════════════\n\n/// Quantize float weights to ternary {-1, 0, +1} via AbsMean\n/// Forward: w_q = RoundClip(w / (mean|w| + eps))\n/// Backward (STE): dL/dw = dL/dw_q (pass gradient straight through)\npub fn steQuantize(float_weights: []const f32, ternary_out: []i8) f32 {\n    var sum: f64 = 0.0;\n    for (float_weights) |w| {\n        sum += @abs(@as(f64, w));\n    }\n    const mean_abs = sum / @as(f64, @floatFromInt(float_weights.len));\n    const scale: f32 = if (mean_abs > 1e-6) @floatCast(mean_abs) else 1.0;\n\n    for (float_weights, 0..) |w, i| {\n        if (i >= ternary_out.len) break;\n        const scaled = w / scale;\n        if (scaled > 0.5) {\n            ternary_out[i] = 1;\n        } else if (scaled < -0.5) {\n            ternary_out[i] = -1;\n        } else {\n            ternary_out[i] = 0;\n        }\n    }\n\n    return scale;\n}\n\n/// STE backward: gradient passes through quantization unchanged\n/// But clips gradient for weights that are far from quantization boundary\npub fn steBackward(float_weights: []const f32, grad_out: []f32, scale: f32) void {\n    for (float_weights, 0..) |w, i| {\n        if (i >= grad_out.len) break;\n        const scaled = @abs(w / scale);\n        // Clip gradients for weights far from boundaries\n        if (scaled > 1.5) {\n            grad_out[i] *= 0.1; // Attenuate for saturated weights\n        }\n        // Within [-1.5, 1.5] × scale: full gradient passthrough (STE)\n    }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// ADAMW OPTIMIZER\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const AdamW = struct {\n    m: []f32, // First moment\n    v: []f32, // Second moment\n    t: u32, // Timestep\n    lr: f32,\n    beta1: f32,\n    beta2: f32,\n    epsilon: f32,\n    weight_decay: f32,\n    allocator: std.mem.Allocator,\n\n    const Self = @This();\n\n    pub fn init(allocator: std.mem.Allocator, num_params: usize, lr: f32) !Self {\n        const m = try allocator.alloc(f32, num_params);\n        const v = try allocator.alloc(f32, num_params);\n        @memset(m, 0.0);\n        @memset(v, 0.0);\n        return Self{\n            .m = m,\n            .v = v,\n            .t = 0,\n            .lr = lr,\n            .beta1 = constants.ADAM_BETA1,\n            .beta2 = constants.ADAM_BETA2,\n            .epsilon = constants.ADAM_EPSILON,\n            .weight_decay = constants.WEIGHT_DECAY,\n            .allocator = allocator,\n        };\n    }\n\n    pub fn deinit(self: *Self) void {\n        self.allocator.free(self.m);\n        self.allocator.free(self.v);\n    }\n\n    /// One optimization step: update params using gradients\n    pub fn step(self: *Self, params: []f32, grads: []const f32) void {\n        self.t += 1;\n        const t_f: f32 = @floatFromInt(self.t);\n        const bias_correction1 = 1.0 - std.math.pow(f32, self.beta1, t_f);\n        const bias_correction2 = 1.0 - std.math.pow(f32, self.beta2, t_f);\n\n        const n = @min(@min(params.len, grads.len), self.m.len);\n        for (0..n) |i| {\n            const g = grads[i];\n\n            // Update moments\n            self.m[i] = self.beta1 * self.m[i] + (1.0 - self.beta1) * g;\n            self.v[i] = self.beta2 * self.v[i] + (1.0 - self.beta2) * g * g;\n\n            // Bias-corrected moments\n            const m_hat = self.m[i] / bias_correction1;\n            const v_hat = self.v[i] / bias_correction2;\n\n            // AdamW update: param -= lr * (m_hat / (sqrt(v_hat) + eps) + wd * param)\n            params[i] -= self.lr * (m_hat / (@sqrt(v_hat) + self.epsilon) + self.weight_decay * params[i]);\n        }\n    }\n\n    /// Apply gradient clipping before step\n    pub fn stepWithClip(self: *Self, params: []f32, grads: []f32, max_norm: f32) void {\n        clipGradNorm(grads, max_norm);\n        self.step(params, grads);\n    }\n};\n\n/// RMS normalization backward\n/// Given: grad_output (∂L/∂normalized), normalized (x/rms), rms_scale\n/// Compute: grad_input (∂L/∂x)\n/// ∂L/∂x_i = (1/rms) * (∂L/∂y_i - y_i * mean(∂L/∂y * y))\npub fn rmsNormBackward(grad_output: []const f32, normalized: []const f32, rms_scale: f32, grad_input: []f32) void {\n    const d = grad_output.len;\n    // Compute dot product: sum(grad_output * normalized) / d\n    var dot: f64 = 0.0;\n    for (0..d) |i| {\n        dot += @as(f64, grad_output[i]) * @as(f64, normalized[i]);\n    }\n    const mean_dot: f32 = @floatCast(dot / @as(f64, @floatFromInt(d)));\n    const inv_rms = 1.0 / rms_scale;\n    for (0..d) |i| {\n        grad_input[i] = inv_rms * (grad_output[i] - normalized[i] * mean_dot);\n    }\n}\n\n/// AdamW step for a slice of parameters (for per-layer stepping)\npub fn adamwStepSlice(\n    opt: *AdamW,\n    params: []f32,\n    grads: []const f32,\n    offset: usize,\n) void {\n    // Use the optimizer's current t (must call beginStep first)\n    const t_f: f32 = @floatFromInt(opt.t);\n    const bias_correction1 = 1.0 - std.math.pow(f32, opt.beta1, t_f);\n    const bias_correction2 = 1.0 - std.math.pow(f32, opt.beta2, t_f);\n\n    const n = @min(params.len, grads.len);\n    for (0..n) |i| {\n        const mi = offset + i;\n        if (mi >= opt.m.len) break;\n        const g = grads[i];\n        opt.m[mi] = opt.beta1 * opt.m[mi] + (1.0 - opt.beta1) * g;\n        opt.v[mi] = opt.beta2 * opt.v[mi] + (1.0 - opt.beta2) * g * g;\n        const m_hat = opt.m[mi] / bias_correction1;\n        const v_hat = opt.v[mi] / bias_correction2;\n        params[i] -= opt.lr * (m_hat / (@sqrt(v_hat) + opt.epsilon) + opt.weight_decay * params[i]);\n    }\n}\n\n/// Gradient clipping by global norm\npub fn clipGradNorm(grads: []f32, max_norm: f32) void {\n    var norm_sq: f64 = 0.0;\n    for (grads) |g| {\n        norm_sq += @as(f64, g) * @as(f64, g);\n    }\n    const norm: f32 = @floatCast(@sqrt(norm_sq));\n    if (norm > max_norm) {\n        const scale = max_norm / norm;\n        for (grads) |*g| {\n            g.* *= scale;\n        }\n    }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// LEARNING RATE SCHEDULE\n// ═══════════════════════════════════════════════════════════════════════════════\n\n/// Linear warmup then cosine decay\npub fn lrSchedule(step: u32, warmup_steps: u32, total_steps: u32, base_lr: f32) f32 {\n    if (step < warmup_steps) {\n        // Linear warmup\n        return base_lr * @as(f32, @floatFromInt(step)) / @as(f32, @floatFromInt(warmup_steps));\n    }\n\n    // Cosine decay\n    const progress = @as(f32, @floatFromInt(step - warmup_steps)) / @as(f32, @floatFromInt(total_steps - warmup_steps));\n    const cosine = (1.0 + @cos(std.math.pi * progress)) / 2.0;\n    return base_lr * 0.1 + (base_lr - base_lr * 0.1) * cosine; // Decay to 10% of base\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TESTS\n// ═══════════════════════════════════════════════════════════════════════════════\n\ntest \"tensor init/deinit\" {\n    const allocator = std.testing.allocator;\n    var t = try Tensor.init(allocator, 3, 4, true);\n    defer t.deinit();\n\n    try std.testing.expect(t.size() == 12);\n    try std.testing.expect(t.requires_grad);\n    try std.testing.expect(t.data[0] == 0.0);\n    try std.testing.expect(t.grad[0] == 0.0);\n}\n\ntest \"forward linear\" {\n    const allocator = std.testing.allocator;\n\n    // Input: 1×3\n    var input = try Tensor.init(allocator, 1, 3, false);\n    defer input.deinit();\n    input.data[0] = 1.0;\n    input.data[1] = 2.0;\n    input.data[2] = 3.0;\n\n    // Weight: 2×3 (out_dim=2, in_dim=3)\n    var weight = try Tensor.init(allocator, 2, 3, true);\n    defer weight.deinit();\n    // W = [[1, 0, -1], [0, 1, 0]]\n    weight.data[0] = 1.0;\n    weight.data[1] = 0.0;\n    weight.data[2] = -1.0;\n    weight.data[3] = 0.0;\n    weight.data[4] = 1.0;\n    weight.data[5] = 0.0;\n\n    // Bias: 1×2\n    var bias = try Tensor.init(allocator, 1, 2, true);\n    defer bias.deinit();\n    bias.data[0] = 0.5;\n    bias.data[1] = -0.5;\n\n    // Output: 1×2\n    var output = try Tensor.init(allocator, 1, 2, false);\n    defer output.deinit();\n\n    forwardLinear(&input, &weight, &bias, &output);\n\n    // y[0] = 1*1 + 2*0 + 3*(-1) + 0.5 = -1.5\n    // y[1] = 1*0 + 2*1 + 3*0 + (-0.5) = 1.5\n    try std.testing.expectApproxEqAbs(-1.5, output.data[0], 1e-5);\n    try std.testing.expectApproxEqAbs(1.5, output.data[1], 1e-5);\n}\n\ntest \"forward relu\" {\n    const allocator = std.testing.allocator;\n    var input = try Tensor.init(allocator, 1, 4, false);\n    defer input.deinit();\n    input.data[0] = -1.0;\n    input.data[1] = 0.0;\n    input.data[2] = 0.5;\n    input.data[3] = 2.0;\n\n    var output = try Tensor.init(allocator, 1, 4, false);\n    defer output.deinit();\n\n    forwardRelu(&input, &output);\n\n    try std.testing.expectApproxEqAbs(0.0, output.data[0], 1e-5);\n    try std.testing.expectApproxEqAbs(0.0, output.data[1], 1e-5);\n    try std.testing.expectApproxEqAbs(0.5, output.data[2], 1e-5);\n    try std.testing.expectApproxEqAbs(2.0, output.data[3], 1e-5);\n}\n\ntest \"cross entropy loss uniform\" {\n    const allocator = std.testing.allocator;\n    // Uniform logits → loss ≈ log(VOCAB_SIZE)\n    var logits = try Tensor.init(allocator, 1, VOCAB_SIZE, false);\n    defer logits.deinit();\n    logits.fill(0.0);\n\n    const targets = [_]u16{42};\n    const loss = forwardCrossEntropy(&logits, &targets);\n    const expected = @log(@as(f32, @floatFromInt(VOCAB_SIZE)));\n    try std.testing.expectApproxEqAbs(expected, loss, 0.01);\n}\n\ntest \"cross entropy loss correct prediction low\" {\n    const allocator = std.testing.allocator;\n    var logits = try Tensor.init(allocator, 1, VOCAB_SIZE, false);\n    defer logits.deinit();\n    logits.fill(0.0);\n    logits.data[42] = 10.0; // High confidence on correct class\n\n    const targets = [_]u16{42};\n    const loss = forwardCrossEntropy(&logits, &targets);\n    try std.testing.expect(loss < 1.0); // Should be low\n}\n\ntest \"cross entropy backward sums near zero\" {\n    const allocator = std.testing.allocator;\n    var logits = try Tensor.init(allocator, 1, 10, false);\n    defer logits.deinit();\n    for (0..10) |i| {\n        logits.data[i] = @as(f32, @floatFromInt(i)) * 0.5;\n    }\n\n    const targets = [_]u16{5};\n    backwardCrossEntropy(&logits, &targets);\n\n    // Gradient should sum to ~0 (softmax - one_hot)\n    var sum: f64 = 0.0;\n    for (0..10) |i| {\n        sum += logits.grad[i];\n    }\n    try std.testing.expectApproxEqAbs(0.0, @as(f32, @floatCast(sum)), 1e-5);\n}\n\ntest \"ste quantize\" {\n    const floats = [_]f32{ 0.8, -0.9, 0.1, 0.0, -0.3, 1.0, -1.0, 0.5 };\n    var ternary: [8]i8 = undefined;\n    const scale = steQuantize(&floats, &ternary);\n\n    try std.testing.expect(scale > 0.0);\n    for (ternary) |t| {\n        try std.testing.expect(t >= -1 and t <= 1);\n    }\n}\n\ntest \"adamw step\" {\n    const allocator = std.testing.allocator;\n    var opt = try AdamW.init(allocator, 4, 0.001);\n    defer opt.deinit();\n\n    var params = [_]f32{ 1.0, -1.0, 0.5, -0.5 };\n    const grads = [_]f32{ 0.1, -0.1, 0.05, -0.05 };\n\n    const original_0 = params[0];\n    opt.step(&params, &grads);\n\n    // Params should have changed\n    try std.testing.expect(params[0] != original_0);\n    try std.testing.expect(opt.t == 1);\n}\n\ntest \"gradient clipping\" {\n    var grads = [_]f32{ 3.0, 4.0 }; // norm = 5\n    clipGradNorm(&grads, 1.0);\n\n    // After clipping, norm should be <= 1.0\n    const norm = @sqrt(grads[0] * grads[0] + grads[1] * grads[1]);\n    try std.testing.expectApproxEqAbs(1.0, norm, 1e-5);\n}\n\ntest \"lr schedule warmup and decay\" {\n    const base_lr: f32 = 3e-4;\n\n    // Step 0: lr should be 0\n    try std.testing.expectApproxEqAbs(0.0, lrSchedule(0, 1000, 50000, base_lr), 1e-7);\n\n    // Step 500 (mid warmup): lr should be half base\n    try std.testing.expectApproxEqAbs(base_lr * 0.5, lrSchedule(500, 1000, 50000, base_lr), 1e-7);\n\n    // Step 1000 (end warmup): lr should be base\n    try std.testing.expectApproxEqAbs(base_lr, lrSchedule(1000, 1000, 50000, base_lr), 1e-6);\n\n    // Step 50000 (end): lr should be 10% of base\n    const end_lr = lrSchedule(50000, 1000, 50000, base_lr);\n    try std.testing.expect(end_lr < base_lr * 0.2);\n    try std.testing.expect(end_lr > 0.0);\n}\n\ntest \"backward linear gradient flow\" {\n    const allocator = std.testing.allocator;\n\n    var input = try Tensor.init(allocator, 1, 2, true);\n    defer input.deinit();\n    input.data[0] = 1.0;\n    input.data[1] = 2.0;\n\n    var weight = try Tensor.init(allocator, 2, 2, true);\n    defer weight.deinit();\n    weight.data[0] = 1.0;\n    weight.data[1] = 0.0;\n    weight.data[2] = 0.0;\n    weight.data[3] = 1.0;\n\n    var bias = try Tensor.init(allocator, 1, 2, true);\n    defer bias.deinit();\n\n    var output = try Tensor.init(allocator, 1, 2, false);\n    defer output.deinit();\n\n    forwardLinear(&input, &weight, &bias, &output);\n\n    // Set output gradient (as if loss told us)\n    output.grad[0] = 1.0;\n    output.grad[1] = 1.0;\n\n    backwardLinear(&input, &weight, &bias, &output, true);\n\n    // Weight grads should be non-zero\n    var any_nonzero = false;\n    for (weight.grad) |g| {\n        if (g != 0.0) {\n            any_nonzero = true;\n            break;\n        }\n    }\n    try std.testing.expect(any_nonzero);\n\n    // Input grads should be non-zero (gradient flows back)\n    any_nonzero = false;\n    for (input.grad) |g| {\n        if (g != 0.0) {\n            any_nonzero = true;\n            break;\n        }\n    }\n    try std.testing.expect(any_nonzero);\n}\n","numLines":645,"startLine":1,"totalLines":645}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017FcLYUkNyC26k9bqi8qXUQ","type":"tool_result","content":"     1→// HSLM — Full Training Loop with Autograd\n     2→// API defined in specs/tri/hslm_trainer.vibee\n     3→// Implementation uses autograd engine for real gradient-based training\n     4→\n     5→const std = @import(\"std\");\n     6→const constants = @import(\"constants.zig\");\n     7→const model_mod = @import(\"model.zig\");\n     8→const data_mod = @import(\"data.zig\");\n     9→const autograd = @import(\"autograd.zig\");\n    10→const tokenizer_mod = @import(\"tokenizer.zig\");\n    11→\n    12→const VOCAB_SIZE = constants.VOCAB_SIZE;\n    13→const EMBED_DIM = constants.EMBED_DIM;\n    14→const HIDDEN_DIM = constants.HIDDEN_DIM;\n    15→const CONTEXT_LEN = constants.CONTEXT_LEN;\n    16→\n    17→// ═══════════════════════════════════════════════════════════════════════════════\n    18→// TRAIN CONFIG (from specs/tri/hslm_trainer.vibee)\n    19→// ═══════════════════════════════════════════════════════════════════════════════\n    20→\n    21→pub const TrainConfig = struct {\n    22→    lr: f32 = 3e-5, // Lower LR for full STE backprop\n    23→    warmup_steps: u32 = 500,\n    24→    total_steps: u32 = 50000,\n    25→    batch_size: usize = 9, // 3²\n    26→    seq_len: usize = CONTEXT_LEN,\n    27→    grad_clip: f32 = 0.3, // Tighter clip for stability\n    28→    weight_decay: f32 = 0.1,\n    29→    checkpoint_every: u32 = 5000,\n    30→    log_every: u32 = 100,\n    31→};\n    32→\n    33→// ═══════════════════════════════════════════════════════════════════════════════\n    34→// TRAIN METRICS (from specs/tri/hslm_trainer.vibee)\n    35→// ═══════════════════════════════════════════════════════════════════════════════\n    36→\n    37→pub const TrainMetrics = struct {\n    38→    step: u32 = 0,\n    39→    loss: f32 = 0.0,\n    40→    perplexity: f32 = 0.0,\n    41→    lr_current: f32 = 0.0,\n    42→    consciousness_ratio: f64 = 0.0,\n    43→    tokens_per_sec: f64 = 0.0,\n    44→    total_loss: f64 = 0.0,\n    45→    loss_count: u64 = 0,\n    46→    best_loss: f32 = std.math.inf(f32),\n    47→\n    48→    pub fn record(self: *TrainMetrics, loss: f32) void {\n    49→        self.loss = loss;\n    50→        self.perplexity = @exp(loss);\n    51→        self.total_loss += loss;\n    52→        self.loss_count += 1;\n    53→        if (loss < self.best_loss) self.best_loss = loss;\n    54→    }\n    55→\n    56→    pub fn avgLoss(self: *const TrainMetrics) f32 {\n    57→        if (self.loss_count == 0) return 0.0;\n    58→        return @floatCast(self.total_loss / @as(f64, @floatFromInt(self.loss_count)));\n    59→    }\n    60→\n    61→    pub fn resetEpoch(self: *TrainMetrics) void {\n    62→        self.total_loss = 0.0;\n    63→        self.loss_count = 0;\n    64→    }\n    65→};\n    66→\n    67→// ═══════════════════════════════════════════════════════════════════════════════\n    68→// TRAINABLE LAYER — wraps shadow floats + ternary weights + autograd tensors\n    69→// ═══════════════════════════════════════════════════════════════════════════════\n    70→\n    71→pub const TrainableLayer = struct {\n    72→    weight: autograd.Tensor, // [out_dim, in_dim] — shadow float weights\n    73→    bias: autograd.Tensor, // [1, out_dim]\n    74→    output: autograd.Tensor, // [batch, out_dim]\n    75→    hidden: autograd.Tensor, // [batch, hidden_dim] — for relu intermediate\n    76→\n    77→    pub fn init(allocator: std.mem.Allocator, batch: usize, in_dim: usize, hid_dim: usize, out_dim: usize) !TrainableLayer {\n    78→        const w = try autograd.Tensor.init(allocator, hid_dim, in_dim, true);\n    79→        const b = try autograd.Tensor.init(allocator, 1, hid_dim, true);\n    80→\n    81→        // Xavier init\n    82→        const scale = 1.0 / @sqrt(@as(f32, @floatFromInt(in_dim)));\n    83→        var prng = std.Random.DefaultPrng.init(0xADAD_1234);\n    84→        const rng = prng.random();\n    85→        for (w.data) |*v| v.* = (rng.float(f32) * 2.0 - 1.0) * scale;\n    86→\n    87→        _ = out_dim;\n    88→\n    89→        return TrainableLayer{\n    90→            .weight = w,\n    91→            .bias = b,\n    92→            .output = try autograd.Tensor.init(allocator, batch, hid_dim, false),\n    93→            .hidden = try autograd.Tensor.init(allocator, batch, hid_dim, false),\n    94→        };\n    95→    }\n    96→\n    97→    pub fn deinit(self: *TrainableLayer) void {\n    98→        self.weight.deinit();\n    99→        self.bias.deinit();\n   100→        self.output.deinit();\n   101→        self.hidden.deinit();\n   102→    }\n   103→};\n   104→\n   105→// ═══════════════════════════════════════════════════════════════════════════════\n   106→// PARAMETER BUDGET\n   107→// ═══════════════════════════════════════════════════════════════════════════════\n   108→\n   109→// Per block: up_weights(243×729) + down_weights(729×243) + bias_up(729) + bias_down(243) = 355,266\n   110→const PARAMS_PER_BLOCK: usize = EMBED_DIM * HIDDEN_DIM + HIDDEN_DIM * EMBED_DIM + HIDDEN_DIM + EMBED_DIM;\n   111→const TOTAL_BLOCK_PARAMS: usize = PARAMS_PER_BLOCK * constants.NUM_BLOCKS;\n   112→// Output projection: weights(243×729) + bias(729) = 177,876\n   113→const OUTPUT_PARAMS: usize = EMBED_DIM * VOCAB_SIZE + VOCAB_SIZE;\n   114→const TOTAL_TRAINABLE_PARAMS: usize = TOTAL_BLOCK_PARAMS + OUTPUT_PARAMS;\n   115→\n   116→// ═══════════════════════════════════════════════════════════════════════════════\n   117→// FULL TRAINER — STE backprop through all blocks\n   118→// ═══════════════════════════════════════════════════════════════════════════════\n   119→\n   120→pub const FullTrainer = struct {\n   121→    model: *model_mod.HSLM,\n   122→    dataset: *data_mod.Dataset,\n   123→    config: TrainConfig,\n   124→    metrics: TrainMetrics,\n   125→    optimizer: autograd.AdamW,\n   126→    // Batch accumulation\n   127→    accum_count: usize,\n   128→    allocator: std.mem.Allocator,\n   129→\n   130→    const Self = @This();\n   131→\n   132→    pub fn init(\n   133→        allocator: std.mem.Allocator,\n   134→        model: *model_mod.HSLM,\n   135→        dataset: *data_mod.Dataset,\n   136→        config: TrainConfig,\n   137→    ) !Self {\n   138→        var opt = try autograd.AdamW.init(allocator, TOTAL_TRAINABLE_PARAMS, config.lr);\n   139→        opt.weight_decay = config.weight_decay;\n   140→\n   141→        return Self{\n   142→            .model = model,\n   143→            .dataset = dataset,\n   144→            .config = config,\n   145→            .metrics = TrainMetrics{},\n   146→            .optimizer = opt,\n   147→            .accum_count = 0,\n   148→            .allocator = allocator,\n   149→        };\n   150→    }\n   151→\n   152→    pub fn deinit(self: *Self) void {\n   153→        self.optimizer.deinit();\n   154→    }\n   155→\n   156→    /// Accumulate gradients for one sample (call batch_size times, then optimizerStep)\n   157→    pub fn accumulateGrad(self: *Self, input: []const u16, target: []const u16) f32 {\n   158→        const seq_len = @min(input.len, CONTEXT_LEN);\n   159→\n   160→        // Full forward through blocks with caching\n   161→        var logits: [VOCAB_SIZE]f32 = undefined;\n   162→        self.model.forwardTrain(input[0..seq_len], &logits);\n   163→\n   164→        // Compute loss (grad buffer on stack)\n   165→        var grad_buf: [VOCAB_SIZE]f32 = [_]f32{0.0} ** VOCAB_SIZE;\n   166→        var logits_tensor = autograd.Tensor{\n   167→            .data = &logits,\n   168→            .grad = &grad_buf,\n   169→            .rows = 1,\n   170→            .cols = VOCAB_SIZE,\n   171→            .requires_grad = false,\n   172→            .allocator = self.allocator,\n   173→        };\n   174→        const loss = autograd.forwardCrossEntropy(&logits_tensor, target[seq_len - 1 ..]);\n   175→\n   176→        // Backward through cross-entropy → output projection → RMS norm → blocks\n   177→        autograd.backwardCrossEntropy(&logits_tensor, target[seq_len - 1 ..]);\n   178→        self.model.backward(&grad_buf);\n   179→\n   180→        self.accum_count += 1;\n   181→        return loss;\n   182→    }\n   183→\n   184→    /// Apply accumulated gradients: average → clip → AdamW step → requantize\n   185→    pub fn optimizerStep(self: *Self) void {\n   186→        if (self.accum_count == 0) return;\n   187→        const scale = 1.0 / @as(f32, @floatFromInt(self.accum_count));\n   188→\n   189→        // Update learning rate\n   190→        self.metrics.lr_current = autograd.lrSchedule(\n   191→            self.metrics.step,\n   192→            self.config.warmup_steps,\n   193→            self.config.total_steps,\n   194→            self.config.lr,\n   195→        );\n   196→        self.optimizer.lr = self.metrics.lr_current;\n   197→        self.optimizer.t += 1;\n   198→\n   199→        // --- Output projection ---\n   200→        // Average + clip output shadow grads\n   201→        for (self.model.grad_output_shadow) |*g| g.* *= scale;\n   202→        for (self.model.grad_output_bias) |*g| g.* *= scale;\n   203→        autograd.clipGradNorm(self.model.grad_output_shadow, self.config.grad_clip);\n   204→        autograd.clipGradNorm(self.model.grad_output_bias, self.config.grad_clip);\n   205→\n   206→        // AdamW step on output projection\n   207→        var offset: usize = 0;\n   208→        autograd.adamwStepSlice(&self.optimizer, self.model.output_shadow, self.model.grad_output_shadow, offset);\n   209→        offset += EMBED_DIM * VOCAB_SIZE;\n   210→        autograd.adamwStepSlice(&self.optimizer, self.model.output_bias, self.model.grad_output_bias, offset);\n   211→        offset += VOCAB_SIZE;\n   212→\n   213→        // --- Block parameters ---\n   214→        for (&self.model.blocks) |*block| {\n   215→            // Average + clip per-block gradients\n   216→            for (block.tnn.grad_shadow_up) |*g| g.* *= scale;\n   217→            for (block.tnn.grad_shadow_down) |*g| g.* *= scale;\n   218→            for (block.tnn.grad_bias_up) |*g| g.* *= scale;\n   219→            for (block.tnn.grad_bias_down) |*g| g.* *= scale;\n   220→\n   221→            autograd.clipGradNorm(block.tnn.grad_shadow_up, self.config.grad_clip);\n   222→            autograd.clipGradNorm(block.tnn.grad_shadow_down, self.config.grad_clip);\n   223→\n   224→            // AdamW step on block params\n   225→            autograd.adamwStepSlice(&self.optimizer, block.tnn.shadow_up, block.tnn.grad_shadow_up, offset);\n   226→            offset += EMBED_DIM * HIDDEN_DIM;\n   227→            autograd.adamwStepSlice(&self.optimizer, block.tnn.shadow_down, block.tnn.grad_shadow_down, offset);\n   228→            offset += HIDDEN_DIM * EMBED_DIM;\n   229→            autograd.adamwStepSlice(&self.optimizer, block.tnn.bias_up, block.tnn.grad_bias_up, offset);\n   230→            offset += HIDDEN_DIM;\n   231→            autograd.adamwStepSlice(&self.optimizer, block.tnn.bias_down, block.tnn.grad_bias_down, offset);\n   232→            offset += EMBED_DIM;\n   233→        }\n   234→\n   235→        // Requantize all ternary weights\n   236→        self.model.requantize();\n   237→\n   238→        // Zero all grads for next accumulation\n   239→        self.model.zeroGrad();\n   240→        self.accum_count = 0;\n   241→\n   242→        // Update metrics\n   243→        self.metrics.step += 1;\n   244→        self.metrics.consciousness_ratio = self.model.consciousnessStats().ratio;\n   245→    }\n   246→\n   247→    /// One training step: accumulate one sample and step (for backward compat)\n   248→    pub fn trainStep(self: *Self, input: []const u16, target: []const u16) f32 {\n   249→        const loss = self.accumulateGrad(input, target);\n   250→        self.metrics.record(loss);\n   251→        return loss;\n   252→    }\n   253→\n   254→    /// Train one epoch\n   255→    pub fn trainEpoch(self: *Self) f32 {\n   256→        self.metrics.resetEpoch();\n   257→        self.dataset.reset();\n   258→\n   259→        var batch = data_mod.Batch.init(self.allocator, self.config.batch_size, self.dataset.seq_len) catch return 0.0;\n   260→        defer batch.deinit();\n   261→\n   262→        const num_batches = self.dataset.numSequences() / self.config.batch_size;\n   263→        if (num_batches == 0) return 0.0;\n   264→\n   265→        for (0..num_batches) |_| {\n   266→            self.dataset.nextBatch(&batch);\n   267→            for (0..self.config.batch_size) |b| {\n   268→                _ = self.trainStep(batch.getInput(b), batch.getTarget(b));\n   269→            }\n   270→        }\n   271→\n   272→        return self.metrics.avgLoss();\n   273→    }\n   274→\n   275→    /// Evaluate on validation data (no gradients)\n   276→    pub fn evaluate(self: *Self, val_data: *data_mod.Dataset) f32 {\n   277→        val_data.reset();\n   278→        var total_loss: f64 = 0.0;\n   279→        var count: u64 = 0;\n   280→\n   281→        var batch = data_mod.Batch.init(self.allocator, 1, val_data.seq_len) catch return 0.0;\n   282→        defer batch.deinit();\n   283→\n   284→        const num_batches = @min(val_data.numSequences(), 100); // Cap at 100 eval batches\n   285→        for (0..num_batches) |_| {\n   286→            val_data.nextBatch(&batch);\n   287→            const input = batch.getInput(0);\n   288→            const target = batch.getTarget(0);\n   289→\n   290→            var logits: [VOCAB_SIZE]f32 = undefined;\n   291→            self.model.forward(input, &logits);\n   292→\n   293→            const seq_len = @min(input.len, CONTEXT_LEN);\n   294→            const loss = autograd.forwardCrossEntropy(\n   295→                &autograd.Tensor{\n   296→                    .data = &logits,\n   297→                    .grad = @constCast(&[_]f32{0.0} ** VOCAB_SIZE),\n   298→                    .rows = 1,\n   299→                    .cols = VOCAB_SIZE,\n   300→                    .requires_grad = false,\n   301→                    .allocator = self.allocator,\n   302→                },\n   303→                target[seq_len - 1 ..],\n   304→            );\n   305→            total_loss += loss;\n   306→            count += 1;\n   307→        }\n   308→\n   309→        if (count == 0) return 0.0;\n   310→        return @floatCast(total_loss / @as(f64, @floatFromInt(count)));\n   311→    }\n   312→};\n   313→\n   314→// ═══════════════════════════════════════════════════════════════════════════════\n   315→// CHECKPOINT (binary format)\n   316→// ═══════════════════════════════════════════════════════════════════════════════\n   317→\n   318→pub const CHECKPOINT_MAGIC: u32 = 0x484C534D; // \"HSLM\"\n   319→pub const CHECKPOINT_VERSION: u32 = 1;\n   320→\n   321→pub fn saveCheckpoint(model: *model_mod.HSLM, step: u32, loss: f32, path: []const u8) !void {\n   322→    const file = try std.fs.cwd().createFile(path, .{});\n   323→    defer file.close();\n   324→    const writer = file.deprecatedWriter();\n   325→\n   326→    // Header\n   327→    try writer.writeInt(u32, CHECKPOINT_MAGIC, .little);\n   328→    try writer.writeInt(u32, CHECKPOINT_VERSION, .little);\n   329→    try writer.writeInt(u32, step, .little);\n   330→    try writer.writeAll(std.mem.asBytes(&loss));\n   331→\n   332→    // Shadow weights (output projection)\n   333→    try writer.writeAll(std.mem.sliceAsBytes(model.output_shadow));\n   334→\n   335→    // Block shadow weights\n   336→    for (&model.blocks) |*block| {\n   337→        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.shadow_up));\n   338→        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.shadow_down));\n   339→        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.bias_up));\n   340→        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.bias_down));\n   341→    }\n   342→}\n   343→\n   344→// ═══════════════════════════════════════════════════════════════════════════════\n   345→// TESTS\n   346→// ═══════════════════════════════════════════════════════════════════════════════\n   347→\n   348→test \"train config defaults\" {\n   349→    const cfg = TrainConfig{};\n   350→    try std.testing.expectApproxEqAbs(@as(f32, 3e-5), cfg.lr, 1e-8);\n   351→    try std.testing.expect(cfg.warmup_steps == 500);\n   352→    try std.testing.expect(cfg.total_steps == 50000);\n   353→    try std.testing.expect(cfg.batch_size == 9);\n   354→    try std.testing.expectApproxEqAbs(@as(f32, 0.3), cfg.grad_clip, 1e-6);\n   355→}\n   356→\n   357→test \"train metrics tracking\" {\n   358→    var m = TrainMetrics{};\n   359→    m.record(2.0);\n   360→    m.record(1.5);\n   361→    m.record(1.0);\n   362→\n   363→    try std.testing.expectApproxEqAbs(1.5, m.avgLoss(), 0.01);\n   364→    try std.testing.expectApproxEqAbs(1.0, m.best_loss, 0.01);\n   365→    try std.testing.expect(m.perplexity > 0.0);\n   366→}\n   367→\n   368→test \"full trainer init\" {\n   369→    const allocator = std.testing.allocator;\n   370→    var model = try model_mod.HSLM.init(allocator);\n   371→    defer model.deinit();\n   372→\n   373→    var ds = try data_mod.Dataset.init(allocator, 8);\n   374→    defer ds.deinit();\n   375→    try ds.addText(\"Hello world test data for training the HSLM model.\");\n   376→\n   377→    var trainer = try FullTrainer.init(allocator, &model, &ds, TrainConfig{});\n   378→    defer trainer.deinit();\n   379→\n   380→    try std.testing.expect(trainer.metrics.step == 0);\n   381→}\n   382→\n   383→test \"full trainer one step\" {\n   384→    const allocator = std.testing.allocator;\n   385→    var model = try model_mod.HSLM.init(allocator);\n   386→    defer model.deinit();\n   387→\n   388→    var ds = try data_mod.Dataset.init(allocator, 8);\n   389→    defer ds.deinit();\n   390→    try ds.addText(\"The quick brown fox jumps over the lazy dog many many times today.\");\n   391→\n   392→    var trainer = try FullTrainer.init(allocator, &model, &ds, TrainConfig{});\n   393→    defer trainer.deinit();\n   394→\n   395→    var batch = try data_mod.Batch.init(allocator, 1, 8);\n   396→    defer batch.deinit();\n   397→    ds.nextBatch(&batch);\n   398→\n   399→    // accumulate + step\n   400→    const loss = trainer.accumulateGrad(batch.getInput(0), batch.getTarget(0));\n   401→    trainer.metrics.record(loss);\n   402→    trainer.optimizerStep();\n   403→\n   404→    try std.testing.expect(!std.math.isNan(loss));\n   405→    try std.testing.expect(!std.math.isInf(loss));\n   406→    try std.testing.expect(loss > 0.0);\n   407→    try std.testing.expect(trainer.metrics.step == 1);\n   408→}\n   409→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"44d2ecaa-b17e-43c0-bdaa-9bdb8e6b7a9a","uuid":"d4f9c564-2f9c-4e35-96cd-22e9d7d78fbb","tool_use_result":{"type":"text","file":{"filePath":"/Users/playra/trinity-w1/src/hslm/trainer.zig","content":"// HSLM — Full Training Loop with Autograd\n// API defined in specs/tri/hslm_trainer.vibee\n// Implementation uses autograd engine for real gradient-based training\n\nconst std = @import(\"std\");\nconst constants = @import(\"constants.zig\");\nconst model_mod = @import(\"model.zig\");\nconst data_mod = @import(\"data.zig\");\nconst autograd = @import(\"autograd.zig\");\nconst tokenizer_mod = @import(\"tokenizer.zig\");\n\nconst VOCAB_SIZE = constants.VOCAB_SIZE;\nconst EMBED_DIM = constants.EMBED_DIM;\nconst HIDDEN_DIM = constants.HIDDEN_DIM;\nconst CONTEXT_LEN = constants.CONTEXT_LEN;\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TRAIN CONFIG (from specs/tri/hslm_trainer.vibee)\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const TrainConfig = struct {\n    lr: f32 = 3e-5, // Lower LR for full STE backprop\n    warmup_steps: u32 = 500,\n    total_steps: u32 = 50000,\n    batch_size: usize = 9, // 3²\n    seq_len: usize = CONTEXT_LEN,\n    grad_clip: f32 = 0.3, // Tighter clip for stability\n    weight_decay: f32 = 0.1,\n    checkpoint_every: u32 = 5000,\n    log_every: u32 = 100,\n};\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TRAIN METRICS (from specs/tri/hslm_trainer.vibee)\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const TrainMetrics = struct {\n    step: u32 = 0,\n    loss: f32 = 0.0,\n    perplexity: f32 = 0.0,\n    lr_current: f32 = 0.0,\n    consciousness_ratio: f64 = 0.0,\n    tokens_per_sec: f64 = 0.0,\n    total_loss: f64 = 0.0,\n    loss_count: u64 = 0,\n    best_loss: f32 = std.math.inf(f32),\n\n    pub fn record(self: *TrainMetrics, loss: f32) void {\n        self.loss = loss;\n        self.perplexity = @exp(loss);\n        self.total_loss += loss;\n        self.loss_count += 1;\n        if (loss < self.best_loss) self.best_loss = loss;\n    }\n\n    pub fn avgLoss(self: *const TrainMetrics) f32 {\n        if (self.loss_count == 0) return 0.0;\n        return @floatCast(self.total_loss / @as(f64, @floatFromInt(self.loss_count)));\n    }\n\n    pub fn resetEpoch(self: *TrainMetrics) void {\n        self.total_loss = 0.0;\n        self.loss_count = 0;\n    }\n};\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TRAINABLE LAYER — wraps shadow floats + ternary weights + autograd tensors\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const TrainableLayer = struct {\n    weight: autograd.Tensor, // [out_dim, in_dim] — shadow float weights\n    bias: autograd.Tensor, // [1, out_dim]\n    output: autograd.Tensor, // [batch, out_dim]\n    hidden: autograd.Tensor, // [batch, hidden_dim] — for relu intermediate\n\n    pub fn init(allocator: std.mem.Allocator, batch: usize, in_dim: usize, hid_dim: usize, out_dim: usize) !TrainableLayer {\n        const w = try autograd.Tensor.init(allocator, hid_dim, in_dim, true);\n        const b = try autograd.Tensor.init(allocator, 1, hid_dim, true);\n\n        // Xavier init\n        const scale = 1.0 / @sqrt(@as(f32, @floatFromInt(in_dim)));\n        var prng = std.Random.DefaultPrng.init(0xADAD_1234);\n        const rng = prng.random();\n        for (w.data) |*v| v.* = (rng.float(f32) * 2.0 - 1.0) * scale;\n\n        _ = out_dim;\n\n        return TrainableLayer{\n            .weight = w,\n            .bias = b,\n            .output = try autograd.Tensor.init(allocator, batch, hid_dim, false),\n            .hidden = try autograd.Tensor.init(allocator, batch, hid_dim, false),\n        };\n    }\n\n    pub fn deinit(self: *TrainableLayer) void {\n        self.weight.deinit();\n        self.bias.deinit();\n        self.output.deinit();\n        self.hidden.deinit();\n    }\n};\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// PARAMETER BUDGET\n// ═══════════════════════════════════════════════════════════════════════════════\n\n// Per block: up_weights(243×729) + down_weights(729×243) + bias_up(729) + bias_down(243) = 355,266\nconst PARAMS_PER_BLOCK: usize = EMBED_DIM * HIDDEN_DIM + HIDDEN_DIM * EMBED_DIM + HIDDEN_DIM + EMBED_DIM;\nconst TOTAL_BLOCK_PARAMS: usize = PARAMS_PER_BLOCK * constants.NUM_BLOCKS;\n// Output projection: weights(243×729) + bias(729) = 177,876\nconst OUTPUT_PARAMS: usize = EMBED_DIM * VOCAB_SIZE + VOCAB_SIZE;\nconst TOTAL_TRAINABLE_PARAMS: usize = TOTAL_BLOCK_PARAMS + OUTPUT_PARAMS;\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// FULL TRAINER — STE backprop through all blocks\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const FullTrainer = struct {\n    model: *model_mod.HSLM,\n    dataset: *data_mod.Dataset,\n    config: TrainConfig,\n    metrics: TrainMetrics,\n    optimizer: autograd.AdamW,\n    // Batch accumulation\n    accum_count: usize,\n    allocator: std.mem.Allocator,\n\n    const Self = @This();\n\n    pub fn init(\n        allocator: std.mem.Allocator,\n        model: *model_mod.HSLM,\n        dataset: *data_mod.Dataset,\n        config: TrainConfig,\n    ) !Self {\n        var opt = try autograd.AdamW.init(allocator, TOTAL_TRAINABLE_PARAMS, config.lr);\n        opt.weight_decay = config.weight_decay;\n\n        return Self{\n            .model = model,\n            .dataset = dataset,\n            .config = config,\n            .metrics = TrainMetrics{},\n            .optimizer = opt,\n            .accum_count = 0,\n            .allocator = allocator,\n        };\n    }\n\n    pub fn deinit(self: *Self) void {\n        self.optimizer.deinit();\n    }\n\n    /// Accumulate gradients for one sample (call batch_size times, then optimizerStep)\n    pub fn accumulateGrad(self: *Self, input: []const u16, target: []const u16) f32 {\n        const seq_len = @min(input.len, CONTEXT_LEN);\n\n        // Full forward through blocks with caching\n        var logits: [VOCAB_SIZE]f32 = undefined;\n        self.model.forwardTrain(input[0..seq_len], &logits);\n\n        // Compute loss (grad buffer on stack)\n        var grad_buf: [VOCAB_SIZE]f32 = [_]f32{0.0} ** VOCAB_SIZE;\n        var logits_tensor = autograd.Tensor{\n            .data = &logits,\n            .grad = &grad_buf,\n            .rows = 1,\n            .cols = VOCAB_SIZE,\n            .requires_grad = false,\n            .allocator = self.allocator,\n        };\n        const loss = autograd.forwardCrossEntropy(&logits_tensor, target[seq_len - 1 ..]);\n\n        // Backward through cross-entropy → output projection → RMS norm → blocks\n        autograd.backwardCrossEntropy(&logits_tensor, target[seq_len - 1 ..]);\n        self.model.backward(&grad_buf);\n\n        self.accum_count += 1;\n        return loss;\n    }\n\n    /// Apply accumulated gradients: average → clip → AdamW step → requantize\n    pub fn optimizerStep(self: *Self) void {\n        if (self.accum_count == 0) return;\n        const scale = 1.0 / @as(f32, @floatFromInt(self.accum_count));\n\n        // Update learning rate\n        self.metrics.lr_current = autograd.lrSchedule(\n            self.metrics.step,\n            self.config.warmup_steps,\n            self.config.total_steps,\n            self.config.lr,\n        );\n        self.optimizer.lr = self.metrics.lr_current;\n        self.optimizer.t += 1;\n\n        // --- Output projection ---\n        // Average + clip output shadow grads\n        for (self.model.grad_output_shadow) |*g| g.* *= scale;\n        for (self.model.grad_output_bias) |*g| g.* *= scale;\n        autograd.clipGradNorm(self.model.grad_output_shadow, self.config.grad_clip);\n        autograd.clipGradNorm(self.model.grad_output_bias, self.config.grad_clip);\n\n        // AdamW step on output projection\n        var offset: usize = 0;\n        autograd.adamwStepSlice(&self.optimizer, self.model.output_shadow, self.model.grad_output_shadow, offset);\n        offset += EMBED_DIM * VOCAB_SIZE;\n        autograd.adamwStepSlice(&self.optimizer, self.model.output_bias, self.model.grad_output_bias, offset);\n        offset += VOCAB_SIZE;\n\n        // --- Block parameters ---\n        for (&self.model.blocks) |*block| {\n            // Average + clip per-block gradients\n            for (block.tnn.grad_shadow_up) |*g| g.* *= scale;\n            for (block.tnn.grad_shadow_down) |*g| g.* *= scale;\n            for (block.tnn.grad_bias_up) |*g| g.* *= scale;\n            for (block.tnn.grad_bias_down) |*g| g.* *= scale;\n\n            autograd.clipGradNorm(block.tnn.grad_shadow_up, self.config.grad_clip);\n            autograd.clipGradNorm(block.tnn.grad_shadow_down, self.config.grad_clip);\n\n            // AdamW step on block params\n            autograd.adamwStepSlice(&self.optimizer, block.tnn.shadow_up, block.tnn.grad_shadow_up, offset);\n            offset += EMBED_DIM * HIDDEN_DIM;\n            autograd.adamwStepSlice(&self.optimizer, block.tnn.shadow_down, block.tnn.grad_shadow_down, offset);\n            offset += HIDDEN_DIM * EMBED_DIM;\n            autograd.adamwStepSlice(&self.optimizer, block.tnn.bias_up, block.tnn.grad_bias_up, offset);\n            offset += HIDDEN_DIM;\n            autograd.adamwStepSlice(&self.optimizer, block.tnn.bias_down, block.tnn.grad_bias_down, offset);\n            offset += EMBED_DIM;\n        }\n\n        // Requantize all ternary weights\n        self.model.requantize();\n\n        // Zero all grads for next accumulation\n        self.model.zeroGrad();\n        self.accum_count = 0;\n\n        // Update metrics\n        self.metrics.step += 1;\n        self.metrics.consciousness_ratio = self.model.consciousnessStats().ratio;\n    }\n\n    /// One training step: accumulate one sample and step (for backward compat)\n    pub fn trainStep(self: *Self, input: []const u16, target: []const u16) f32 {\n        const loss = self.accumulateGrad(input, target);\n        self.metrics.record(loss);\n        return loss;\n    }\n\n    /// Train one epoch\n    pub fn trainEpoch(self: *Self) f32 {\n        self.metrics.resetEpoch();\n        self.dataset.reset();\n\n        var batch = data_mod.Batch.init(self.allocator, self.config.batch_size, self.dataset.seq_len) catch return 0.0;\n        defer batch.deinit();\n\n        const num_batches = self.dataset.numSequences() / self.config.batch_size;\n        if (num_batches == 0) return 0.0;\n\n        for (0..num_batches) |_| {\n            self.dataset.nextBatch(&batch);\n            for (0..self.config.batch_size) |b| {\n                _ = self.trainStep(batch.getInput(b), batch.getTarget(b));\n            }\n        }\n\n        return self.metrics.avgLoss();\n    }\n\n    /// Evaluate on validation data (no gradients)\n    pub fn evaluate(self: *Self, val_data: *data_mod.Dataset) f32 {\n        val_data.reset();\n        var total_loss: f64 = 0.0;\n        var count: u64 = 0;\n\n        var batch = data_mod.Batch.init(self.allocator, 1, val_data.seq_len) catch return 0.0;\n        defer batch.deinit();\n\n        const num_batches = @min(val_data.numSequences(), 100); // Cap at 100 eval batches\n        for (0..num_batches) |_| {\n            val_data.nextBatch(&batch);\n            const input = batch.getInput(0);\n            const target = batch.getTarget(0);\n\n            var logits: [VOCAB_SIZE]f32 = undefined;\n            self.model.forward(input, &logits);\n\n            const seq_len = @min(input.len, CONTEXT_LEN);\n            const loss = autograd.forwardCrossEntropy(\n                &autograd.Tensor{\n                    .data = &logits,\n                    .grad = @constCast(&[_]f32{0.0} ** VOCAB_SIZE),\n                    .rows = 1,\n                    .cols = VOCAB_SIZE,\n                    .requires_grad = false,\n                    .allocator = self.allocator,\n                },\n                target[seq_len - 1 ..],\n            );\n            total_loss += loss;\n            count += 1;\n        }\n\n        if (count == 0) return 0.0;\n        return @floatCast(total_loss / @as(f64, @floatFromInt(count)));\n    }\n};\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// CHECKPOINT (binary format)\n// ═══════════════════════════════════════════════════════════════════════════════\n\npub const CHECKPOINT_MAGIC: u32 = 0x484C534D; // \"HSLM\"\npub const CHECKPOINT_VERSION: u32 = 1;\n\npub fn saveCheckpoint(model: *model_mod.HSLM, step: u32, loss: f32, path: []const u8) !void {\n    const file = try std.fs.cwd().createFile(path, .{});\n    defer file.close();\n    const writer = file.deprecatedWriter();\n\n    // Header\n    try writer.writeInt(u32, CHECKPOINT_MAGIC, .little);\n    try writer.writeInt(u32, CHECKPOINT_VERSION, .little);\n    try writer.writeInt(u32, step, .little);\n    try writer.writeAll(std.mem.asBytes(&loss));\n\n    // Shadow weights (output projection)\n    try writer.writeAll(std.mem.sliceAsBytes(model.output_shadow));\n\n    // Block shadow weights\n    for (&model.blocks) |*block| {\n        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.shadow_up));\n        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.shadow_down));\n        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.bias_up));\n        try writer.writeAll(std.mem.sliceAsBytes(block.tnn.bias_down));\n    }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════\n// TESTS\n// ═══════════════════════════════════════════════════════════════════════════════\n\ntest \"train config defaults\" {\n    const cfg = TrainConfig{};\n    try std.testing.expectApproxEqAbs(@as(f32, 3e-5), cfg.lr, 1e-8);\n    try std.testing.expect(cfg.warmup_steps == 500);\n    try std.testing.expect(cfg.total_steps == 50000);\n    try std.testing.expect(cfg.batch_size == 9);\n    try std.testing.expectApproxEqAbs(@as(f32, 0.3), cfg.grad_clip, 1e-6);\n}\n\ntest \"train metrics tracking\" {\n    var m = TrainMetrics{};\n    m.record(2.0);\n    m.record(1.5);\n    m.record(1.0);\n\n    try std.testing.expectApproxEqAbs(1.5, m.avgLoss(), 0.01);\n    try std.testing.expectApproxEqAbs(1.0, m.best_loss, 0.01);\n    try std.testing.expect(m.perplexity > 0.0);\n}\n\ntest \"full trainer init\" {\n    const allocator = std.testing.allocator;\n    var model = try model_mod.HSLM.init(allocator);\n    defer model.deinit();\n\n    var ds = try data_mod.Dataset.init(allocator, 8);\n    defer ds.deinit();\n    try ds.addText(\"Hello world test data for training the HSLM model.\");\n\n    var trainer = try FullTrainer.init(allocator, &model, &ds, TrainConfig{});\n    defer trainer.deinit();\n\n    try std.testing.expect(trainer.metrics.step == 0);\n}\n\ntest \"full trainer one step\" {\n    const allocator = std.testing.allocator;\n    var model = try model_mod.HSLM.init(allocator);\n    defer model.deinit();\n\n    var ds = try data_mod.Dataset.init(allocator, 8);\n    defer ds.deinit();\n    try ds.addText(\"The quick brown fox jumps over the lazy dog many many times today.\");\n\n    var trainer = try FullTrainer.init(allocator, &model, &ds, TrainConfig{});\n    defer trainer.deinit();\n\n    var batch = try data_mod.Batch.init(allocator, 1, 8);\n    defer batch.deinit();\n    ds.nextBatch(&batch);\n\n    // accumulate + step\n    const loss = trainer.accumulateGrad(batch.getInput(0), batch.getTarget(0));\n    trainer.metrics.record(loss);\n    trainer.optimizerStep();\n\n    try std.testing.expect(!std.math.isNan(loss));\n    try std.testing.expect(!std.math.isInf(loss));\n    try std.testing.expect(loss > 0.0);\n    try std.testing.expect(trainer.metrics.step == 1);\n}\n","numLines":409,"startLine":1,"totalLines":409}}}

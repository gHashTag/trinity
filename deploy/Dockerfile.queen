# Queen Backend Container — Simple Runtime Image
# Copies pre-built binary from host (no in-Docker build)

FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built binary (build on host first with: zig build queen-backend)
COPY zig-out/bin/queen-backend /usr/local/bin/

# Create directories for Trinity state
RUN mkdir -p /trinity/.trinity/queen /trinity/.trinity/experience/episodes

# Environment variables
ENV PORT=8080
ENV SELF_IMPROVE_INTERVAL=3600
ENV EPISODE_WINDOW=100

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose ports
EXPOSE 8080

# Run Queen backend
CMD ["/usr/local/bin/queen-backend"]

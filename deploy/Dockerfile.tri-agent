# ============================================================================
# Trinity Agent — Pure Zig, All 27 Agents in One Image
# ============================================================================
#
# Single image for all 27 domain agents (alpha through sho).
# Configure via environment:
#   AGENT_DOMAIN=alpha|beta|gamma|...|omega|sampi|sho
#   AGENT_PORT=9001|9002|...|9026
#   QUEEN_URL=http://queen.railway.internal:8080
#
# Health check: Built-in Zig --health flag (no curl dependency)

FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Minimal runtime — ca-certificates for HTTPS, nothing else
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Install Zig 0.15.2 (pinned, reproducible)
ENV ZIG_VERSION=0.15.2
RUN set -eux; \
    curl -fsSL "https://ziglang.org/builds/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" | tar xJ -C /opt; \
    mv "/opt/zig-linux-x86_64-${ZIG_VERSION}" /opt/zig; \
    /opt/zig/zig version

ENV PATH="/opt/zig:${PATH}"

# Runtime directories (read-only root, tmpfs for state)
VOLUME ["/trinity/.trinity"]
RUN mkdir -p /trinity/.trinity/{experience/episodes,logs,state} /tmp

# Copy pre-built tri binary (built separately, or build in separate stage)
# For production: COPY --from=builder /trinity/zig-out/bin/tri /usr/local/bin/
# For this setup: we assume tri is already built
COPY zig-out/bin/tri /usr/local/bin/tri

# Verify binary
RUN /usr/local/bin/tri version || true

# Non-root user
RUN useradd -m -u 1000 trinity && chown -R trinity:trinity /trinity /tmp
USER trinity
WORKDIR /trinity

# Default environment (override at deploy time)
ENV AGENT_DOMAIN=alpha
ENV AGENT_PORT=9001
ENV QUEEN_URL=http://queen:8080
ENV TMPDIR=/tmp

# Health check — uses built-in --health flag from agent_entrypoint.zig
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD /usr/local/bin/tri agent run --health --port=${AGENT_PORT}

# Expose agent port
EXPOSE 9001

# Run agent
ENTRYPOINT ["/usr/local/bin/tri", "agent", "run"]

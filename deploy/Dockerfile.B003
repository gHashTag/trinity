# Trinity B003: TRI-27 Assembly Container
# Zenodo v6.0 — Reproducibility Bundle

FROM ziglang/zig:0.15.0-alpine AS builder

WORKDIR /src
COPY . .

# Build VIBEE compiler and TRI-27 assembler
RUN zig build -Doptimize=ReleaseSafe vibee
RUN zig build -Doptimize=ReleaseSafe tri27-emu

# Runtime stage
FROM alpine:3.20

WORKDIR /app
COPY --from=builder /src/zig-out/bin /usr/local/bin
COPY --from=builder /src/specs/tri /app/specs
COPY --from=builder /src/docs/research/data /app/data

ENV VIBEE_OUTPUT=/app/output
ENV TRI27_OUTPUT=/app/output

# Default: Show help
ENTRYPOINT ["/usr/local/bin/vibee"]
CMD ["--help"]

# Example usage:
# docker run -v $(pwd)/output:/app/output trinity-b003 \
#   --spec /app/specs/hello.tri \
#   --output /app/output/hello.t27

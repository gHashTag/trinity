# Trinity B002: FPGA Synthesis Container
# Zenodo Bundle v6.1 - Zero-DSP Ternary Inference
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build FPGA synthesis tools
RUN zig build fpga-synth

# Runtime stage
FROM alpine:3.19
RUN apk add --no-cache yosys nextpnr-ice40
COPY --from=build /src/zig-out/bin/fpga-synth /usr/local/bin/
COPY --from=build /src/fpga /usr/local/share/trinity/fpga

WORKDIR /workspace
ENTRYPOINT ["fpga-synth"]
CMD ["--help"]

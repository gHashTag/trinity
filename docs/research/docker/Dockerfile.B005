# Trinity B005: VIBEE Compiler Container
# Zenodo Bundle v6.1 - Linear Types, Effects, Dual-Target Codegen
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build VIBEE compiler
RUN zig build vibee

# Runtime stage
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/vibee /usr/local/bin/

WORKDIR /workspace
ENTRYPOINT ["vibee"]
CMD ["--help"]

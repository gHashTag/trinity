# Trinity B003: TRI-27 Emulator Container
# Zenodo Bundle v6.1 - Ternary Instruction Set
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build TRI-27 emulator and assembler
RUN zig build tri27-emu tri27-asm

# Runtime stage
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/tri27-* /usr/local/bin/

WORKDIR /workspace
ENTRYPOINT ["tri27-emu"]
CMD ["--help"]

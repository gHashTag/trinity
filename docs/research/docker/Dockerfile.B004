# Trinity B004: Queen Lotus Cycle Container
# Zenodo Bundle v6.1 - Autonomous Learning Orchestration
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build Queen Lotus runtime
RUN zig build queen-lotus

# Runtime stage
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/queen-lotus /usr/local/bin/

WORKDIR /workspace
ENTRYPOINT ["queen-lotus"]
CMD ["--help"]

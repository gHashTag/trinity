# Trinity B006: GF16/TF3 Format Container
# Bundle: Sacred GF16/TF3
# Purpose: Reproducible number format experiments
# φ² + 1/φ² = 3 | TRINITY

FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src

# Copy source
COPY . .

# Build GF16/TF3 utilities
RUN zig build gf16-test

# Build format conversion tools
RUN zig build format-convert

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache python3 py3-pip

WORKDIR /app

# Copy binaries
COPY --from=build /src/zig-out/bin/gf16-test /app/
COPY --from=build /src/zig-out/bin/format-convert /app/

# Copy Python analysis scripts
COPY --from=build /src/docs/research/figures/*.py /app/scripts/ 2>/dev/null || true

# Default: Run GF16 round-trip test
ENTRYPOINT ["/app/gf16-test"]
CMD ["--help"]

# Example usage:
# docker run trinity-b006 --roundtrip --samples 1000000

<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" default-locale="en-US">
  <info>
    <title>Trinity S³AI</title>
    <id>trinity-s3ai</id>
    <author>
      <name>Vasilev, Dmitrii</name>
      <email>trinity@trinity.ai</email>
    </author>
    <updated>2026-03-26</updated>
    <summary>Trinity Sacred Symbolic AI Framework citation style</summary>
    <category>engineering</category>
    <category>computer-science</category>
  </info>

  <!-- Locale -->
  <locale>
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>

  <!-- Citation Formats -->
  <citation>
    <sort>
      <key variable="issued" sort="ascending"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="symbol" delimiter=", "/>
          <et-al term="et-al"/>
        </names>
        <date variable="issued">
          <year prefix=" "/>
        </date>
      </group>
    </layout>
  </citation>

  <!-- Bibliography -->
  <bibliography hangingindent="true" et-al-min="3" et-al-use-first="1">
    <sort>
      <key macro="author"/>
      <key variable="issued" sort="ascending"/>
    </sort>

    <layout>
      <text variable="title" font-weight="bold"/>
      <text macro="author" prefix=", "/>
      <text macro="year-date" prefix=", "/>
      <text macro="publisher" prefix=", "/>
      <text macro="access" prefix=". "/>
    </layout>
  </bibliography>

  <!-- Macros -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" and="symbol" delimiter=", " initialize-with=". "/>
      <label form="short" prefix=" (" suffix=")"/>
      <et-al term="et-al"/>
    </names>
  </macro>

  <macro name="year-date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="publisher">
    <choose>
      <if variable="publisher">
        <text variable="publisher"/>
      </if>
      <else-if variable="container-title">
        <text variable="container-title" font-style="italic"/>
      </else-if>
    </choose>
    <text variable="volume" prefix=" "/>
    <text variable="issue" prefix="(" suffix=")"/>
    <text variable="page" prefix=", "/>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: " prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
</style>

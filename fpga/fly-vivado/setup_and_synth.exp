#!/usr/bin/expect -f
# Vivado AuthTokenGen automation (auth only)
set timeout 300
# Credentials come from the environment (Railway/Infisical), never from this file.
foreach var {AMD_ACCOUNT_EMAIL AMD_ACCOUNT_PASSWORD} {
    if {![info exists env($var)] || $env($var) eq ""} {
        puts "=== AUTH TOKEN ERROR: $var is not set ==="
        exit 1
    }
}

# Generate Auth Token (interactive - requires expect)
puts "=== Generating Auth Token ==="
spawn /vivado/installer/xsetup -b AuthTokenGen
expect "E-mail Address:"
send "$env(AMD_ACCOUNT_EMAIL)\r"
expect "Password:"
send "$env(AMD_ACCOUNT_PASSWORD)\r"
expect {
    "Saved authentication token file successfully" {
        puts "\n=== AUTH TOKEN GENERATED ==="
    }
    "token file already exists" {
        puts "\n=== AUTH TOKEN ALREADY EXISTS ==="
    }
    "ERROR" {
        puts "\n=== AUTH TOKEN ERROR ==="
        exit 1
    }
    timeout {
        puts "\n=== AUTH TOKEN TIMEOUT ==="
        exit 1
    }
    eof {}
}
wait
puts "=== AUTH COMPLETE ==="

// Simple standalone Kaggle CLI - bypasses broken tri imports
const std = @import("std");

pub fn main() !void {
    const gpa = std.heap.page_allocator;

    const args = try std.process.argsAlloc(gpa);
    defer std.process.argsFree(gpa, args);

    if (args.len < 2) {
        std.debug.print("Kaggle CLI — Pure Zig cognitive benchmark tools\n", .{});
        std.debug.print("Usage: {s} <command> [options]\n\n", .{args[0]});
        std.debug.print("Commands:\n", .{});
        std.debug.print("  parse <file>     Parse CSV and show stats\n", .{});
        std.debug.print("  test           Run kaggle module tests\n", .{});
        return;
    }

    const command = args[1];
    const command_args = args[2..];

    if (std.mem.eql(u8, command, "test")) {
        try runTests();
    } else if (std.mem.eql(u8, command, "parse")) {
        try runParse(gpa, command_args);
    } else {
        std.debug.print("Unknown command: {s}\n", .{command});
    }
}

fn runTests() !void {
    std.debug.print("Running kaggle module tests...\n\n", .{});

    // Test CSV Parser
    {
        std.debug.print("Testing CSV Parser...\n", .{});
        const CsvParser = @import("src/kaggle/csv_parser.zig").CsvParser;
        const parser = CsvParser.init(std.testing.allocator, "kaggle/data/tmp_metacognition.csv");
        const result = try parser.parse();
        std.debug.print("  ✅ Total: {d}, Open-ended: {d}, Factual: {d}\n\n", .{
            result.stats.total_rows,
            result.stats.open_ended,
            result.stats.factual,
        });
    }

    // Test MC Generator
    {
        std.debug.print("Testing MC Generator...\n", .{});
        const McGenerator = @import("src/kaggle/mc_generator.zig").McGenerator;
        _ = McGenerator;
        std.debug.print("  ✅ MC Generator loads\n\n", .{});
    }

    // Test Matcher
    {
        std.debug.print("Testing Matcher...\n", .{});
        const Matcher = @import("src/kaggle/matcher.zig").Matcher;
        const matcher = Matcher.init(std.testing.allocator);
        const result = matcher.match("Tashkent", "Tashkent");
        std.debug.print("  ✅ Match: matched={}, strategy={}\n\n", .{ result.matched, result.strategy });
    }

    // Test Evaluator
    {
        std.debug.print("Testing Evaluator...\n", .{});
        const Evaluator = @import("src/kaggle/evaluator.zig").Evaluator;
        _ = Evaluator;
        std.debug.print("  ✅ Evaluator loads\n\n", .{});
    }

    std.debug.print("All tests passed! ✅\n", .{});
}

fn runParse(allocator: std.mem.Allocator, args: []const []const u8) !void {
    const file = if (args.len > 0) args[0] else "kaggle/data/tmp_metacognition.csv";

    std.debug.print("Parsing: {s}\n", .{file});

    const CsvParser = @import("src/kaggle/csv_parser.zig").CsvParser;
    const parser = CsvParser.init(allocator, file);
    const result = try parser.parse();

    std.debug.print("\n{s}Results{s}\n", .{ "\x1b[1m", "\x1b[0m" });
    std.debug.print("Total Rows: {d}\n", .{result.stats.total_rows});
    std.debug.print("Open-ended: {d}\n", .{result.stats.open_ended});
    std.debug.print("Factual: {d}\n", .{result.stats.factual});
    std.debug.print("Avg Difficulty: {d:.2}\n", .{result.stats.avg_difficulty});

    if (result.stats.tasks.count() > 0) {
        std.debug.print("\n{s}Tasks:{s}\n", .{ "\x1b[1m", "\x1b[0m" });
        var iter = result.stats.tasks.iterator();
        while (iter.next()) |entry| {
            std.debug.print("  {s}: {d}\n", .{entry.key_ptr.*, entry.value_ptr.*});
        }
    }

    // Cleanup
    {
        allocator.free(result.rows);
        for (result.rows) |r| {
            allocator.free(r.id);
            allocator.free(r.task);
            allocator.free(r.question);
            allocator.free(r.answer);
            if (r.brain_zone.len > 0) allocator.free(r.brain_zone);
            if (r.neural_analog.len > 0) allocator.free(r.neural_analog);
        }
        result.stats.deinit();
    }

    std.debug.print("\n✅ Done\n", .{});
}

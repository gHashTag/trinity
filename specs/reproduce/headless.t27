; The roots that do not compile at MEASURED_AT, what the compiler says, and the capability card of the S01
; manifest each one holds back. Exactly these may fail; one more fails the gate, and one fewer fails it too.
pub const BLOCKED_ROOTS : [5]str = ["src/c_api.zig", "src/e2e_test.zig", "src/queen_api.zig", "src/trinity.zig", "src/vm.zig"];
pub const BLOCKED_REASONS : [5]str = [
    "src/c_api.zig:270:1: expected statement, found 'a document comment' -- the file does not parse; S05 of the epic recorded the same at the S01 pin",
    "src/packed_trit.zig:1:1: unable to load 'packed_trit.zig': FileNotFound -- src/e2e_test.zig:21 imports a file removed in 42490a222 (#517)",
    "lib/std/c.zig and lib/std/heap.zig:128: the C allocator without libc (4 errors) -- the queen_api test module does not set link_libc, as the main test module does",
    "src/hybrid.zig:4 and src/vsa.zig:7: no module named 'zig-hdc-vsa' (the test module provides it as hdc_vsa); src/science.zig:53, 143, 161, 179, 204: expected optional type, found '[59049]i8' (7 errors)",
    "src/vm.zig:1150:15: expected optional type, found '[59049]i8'; src/vsa_jit.zig:117:26: member function expected 1 argument(s), found 2"
];
pub const BLOCKED_CAPABILITIES : [5]str = ["trinity/abi.c-api", "trinity/examples.zig", "trinity/queen.lib", "trinity/lib.trinity", "trinity/lib.trinity"];
pub const EVIDENCE : str = "tools/reproduce.py writes zig-out/reproduce/<command>.json: toolchain, head, cache freshness, each command with its exit code and summary, the compile failures by root, the run steps, the compiled roots, every install with its sha256, and the violations";
pub const ENABLED : bool = true;

test the_profile_is_headless_and_pinned {
    assert PROFILE == "headless";
    assert ZIG == "0.15.2";
    assert BUILD_STEPS_MIN == 94;
}

test the_floors_hold_together {
    assert TESTS_PASSED_MIN == 2510;
    assert RUN_STEPS_WITH_TESTS_MIN + EMPTY_RUN_STEPS_MAX + 5 == 67;
    assert TEST_STEPS_MIN > RUN_STEPS_WITH_TESTS_MIN;
}

invariant blocked_roots_are_few {
    assert EMPTY_RUN_STEPS_MAX <= 1;
}

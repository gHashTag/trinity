# ═══════════════════════════════════════════════════════════════════
# GUARDS — Tri Specification (TTT Dogfood v0.1)
# ═══════════════════════════════════════════════════════════════════
# Guard Condition Evaluation for Tri Language
# Source of truth for tri-lang/guards.zig codegen
# Issue #408: Guard conditions in match expressions
# φ² + 1/φ² = 3 | TRINITY
# ═══════════════════════════════════════════════════════════════════

name: tri_guards
version: "0.1.0"
module: tri_lang.guards
description: "Guard condition evaluation for match expressions (TTT Dogfood v0.1)"
language: zig

# ═══════════════════════════════════════════════════════════════════
# TYPES
# ═══════════════════════════════════════════════════════════════════

types:
  GuardExpr:
    description: "Guard condition expression"
    underlying: "union(enum)"
    variants:
      - BoolLiteral:
          value: "bool"
          description: "Boolean literal"
      - IntLiteral:
          value: "i64"
          description: "Integer literal"
      - Identifier:
          value: "[]const u8"
          description: "Variable reference"
      - BinaryOp:
          value: "GuardBinaryOp"
          description: "Binary operation"
      - UnaryOp:
          value: "GuardUnaryOp"
          description: "Unary operation"

  GuardBinaryOp:
    description: "Binary operation in guard"
    fields:
      - name: op
        type: "BinaryOperator"
        description: "Operation to perform"
      - name: left
        type: "*const GuardExpr"
        description: "Left operand"
      - name: right
        type: "*const GuardExpr"
        description: "Right operand"

  GuardUnaryOp:
    description: "Unary operation in guard"
    fields:
      - name: op
        type: "UnaryOperator"
        description: "Operation to perform"
      - name: operand
        type: "*const GuardExpr"
        description: "Operand"

  BinaryOperator:
    description: "Binary operators"
    underlying: "enum"
    variants:
      - BitAnd: "Bitwise AND"
      - BitOr: "Bitwise OR"
      - Add: "Addition"
      - Sub: "Subtraction"
      - Mul: "Multiplication"
      - Div: "Division"
      - Equal: "Equality"
      - NotEqual: "Not equal"
      - Less: "Less than"
      - Greater: "Greater than"

  UnaryOperator:
    description: "Unary operators"
    underlying: "enum"
    variants:
      - BitNot: "Bitwise NOT"
      - Neg: "Negation"

  GuardResult:
    description: "Guard compilation result"
    fields:
      - name: always_true
        type: "bool"
        description: "Guard always passes"
      - name: always_false
        type: "bool"
        description: "Guard always fails"

  Guard:
    description: "Simple guard type"
    fields:
      - name: condition
        type: "GuardExpr"
        description: "Guard condition expression"

  GuardCodegen:
    description: "Guard bytecode compilation context"
    fields:
      - name: allocator
        type: "std.mem.Allocator"
        description: "Memory allocator"
      - name: bytecode
        type: "std.ArrayList(u8)"
        description: "Generated bytecode"
      - name: label_counter
        type: "u32"
        description: "Label ID counter"
    methods:
      - name: init
        params:
          - name: allocator
            type: "std.mem.Allocator"
        returns: "GuardCodegen"
        description: "Initialize codegen context"

      - name: deinit
        params:
          - name: allocator
            type: "std.mem.Allocator"
        returns: "void"
        description: "Free resources"

      - name: emitGuardCheck
        params:
          - name: guard
            type: "Guard"
        returns: "!void"
        description: "Emit JZ instruction for guard failure"
        errors:
          - OutOfMemory

      - name: freshLabel
        returns: "![]const u8"
        description: "Generate fresh label (guard_fail_0, ...)"
        errors:
          - OutOfMemory

      - name: getBytecode
        returns: "[]const u8"
        description: "Get generated bytecode"

# ═══════════════════════════════════════════════════════════════════
# FUNCTIONS
# ═══════════════════════════════════════════════════════════════════

functions:
  evalGuard:
    params:
      - name: guard
        type: "Guard"
    returns: "GuardResult"
    description: "Evaluate guard at compile time if possible"

  isTrivialGuard:
    params:
      - name: guard
        type: "Guard"
    returns: "bool"
    description: "Check if guard is trivial (always true or always false)"

  guardAlwaysPasses:
    params:
      - name: guard
        type: "Guard"
    returns: "bool"
    description: "Check if guard always passes"

  guardAlwaysFails:
    params:
      - name: guard
        type: "Guard"
    returns: "bool"
    description: "Check if guard always fails"

  compileGuard:
    params:
      - name: cg
        type: "*GuardCodegen"
      - name: guard
        type: "Guard"
    returns: "!void"
    description: "Compile guard condition to bytecode"
    errors:
      - OutOfMemory

  optimizeGuard:
    params:
      - name: guard
        type: "Guard"
    returns: "!Guard"
    description: "Optimize guard conditions"
    errors:
      - OutOfMemory
    note: "Constant propagation and dead code elimination"

# ═══════════════════════════════════════════════════════════════════
# TESTS
# ═══════════════════════════════════════════════════════════════════

tests:
  - name: "evalGuard with true literal"
    given: "Guard with BoolLiteral true"
    when: "evaluating"
    then: "returns always_true=true, always_false=false"

  - name: "evalGuard with false literal"
    given: "Guard with BoolLiteral false"
    when: "evaluating"
    then: "returns always_true=false, always_false=true"

  - name: "evalGuard with non-zero integer"
    given: "Guard with IntLiteral 42"
    when: "evaluating"
    then: "returns always_true=true"

  - name: "evalGuard with zero integer"
    given: "Guard with IntLiteral 0"
    when: "evaluating"
    then: "returns always_false=true"

  - name: "compileGuard with always true guard"
    given: "Guard with BoolLiteral true"
    when: "compiling"
    then: "emits no bytecode (optimized away)"

  - name: "compileGuard with always false guard"
    given: "Guard with BoolLiteral false"
    when: "compiling"
    then: "emits HALT (0xFF)"

# ═══════════════════════════════════════════════════════════════════
# DESIGN NOTES
# ═══════════════════════════════════════════════════════════════════

# Guards enable conditional pattern matching:
# - Guards are evaluated at compile time for constants
# - Always-true guards are optimized away
# - Always-false guards emit HALT (unreachable)
# - Runtime guards emit JZ instruction
#
# Example:
#   match x {
#   | Some(v) | v > 0 => "positive"
#   | Some(v) => "non-positive"
#   }
#
# The guard | v > 0 is compiled to bytecode that checks v > 0
# and jumps to next arm if false.

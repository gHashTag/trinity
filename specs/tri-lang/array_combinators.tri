# ═══════════════════════════════════════════════════════════════════
# ARRAY COMBINATORS — Tri Specification (TTT Dogfood v0.1)
# ═══════════════════════════════════════════════════════════════════
# Array Combinators for Tri Language
# Source of truth for tri-lang/array_combinators.zig codegen
# Issue #413: Array Combinators (map/reduce/scan)
# φ² + 1/φ² = 3 | TRINITY
# ═══════════════════════════════════════════════════════════════════

name: tri_array_combinators
version: "0.1.0"
module: tri_lang.array_combinators
description: "Array combinators map/reduce/scan/filter (TTT Dogfood v0.1)"
language: zig

# ═══════════════════════════════════════════════════════════════════
# TYPES
# ═══════════════════════════════════════════════════════════════════

types:
  SourceLocation:
    description: "Location in source file"
    fields:
      - name: line
        type: "usize"
      - name: column
        type: "usize"

# ═══════════════════════════════════════════════════════════════════
# FUNCTIONS
# ═══════════════════════════════════════════════════════════════════

functions:
  # Map operations
  map:
    type_params: ["T", "U"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: f
        type: "fn (T) U"
    returns: "[]U"
    description: "Apply f to each element, return new array"

  mapInPlace:
    type_params: ["T"]
    params:
      - name: array
        type: "[]T"
      - name: f
        type: "fn (T) T"
    returns: "void"
    description: "Apply f to each element in-place"

  # Reduce operations
  reduce:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "T"
    description: "Fold array with binary operation"

  reduceIndexed:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T, usize) T"
    returns: "T"
    description: "Fold with index included"

  # Scan operations (prefix scan)
  scan:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "[]T"
    description: "Prefix scan (exclusive)"

  scanInclusive:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "[]T"
    description: "Inclusive prefix scan"

  scanExclusive:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "[]T"
    description: "Exclusive prefix scan"

  # Filter operations
  filter:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "[]T"
    description: "Keep elements matching predicate"

  flatMap:
    type_params: ["T", "U"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: f
        type: "fn (T) []const U"
    returns: "[]U"
    description: "Bind for array monad, concatenate results"

  # Fold operations (left/right)
  foldLeft:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "T"
    description: "Left fold"

  foldRight:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: init
        type: "T"
      - name: op
        type: "fn (T, T) T"
    returns: "T"
    description: "Right fold"

  # Zip operations
  zip:
    type_params: ["T", "U"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: a
        type: "[]const T"
      - name: b
        type: "[]const U"
    returns: "[]Zip(T, U)"
    description: "Zip two arrays together"

  partition:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "struct { passing: []T, failing: []T }"
    description: "Split array into passing/failing"

  # Chunking operations
  chunk:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: size
        type: "usize"
    returns: "[][]const T"
    description: "Split into fixed-size chunks"

  chunkBy:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T, T) bool"
    returns: "[][]const T"
    description: "Split where predicate is true"

  # Reordering operations
  reverse:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
    returns: "[]T"
    description: "Reverse array"

  # Slicing operations
  take:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: n
        type: "usize"
    returns: "[]const T"
    description: "Take first n elements"

  drop:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: n
        type: "usize"
    returns: "[]const T"
    description: "Drop first n elements"

  takeWhile:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "[]T"
    description: "Take while predicate true"

  dropWhile:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "[]T"
    description: "Drop while predicate true"

  # Search operations
  find:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "?usize"
    description: "Find first index matching predicate"

  findLast:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "?usize"
    description: "Find last index matching predicate"

  findIndex:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: value
        type: "T"
    returns: "?usize"
    description: "Find index of value"

  findLastIndex:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: value
        type: "T"
    returns: "?usize"
    description: "Find last index of value"

  any:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "bool"
    description: "True if any element matches predicate"

  all:
    type_params: ["T"]
    params:
      - name: array
        type: "[]const T"
      - name: pred
        type: "fn (T) bool"
    returns: "bool"
    description: "True if all elements match predicate"

  # Special operations
  distinct:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[]const T"
    returns: "[]T"
    description: "Remove duplicates, preserve order"

  flatten:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: array
        type: "[][]const T"
    returns: "[]T"
    description: "Flatten one level of nesting"

  interleave:
    type_params: ["T"]
    params:
      - name: allocator
        type: "std.mem.Allocator"
      - name: arrays
        type: "[][]const T"
    returns: "[]T"
    description: "Interleave multiple arrays"

# ═══════════════════════════════════════════════════════════════════
# TESTS
# ═══════════════════════════════════════════════════════════════════

tests:
  - name: "map doubles values"
    given: "array [1, 2, 3]"
    when: "mapping with fn(x) x*2"
    then: "returns [2, 4, 6]"

  - name: "reduce sums array"
    given: "array [1, 2, 3, 4]"
    when: "reducing with add"
    then: "returns 10"

  - name: "scan prefix sum"
    given: "array [1, 2, 3]"
    when: "scanning with init=0, op=add"
    then: "returns [1, 3, 6]"

  - name: "filter keeps positives"
    given: "array [-1, 0, 1, -2, 2]"
    when: "filtering with fn(x) x > 0"
    then: "returns [1, 2]"

  - name: "flatMap concatenates"
    given: "array [[1], [2, 3]]"
    when: "flatMapping identity"
    then: "returns [1, 2, 3]"

  - name: "zip pairs arrays"
    given: "arrays [1, 2] and ['a', 'b']"
    when: "zipping"
    then: "returns [(1, 'a'), (2, 'b')]"

  - name: "reverse flips array"
    given: "array [1, 2, 3]"
    when: "reversing"
    then: "returns [3, 2, 1]"

  - name: "take first two"
    given: "array [1, 2, 3, 4]"
    when: "taking 2"
    then: "returns [1, 2]"

  - name: "drop first two"
    given: "array [1, 2, 3, 4]"
    when: "dropping 2"
    then: "returns [3, 4]"

  - name: "find finds value"
    given: "array [1, 2, 3]"
    when: "finding 2"
    then: "returns index 1"

  - name: "any finds positive"
    given: "array [-1, 0, 1]"
    when: "checking any(x > 0)"
    then: "returns true"

  - name: "all checks positive"
    given: "array [1, 2, 3]"
    when: "checking all(x > 0)"
    then: "returns true"

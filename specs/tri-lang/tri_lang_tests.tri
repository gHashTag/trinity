name: tri_lang_tests
version: "0.1.0"
module: tri_lang.tri_lang_tests
description: "Tests for ADT Enum + Match + Pipe (TTT Dogfood v0.1)"
language: zig

# ═══════════════════════════════════════════════════════════════════
# DESCRIPTION
# ═══════════════════════════════════════════════════════════════════

# Test suite for Tri language features from Issue #408:
# - ADT enum: data-carrying enums like Rust's Option<T>
# - Match: Exhaustive pattern matching
# - Pipe: Elixir-style |> operator for function chaining
# - Guards: Haskell-style | conditions in match arms
# - Pattern matching: wildcards, arrays, structs, ranges

# ═══════════════════════════════════════════════════════════════════
# TESTS
# ═══════════════════════════════════════════════════════════════════

tests:
  - name: "adt_enum_basic"
    description: "Parse data-carrying enum (Option<T>)"
    given: "enum Option { Some(trit), None }"
    when: "parsing and checking AST"
    then: "produces enum_decl node"

  - name: "exhaustive_match_pattern"
    description: "Parse exhaustive match expression"
    given: "match signal { .pos => .good, .zero => .unknown, .neg => .bad }"
    when: "parsing"
    then: "produces match_expression node"

  - name: "pipe_operator_basic"
    description: "Parse basic pipe operator"
    given: "x |> f"
    when: "parsing"
    then: "produces pipe_expression node"

  - name: "pipe_with_multiple_stages"
    description: "Parse multi-stage pipe"
    given: "x |> f |> g |> h"
    when: "parsing"
    then: "produces pipe_expression node"

  - name: "guard_condition"
    description: "Guard condition in match arm"
    given: "match with | guard"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "guard_with_expression"
    description: "Guard with boolean expression"
    given: "guard with expression"
    when: "evaluating"
    then: "TODO: implement parser"

  - name: "named_pipeline_reference"
    description: "Named pipeline reference"
    given: "pipeline_name identifier"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "pipe typechecking basic"
    description: "Typecheck pipe expression"
    given: "Simple pipe expression"
    when: "typechecking"
    then: "types match"

  - name: "pipe desugaring two stages"
    description: "Desugar pipe to nested calls"
    given: "x |> f |> g"
    when: "desugaring"
    then: "TODO: requires AST redesign"

  - name: "guard evaluation true literal"
    description: "Guard with true literal always passes"
    given: "Guard with BoolLiteral true"
    when: "evaluating"
    then: "always_true=true, always_false=false"

  - name: "guard evaluation false literal"
    description: "Guard with false literal always fails"
    given: "Guard with BoolLiteral false"
    when: "evaluating"
    then: "always_true=false, always_false=true"

  - name: "guard trivial check"
    description: "Check if guard is trivial (constant)"
    given: "Guard with BoolLiteral true"
    when: "checking"
    then: "isTrivialGuard returns true"

  - name: "neuron state ADT exhaustiveness"
    description: "Check exhaustive match for NeuronState ADT"
    given: "ADT with Active(gf16), Inhibited, Resting(tword)"
    when: "checking exhaustiveness"
    then: "all variants covered = exhaustive"

  - name: "neural pipeline desugaring"
    description: "Neural pipeline desugaring"
    given: "Pipe expression"
    when: "desugaring"
    then: "TODO: requires AST redesign"

  - name: "pattern_enum_variant"
    description: "Pattern: enum variant with data"
    given: "Some(x) pattern"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "pattern_wildcard"
    description: "Pattern: wildcard _ matches anything"
    given: "_ pattern"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "pattern_array_literal"
    description: "Pattern: array literal [1, 2, 3]"
    given: "Array literal pattern"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "ternary_literal_trit"
    description: "Ternary literal: 'tr' for trit value"
    given: "Ternary literal"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "range_pattern_inclusive"
    description: "Range pattern: start..=end (inclusive)"
    given: "Inclusive range pattern"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "range_pattern_exclusive"
    description: "Range pattern: start..end (exclusive)"
    given: "Exclusive range pattern"
    when: "parsing"
    then: "TODO: implement parser"

  - name: "struct_pattern_with_fields"
    description: "Pattern: struct with field patterns"
    given: "Struct destructuring pattern"
    when: "parsing"

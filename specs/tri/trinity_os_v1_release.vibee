# TRINITY OS v1.0 Release Specification
name: trinity_os_release
version: "1.0.0"
language: zig
module: release

# TRINITY OS v1.0 — Production Release
# First public release with live FPGA support + Sacred Intelligence

types:
  ReleaseConfig:
    fields:
      version: String              # "1.0.0"
      branch: String               # main
      tag: String                  # v1.0.0
      prerelease: Bool
      build_metadata: String

  ReleaseArtifact:
    fields:
      name: String
      checksum_sha256: String
      size_bytes: Int
      download_url: String

  ReleaseMetrics:
    fields:
      total_commits: Int
      loc_count: Int
      test_coverage: Float         # percentage
      fpga_targets: Int
      sacred_opcodes: Int
      cli_commands: Int

behaviors:
  - name: create_v1_release
    given: All Order #017 artifacts complete
    when: Execute release workflow
    then:
      - Tag commit as v1.0.0
      - Generate release notes in Markdown
      - Create GitHub release with:
        * Source code archive
        * Pre-built binaries (macOS, Linux)
        * FPGA bitstreams (.ice files)
        * Demo videos (GIF, MP4)
        * Investor deck PDF
      - Push tag to origin

  - name: generate_release_notes
    given: Git history from v0.0.1 to v1.0.0
    when: Release notes requested
    then: Generate markdown with:
      sections:
        - "What's New in v1.0"
        - "FPGA Hardware Support"
        - "Sacred Intelligence (KOSCHEI)"
        - "Performance Benchmarks"
        - "Known Limitations"
        - "Upgrade Path"

  - name: verify_release_artifacts
    given: Release tagged
    when: Pre-release validation
    then:
      - All tests pass (zig build test)
      - FPGA bitstreams flash successfully
      - Demo commands work end-to-end
      - Investor deck renders to PDF
      - Checksums match for all binaries

  - name: publish_announcement
    given: Release live on GitHub
    when: Public announcement triggered
    then:
      - Post to X (Twitter) with demo GIF
      - Post to HackerNews with technical details
      - Update website with v1.0 banner
      - Send to research mailing lists

requirements:
  - Semantic versioning compliant
  - All tests passing before tag
  - Changelog complete
  - Hardware tested on real FPGA
  - Demo videos under 30 seconds for social

output_files:
  - docs/release_notes_v1.0.md
  - docs/CHANGELOG.md
  - docs/UPGRADE.md
  - scripts/release.sh

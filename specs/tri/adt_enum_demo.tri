// ═══════════════════════════════════════════════════════════════════════════════════
// adt_enum_demo.tri - Tri Language ADT Enum + Match + Pipe Demo (Issue #408)
// ═══════════════════════════════════════════════════════════════════════════════════
//
// Sacred formula: V = n × 3^k × π^m × φ^p × e^q
// Golden identity: φ² + 1/φ² = 3
//
// Demonstrates:
// - ADT enum (data-carrying enums like Rust)
// - Exhaustive match (compiler checks all variants)
// - Pipe operator |> (Elixir-style)
// - Named pipelines
// - Guards (Haskell-style | condition)
//
// ═════════════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// ADT ENUM - Data-carrying enums (Rust-style)
// ═════════════════════════════════════════════════════════════════════════════════════

/// Result type - can be Ok with value OR Err with message
enum Result(value, error) {
    Ok(value),
    Err(error),
}

/// Neuron state - each variant carries different data
enum NeuronState {
    Active(level: gf16),
    Inhibited,
    Resting(potential: trit27),
}

/// Quality classification
enum Quality {
    Good,
    Unstable,
    Bad,
    Unknown,
}

// ═══════════════════════════════════════════════════════════════════════
// EXHAUSTIVE MATCH - Pattern matching on all variants
// ═════════════════════════════════════════════════════════════════════════════════════

/// Match on trit value - 3-way exhaustive match
fn classify_signal(signal: trit) Quality {
    match signal {
        .pos => .Good,
        .zero => .Unknown,
        .neg => .Bad,
    }
}

/// Match on enum variant with data
fn process_neuron(neuron: NeuronState) trit {
    match neuron {
        Active(level) => {
            if level > threshold { fire() }
            else { hold() }
        },
        Inhibited => decay(phi),
        Resting(potential) => check_threshold(potential),
    }
}

/// Match with guards - Haskell-style | condition
fn classify_with_guard(value: i32) Quality {
    match value {
        v | v > 90 => .Good,
        v | v > 50 => .Unstable,
        v | v > 10 => .Bad,
        _ => .Unknown,
    }
}

// ═══════════════════════════════════════════════════════════════════════
// PIPE OPERATOR - Elixir-style |> for function chaining
// ═════════════════════════════════════════════════════════════════════════════════════

/// Single pipe: input |> func
fn process_single(input: []trit) []gf16 {
    return input |> encode_to_gf16
}

/// Multi-stage pipe: input |> f1 |> f2 |> f3
fn process_pipeline(input: []trit) Quality {
    return input
        |> encode_to_gf16
        |> normalize
        |> classify
}

/// Complex neuroanatomic flow (Phase 0.5 diagram as executable)
fn neuro_flow(input: Signal) Response {
    return input
        |> vlpfc.filter       // attention filter
        |> dlpfc.hold         // working memory
        |> vmpfc.evaluate     // value assessment
        |> dmpfc.monitor      // self-check
        |> ofc.respond        // form response
}

// ═══════════════════════════════════════════════════════════════════════
// NAMED PIPELINES - Reusable pipe chains
// ═════════════════════════════════════════════════════════════════════════════════════

/// Define named pipeline for PPL stabilization
pipeline ppl_stabilize = input
    |> phi_decay
    |> clamp
    |> validate

/// Define named pipeline for episode processing
pipeline episode_process = episode
    |> extract_features
    |> classify_quality
    |> update_window

// ═══════════════════════════════════════════════════════════════════════
// PATTERN MATCHING IN FUNCTION ARGUMENTS
// ═════════════════════════════════════════════════════════════════════════════════════

/// Multiple definitions of same function - dispatch by pattern
fn process_signal(Signal(.pos, level)) Response {
    activate(level)
}

fn process_signal(Signal(.neg, _)) Response {
    inhibit()
}

fn process_signal(Signal(.zero, _)) Response {
    hold()
}

// ═══════════════════════════════════════════════════════════════════════
// RESULT TYPE - No exceptions, errors as values
// ═════════════════════════════════════════════════════════════════════════════════════

/// Load episode - returns Result, never throws
fn load_episode(id: tword) Result(Episode, NeuroError) {
    // ...
}

/// Caller MUST handle both cases (exhaustive)
fn process_episode(id: tword) trit {
    match load_episode(id) {
        Ok(ep) => process(ep),
        Err(e) => log_failure(e),
    }
}

// ═══════════════════════════════════════════════════════════════════════
// ARRAY PATTERNS
// ═════════════════════════════════════════════════════════════════════════════════════

/// Match on array patterns
fn decode_trit3(data: [3]trit) trit27 {
    match data {
        [a, b, c] => encode_trit3(a, b, c),
        _ => error_invalid_data,
    }
}

/// Match with wildcard in array
fn check_prefix(data: []trit) bool {
    match data {
        [.pos, .pos, ...] => true,
        _ => false,
    }
}

// ═══════════════════════════════════════════════════════════════════════
// STRUCT PATTERNS
// ═════════════════════════════════════════════════════════════════════════════════════

struct Vec3 {
    x: gf16,
    y: gf16,
    z: gf16,
}

fn normalize_vec3(vec: Vec3) Vec3 {
    match vec {
        Vec3 { x: 0, y: 0, z: 0 } => Vec3 { x: 0, y: 0, z: 0 },
        Vec3 { x, y, z } => {
            const len = sqrt(x*x + y*y + z*z);
            Vec3 { x: x/len, y: y/len, z: z/len }
        },
    }
}

// ═══════════════════════════════════════════════════════════════════════
// RANGE PATTERNS
// ═════════════════════════════════════════════════════════════════════════════════════

/// Match on ranges
fn classify_value(value: i32) Category {
    match value {
        0..=10 => .Low,
        11..=50 => .Medium,
        51..=100 => .High,
        _ => .Extreme,
    }
}

/// Exclusive range
fn check_index(idx: usize) bool {
    match idx {
        0..10 => true,    // 0-9
        _ => false,
    }
}

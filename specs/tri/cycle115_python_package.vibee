# ============================================================================
# cycle115_python_package - Python Package Production Build for PyPI
# Golden Identity: phi^2 + 1/phi^2 = 3 = TRINITY
# Sacred Formula: V = n x 3^k x pi^m x phi^p x e^q
# ============================================================================

name: cycle115_python_package
version: "1.0.0"
language: zig
module: python_package

description: |
  Production-ready Python package build system for publishing Trinity VSA to PyPI.
  Complete packaging infrastructure with wheel/sdist generation, FFI compilation,
  automated testing, and PyPI deployment via twine.

  Package: trinity-core (PyPI)
  Alternative name: python-trinity

  Core Features:
  - Automated setup.py and pyproject.toml generation
  - Wheel (.whl) and source distribution (.tar.gz) builds
  - Cross-platform binary wheels (manylinux, macos, win64)
  - FFI compilation from Zig shared library (.so/.dylib/.dll)
  - Test suite with pytest
  - Documentation generation (sphinx)
  - PyPI upload with twine (production + testpypi)
  - Version management and Git tagging
  - CI/CD integration (GitHub Actions)

  Architecture:
  1. Zig → C shared library (libtrinity.so/.dylib/.dll)
  2. Python package structure (trinity/)
  3. Build system (setuptools + pyproject.toml)
  4. FFI wrapper (ctypes/cffi)
  5. Tests (pytest)
  6. Docs (sphinx)
  7. Deploy (twine to PyPI)

constants:
  # Package metadata
  PACKAGE_NAME: "trinity-core"
  PACKAGE_ALT_NAME: "python-trinity"
  PACKAGE_VERSION: "1.0.0"
  PYPI_MIN_PYTHON: "3.10"
  PYPI_MAX_PYTHON: "3.13"

  # PyPI URLs
  PYPI_PRODUCTION_URL: "https://pypi.org/project/trinity-core/"
  PYPI_TEST_URL: "https://test.pypi.org/project/trinity-core/"
  PYPI_UPLOAD_URL: "https://upload.pypi.org/legacy/"
  PYPI_TEST_UPLOAD_URL: "https://test.pypi.org/legacy/"

  # Build artifacts
  BUILD_DIR: "python/build"
  DIST_DIR: "python/dist"
  WHEEL_OUTPUT: "python/dist/*.whl"
  SDIST_OUTPUT: "python/dist/*.tar.gz"

  # Zig compilation
  ZIG_SHARED_LIB: "libtrinity"
  ZIG_LIB_EXT_SO: ".so"
  ZIG_LIB_EXT_DYLIB: ".dylib"
  ZIG_LIB_EXT_DLL: ".dll"
  ZIG_TARGET_LINUX: "x86_64-linux-gnu"
  ZIG_TARGET_MACOS: "x86_64-macos-gnu"
  ZIG_TARGET_MACOS_ARM: "aarch64-macos-gnu"
  ZIG_TARGET_WINDOWS: "x86_64-windows-msvc"

  # Dependencies
  DEP_SETUPTOOLS: ">=70.0.0"
  DEP_WHEEL: ">=0.43.0"
  DEP_PYPROJECT_TOML: ">=1.0.0"
  DEP_TWINE: ">=5.0.0"
  DEP_PYTEST: ">=8.0.0"
  DEP_SPHINX: ">=7.0.0"
  DEP_CFFI: ">=1.16.0"
  DEP_CTYPES: "builtin"

  # Versioning
  VERSION_MAJOR: 1
  VERSION_MINOR: 0
  VERSION_PATCH: 0
  VERSION_PRERELEASE: ""
  VERSION_DEV: ""

  # Documentation
  DOCS_SOURCE_DIR: "python/docs/source"
  DOCS_BUILD_DIR: "python/docs/build"
  DOCS_OUTPUT_HTML: "python/docs/build/html"

  # Testing
  TEST_DIR: "python/tests"
  TEST_COVERAGE_MIN: 80
  TEST_TIMEOUT_SEC: 300

types:
  PyPIConfig:
    description: "PyPI package configuration"
    fields:
      package_name: String
      version: String
      author: String
      author_email: String
      description: String
      long_description: String
      long_description_content_type: String
      url: String
      project_urls: Map<String, String>
      license: String
      classifiers: List<String>
      keywords: List<String>
      python_requires: String
      install_requires: List<String>
      extras_require: Map<String, List<String>>
      entry_points: Map<String, String>

  WheelBuilder:
    description: "Wheel distribution builder"
    fields:
      config: PyPIConfig
      build_dir: String
      dist_dir: String
      platform_tags: List<String>
      python_tags: List<String>
      abi_tags: List<String>
      shared_lib_path: String
      include_tests: Bool
      include_docs: Bool
      strip_debug: Bool
      optimize_level: UInt8

  SDistBuilder:
    description: "Source distribution builder"
    fields:
      config: PyPIConfig
      build_dir: String
      dist_dir: String
      source_files: List<String>
      exclude_patterns: List<String>
      include_tests: Bool
      include_docs: Bool

  FFICompiler:
    description: "Zig to shared library compiler"
    fields:
      zig_executable: String
      source_files: List<String>
      output_name: String
      target_triple: String
      optimization: String
      dynamic: Bool
      enable_pic: Bool
      strip_symbols: Bool
      output_path: String

  PythonModule:
    description: "Python module structure"
    fields:
      module_name: String
      package_dir: String
      init_py: String
      core_modules: List<String>
      ffi_bridge: String
      tests_dir: String
      docs_dir: String
      examples_dir: String

  SetupPyGenerator:
    description: "setup.py script generator"
    fields:
      config: PyPIConfig
      output_path: String
      use_setuptools: Bool
      custom_build_ext: Bool
      zig_build_integration: Bool

  PyProjectTomlGenerator:
    description: "pyproject.toml generator (PEP 517/518)"
    fields:
      config: PyPIConfig
      output_path: String
      build_system: String
      backend: String
      includes_project: Bool

  TwineConfig:
    description: "Twine upload configuration"
    fields:
      repository_url: String
      username: String
      password: String
      skip_existing: Bool
      verbose: Bool
      signature: Bool
      identity: String
      sign_with: String
      dist_dir: String

  TestSuite:
    description: "Pytest test suite configuration"
    fields:
      test_dir: String
      python_paths: List<String>
      coverage_config: String
      timeout: UInt32
      min_coverage: UInt8
      markers: Map<String, String>
      fixtures: List<String>

  SphinxConfig:
    description: "Sphinx documentation generator"
    fields:
      source_dir: String
      build_dir: String
      project: String
      copyright: String
      author: String
      version: String
      extensions: List<String>
      html_theme: String
      html_output: String

  VersionManager:
    description: "Semantic version management"
    fields:
      major: UInt32
      minor: UInt32
      patch: UInt32
      prerelease: String
      dev: String
      git_tag_prefix: String
      commit_on_bump: Bool
      push_on_bump: Bool

  BuildArtifact:
    description: "Build output artifact"
    fields:
      artifact_type: String        # "wheel" or "sdist"
      filename: String
      filepath: String
      size_bytes: UInt64
      sha256: String
      platform: String
      python_version: String
      created_at: String

  UploadResult:
    description: "PyPI upload result"
    fields:
      success: Bool
      url: String
      artifacts: List<String>
      duration_sec: UInt32
      error_message: String

  CIBuilder:
    description: "CI/CD pipeline configuration"
    fields:
      platform: String
      github_actions: Bool
      gitlab_ci: Bool
      build_matrix: List<String>
      test_steps: List<String>
      deploy_step: Bool

behaviors:
  # ============================================================
  # PACKAGE STRUCTURE (5 behaviors)
  # ============================================================

  - name: create_package_structure
    given: Package name and output directory
    when: Initializing new Python package
    then: Create standard package layout with trinity/, tests/, docs/
    implementation: |
        // Create directory structure:
        // python/
        //   ├── trinity/
        //   │   ├── __init__.py
        //   │   ├── core.py
        //   │   ├── vsa.py
        //   │   └── _libtrinity.so  (FFI library)
        //   ├── tests/
        //   │   ├── test_core.py
        //   │   └── test_vsa.py
        //   ├── docs/
        //   │   └── source/
        //   ├── examples/
        //   ├── setup.py
        //   ├── pyproject.toml
        //   ├── README.md
        //   ├── LICENSE
        //   ├── MANIFEST.in
        //   └── requirements.txt

  - name: generate_init_py
    given: Package metadata and exports
    when: Creating trinity/__init__.py
    then: Generate module with version, exports, and FFI loader
    implementation: |
        // Generate __init__.py with:
        // - __version__ = "1.0.0"
        // - from trinity.core import Hypervector, bind, unbind, bundle
        // - from trinity.vsa import cosine_similarity, hamming_distance
        // - _load_shared_library() function using ctypes.util.find_library

  - name: create_manifest
    given: Package files and patterns
    when: Building source distribution
    then: Create MANIFEST.in with include/exclude patterns
    implementation: |
        // Generate MANIFEST.in:
        // include README.md
        // include LICENSE
        // include requirements.txt
        // recursive-include trinity *.py
        // recursive-include tests *.py
        // recursive-include docs *.rst *.md
        // global-exclude __pycache__
        // global-exclude *.pyc
        // exclude trinity/_libtrinity.so

  - name: create_readme
    given: Package description and examples
    when: Generating package documentation
    then: Create README.md with installation, usage, examples
    implementation: |
        // Generate README.md:
        // # Trinity Core - Hyperdimensional Computing in Python
        //
        // ## Installation
        // pip install trinity-core
        //
        // ## Quick Start
        // ```python
        // from trinity import Hypervector, bind, cosine_similarity
        //
        // hv = Hypervector.random(10000)
        // result = bind(hv, hv)
        // sim = cosine_similarity(hv, hv)
        // ```
        //
        // ## Features
        // - Hypervectors with 10K+ dimensions
        // - VSA operations: bind, unbind, bundle
        // - Similarity metrics
        // - Sacred mathematics (φ, π, e)

  - name: create_license
    given: License type (MIT, Apache-2.0)
    when: Packaging for PyPI
    then: Generate LICENSE file with copyright
    implementation: |
        // Generate LICENSE file:
        // MIT License
        //
        // Copyright (c) 2026 Trinity Contributors
        //
        // Permission is hereby granted, free of charge, to any person...

  # ============================================================
  # BUILD CONFIGURATION (4 behaviors)
  # ============================================================

  - name: generate_setup_py
    given: PyPIConfig with all metadata
    when: Creating setup.py for setuptools
    then: Generate complete setup.py with custom build_ext for Zig
    implementation: |
        // Generate setup.py:
        // from setuptools import setup, Extension
        // from setuptools.command.build_ext import build_ext
        // import subprocess
        //
        // class BuildZigExtension(build_ext):
        //     def build_extension(self, ext):
        //         # Compile Zig to shared library
        //         subprocess.run(['zig', 'build-lib',
        //                         '-dynamic', '-OReleaseFast',
        //                         '-femit-bin=' + output_path,
        //                         'src/trinity.zig'])
        //
        // setup(
        //     name="trinity-core",
        //     version="1.0.0",
        //     packages=['trinity'],
        //     cmdclass={'build_ext': BuildZigExtension},
        //     install_requires=[],
        //     python_requires='>=3.10',
        // )

  - name: generate_pyproject_toml
    given: PyPIConfig and build system choice
    when: Creating pyproject.toml (PEP 517)
    then: Generate TOML with build-system, project, tool configs
    implementation: |
        // Generate pyproject.toml:
        // [build-system]
        // requires = ["setuptools>=70", "wheel"]
        // build-backend = "setuptools.build_meta"
        //
        // [project]
        // name = "trinity-core"
        // version = "1.0.0"
        // description = "Hyperdimensional Computing with VSA"
        // readme = "README.md"
        // requires-python = ">=3.10"
        // license = {text = "MIT"}
        //
        // [project.urls]
        // Homepage = "https://github.com/gHashTag/trinity"
        // Documentation = "https://trinity.readthedocs.io"
        //
        // [tool.pytest.ini_options]
        // testpaths = ["tests"]
        //
        // [tool.coverage.run]
        // source = ["trinity"]

  - name: generate_requirements
    given: Production and development dependencies
    when: Creating requirements.txt
    then: List runtime and optional dependencies
    implementation: |
        // Generate requirements.txt:
        // # Runtime dependencies (none for pure FFI)
        // cffi>=1.16.0  # optional, for advanced FFI
        //
        // # Development dependencies
        // pytest>=8.0.0
        // pytest-cov>=5.0.0
        // sphinx>=7.0.0
        // twine>=5.0.0
        // build>=0.10.0

  - name: create_makefile
    given: Build commands and targets
    when: Setting up build automation
    then: Generate Makefile with build/test/upload targets
    implementation: |
        // Generate Makefile:
        // .PHONY: build test upload clean
        //
        // build:
        // 	python -m build
        //
        // test:
        // 	pytest tests/
        //
        // upload:
        // 	twine upload dist/*
        //
        // upload-test:
        // 	twine upload --repository testpypi dist/*
        //
        // clean:
        // 	rm -rf build/ dist/ *.egg-info

  # ============================================================
  # ZIG COMPILATION (3 behaviors)
  # ============================================================

  - name: compile_zig_shared_lib
    given: Zig source files and target platform
    when: Building FFI shared library
    then: Compile libtrinity.so/.dylib/.dll with C ABI exports
    implementation: |
        // Export command:
        // zig build-lib \
        //   -dynamic \
        //   -OReleaseFast \
        //   -fPIC \
        //   -femit-bin=python/trinity/_libtrinity.so \
        //   -target x86_64-linux-gnu \
        //   src/trinity.zig
        //
        // Must export functions with C ABI:
        // export fn trinity_hypervector_create(...) *Hypervector

  - name: compile_cross_platform_wheels
    given: List of target platforms
    when: Building for PyPI (manylinux, macos, win64)
    then: Compile shared libraries for each platform
    implementation: |
        // Build matrix:
        // - manylinux_x86_64: zig build-lib -target x86_64-linux-gnu
        // - manylinux_aarch64: zig build-lib -target aarch64-linux-gnu
        // - macos_x86_64: zig build-lib -target x86_64-macos-gnu
        // - macos_arm64: zig build-lib -target aarch64-macos-gnu
        // - win_x86_64: zig build-lib -target x86_64-windows-msvc

  - name: optimize_zig_library
    given: Shared library build
    when: Preparing for production
    then: Strip symbols, optimize size
    implementation: |
        // Optimize with:
        // zig build-lib \
        //   -OReleaseSmall \
        //   -fstrip \
        //   -femit-bin=python/trinity/_libtrinity.so \
        //   src/trinity.zig
        //
        // Post-process with strip(1):
        // strip --strip-unneeded python/trinity/_libtrinity.so

  # ============================================================
  # WHEEL BUILDING (4 behaviors)
  # ============================================================

  - name: build_wheel
    given: PyPIConfig and shared library
    when: Running python -m build
    then: Generate .whl file with platform tags
    implementation: |
        // Build wheel:
        // python -m build --wheel
        //
        // Output:
        // dist/trinity_core-1.0.0-cp311-cp311-linux_x86_64.whl
        //
        // Wheel contains:
        // trinity/__init__.py
        // trinity/core.py
        // trinity/_libtrinux.so  (platform-specific)

  - name: build_sdist
    given: Package source files
    when: Building source distribution
    then: Generate .tar.gz with setup.py and sources
    implementation: |
        // Build sdist:
        // python -m build --sdist
        //
        // Output:
        // dist/trinity_core-1.0.0.tar.gz
        //
        // Contains source only (user compiles Zig library)

  - name: build_pure_python_wheel
    given: Package without precompiled binaries
    when: Building universal wheel
    then: Generate py3-none-any.whl
    implementation: |
        // Build pure Python wheel:
        // python setup.py bdist_wheel --universal
        //
        // Output:
        // dist/trinity_core-1.0.0-py3-none-any.whl
        //
        // Requires user to have Zig installed

  - name: verify_wheel_structure
    given: Built .whl file
    when: Quality check before upload
    then: Extract and validate contents, metadata
    implementation: |
        // Verify with:
        // unzip -l dist/trinity_core-1.0.0-*.whl
        //
        // Check for:
        // - trinity/__init__.py
        // - trinity-1.0.0.dist-info/METADATA
        // - trinity-1.0.0.dist-info/WHEEL
        // - trinity-1.0.0.dist-info/RECORD

  # ============================================================
  # TESTS (3 behaviors)
  # ============================================================

  - name: generate_test_suite
    given: Package modules
    when: Creating test structure
    then: Generate pytest tests with fixtures
    implementation: |
        // Generate tests/test_core.py:
        // import pytest
        // from trinity import Hypervector, bind, cosine_similarity
        //
        // def test_hypervector_creation():
        //     hv = Hypervector.random(10000)
        //     assert hv.dimension == 10000

        //   --verbose
        //
        // Test install:
        // pip install --index-url https://test.pypi.org/simple/ trinity-core

  - name: verify_upload
    given: Uploaded package
    when: Post-deployment verification
    then: Install and test from PyPI
    implementation: |
        // Verify install:

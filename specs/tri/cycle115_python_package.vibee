        //   --verbose \
        //   --skip-existing
        //
        // Result:
        // https://pypi.org/project/trinity-core/1.0.0/

  - name: upload_to_testpypi
    given: Built wheels and sdists
    when: Testing deployment
    then: Upload to test.pypi.org
    implementation: |
        // Upload to test:
        // twine upload dist/* \

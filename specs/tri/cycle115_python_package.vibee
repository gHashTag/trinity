cli:
  flags:
    - name: package-name
      short: n
      type: String
      default: "trinity-core"
      description: "Package name for PyPI"

    - name: version
      short: v
      type: String
      default: "1.0.0"
      description: "Package version"

    - name: build-wheel
      short: w
      type: Bool
      default: true
      description: "Build wheel distribution"

    - name: build-sdist
      short: s
      type: Bool
      default: true
      description: "Build source distribution"

    - name: platform
      short: p
      type: String
      default: "auto"
      description: "Target platform (linux/macos/windows/auto)"

    - name: python-version
      short: P
      type: String
      default: "3.11"
      description: "Target Python version"

    - name: upload
      short: u
      type: Bool
      default: false
      description: "Upload to PyPI after build"

    - name: test-pypi
      short: t
      type: Bool
      default: false
      description: "Upload to TestPyPI instead of production"

    - name: run-tests
      short: T
      type: Bool
      default: true
      description: "Run test suite before upload"

    - name: build-docs
      short: d
      type: Bool
      default: false
      description: "Build Sphinx documentation"

    - name: optimize
      short: O
      type: String
      default: "ReleaseFast"
      description: "Zig optimization mode (Debug/ReleaseFast/ReleaseSmall/ReleaseSafe)"

test_cases:
  # Package structure
  - name: create_package_layout
    given: "package_name='trinity-core'"
    expected: "python/trinity/, python/tests/, python/docs/ directories created"

  - name: generate_init_py
    given: "version='1.0.0', exports=['Hypervector', 'bind']"
    expected: "trinity/__init__.py with __version__ and imports"

  # Build configuration
  - name: generate_setup_py_valid
    given: "PyPIConfig with all required fields"
    expected: "setup.py passes setuptools validation"

  - name: generate_pyproject_toml_pep517
    given: "PyPIConfig"
    expected: "pyproject.toml with [build-system] section"

  # Zig compilation
  - name: compile_linux_shared_lib
    given: "target='x86_64-linux-gnu'"
    expected: "python/trinity/_libtrinux.so"

  - name: compile_macos_shared_lib
    given: "target='x86_64-macos-gnu'"
    expected: "python/trinity/_libtrinity.dylib"

  - name: compile_windows_shared_lib
    given: "target='x86_64-windows-msvc'"
    expected: "python/trinity/_libtrinity.dll"

  # Wheel building
  - name: build_pure_wheel
    given: "package with setup.py"
    expected: "dist/trinity_core-1.0.0-py3-none-any.whl"

  - name: build_platform_wheel
    given: "precompiled shared library"
    expected: "dist/trinity_core-1.0.0-cp311-cp311-linux_x86_64.whl"

  - name: build_sdist_tarball
    given: "source files"
    expected: "dist/trinity_core-1.0.0.tar.gz"

  # Tests
  - name: generate_pytest_suite
    given: "package modules"
    expected: "tests/test_core.py with pytest fixtures"

  - name: run_tests_passing
    given: "built package"
    expected: "pytest exit code 0, coverage >= 80%"

  # Documentation
  - name: generate_sphinx_conf
    given: "project metadata"
    expected: "docs/source/conf.py with extensions"

  - name: build_html_docs
    given: "sphinx config and api docs"
    expected: "docs/build/html/index.html"

  # PyPI upload
  - name: twine_upload_testpypi
    given: "wheel and testpypi credentials"
    expected: "package at https://test.pypi.org/project/trinity-core/"

  - name: verify_pypi_install
    given: "uploaded package"
    expected: "pip install trinity-core succeeds"

  # Version management
  - name: bump_patch_version
    given: "version='1.0.0', bump_type='patch'"
    expected: "version='1.0.1' in all files"

  - name: create_git_tag_v100
    given: "version='1.0.0'"
    expected: "annotated git tag v1.0.0"

  # Quality checks
  - name: wheel_compatibility_check
    given: "built wheel"
    expected: "check-wheel-contents passes"

  - name: lint_python_pass
    given: "trinity/ source"
    expected: "ruff and mypy pass"

  # ============================================================
  # CI/CD (2 behaviors)
  # ============================================================

  - name: generate_github_actions
    given: Build matrix and test steps
    when: Setting up CI/CD
    then: Create .github/workflows/build.yml
    implementation: |
        // Generate .github/workflows/build.yml:

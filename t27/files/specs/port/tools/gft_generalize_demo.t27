module GftGeneralizeDemo;

const BIAS : i32 = 40;

// f2gft: convert Python-style float to GF-T16
fn f2gft(x: f32) -> u32 {
    if x == 0.0 { return 0; }
    let s: u32;
    if x < 0.0 {
        s = 1;
    } else {
        s = 0;
    }
    let ax: f32;
    if x < 0.0 {
        ax = -x;
    } else {
        ax = x;
    }
    let exp: i32 = ax.log2().floor() as i32; // TODO: check if log2 is available
    let frac: f32 = ax / (2.0 ** exp as f32);
    let mut mant: i32 = ((frac - 1.0) * 512.0).round() as i32;
    let mut off: i32 = exp + BIAS;
    if mant == 512 { mant = 0; off += 1; }
    if off < 1 { off = 1; mant = 0; }
    if off > 80 { off = 80; mant = 511; }
    return (s << 16) | (off << 9) | (mant as u32);
}

// gft_value: convert GF-T16 to Python-style float
fn gft_value(u: u32) -> f32 {
    if u == 0 { return 0.0; }
    let s: f32;
    if (u >> 16) == 1 {
        s = -1.0;
    } else {
        s = 1.0;
    }
    let mag: u32 = u & 65535;
    let mantissa: f32 = (mag & 511) as f32 / 512.0;
    let exponent: i32 = (mag >> 9) as i32 - BIAS;
    return s * (1.0 + mantissa) * (2.0 ** exponent as f32);
}

// magadd: magnitude addition (used by sadd)
fn magadd(a: u32, b: u32) -> u32 {
    let ao: i32 = (a >> 9) as i32;
    let am: i32 = (a & 511) as i32;
    let bo: i32 = (b >> 9) as i32;
    let bm: i32 = (b & 511) as i32;
    let (ho, hm, lo, lm): (i32, i32, i32, i32) = if ao >= bo {
        (ao, am, bo, bm)
    } else {
        (bo, bm, ao, am)
    };
    let hs: i32 = 512 + hm;
    let ls: i32 = 512 + lm;
    let d: i32 = ho - lo;
    let d_clamped: i32 = if d > 11 { 11 } else { d };
    let losh: i32 = ls >> d_clamped;
    let rem: i32 = ls - (losh << d_clamped);
    let s: i32 = hs + losh;
    let mut off: i32 = ho;
    let mut mant: i32 = s - 512;
    if s >= 1024 {
        let g: i32 = s & 1;
        let pre: i32 = s >> 1;
        mant = pre - 512;
        if g == 1 {
            if rem > 0 {
                mant = mant + 1;
            } else {
                if (pre & 1) == 1 {
                    mant = mant + 1;
                }
            }
        }
        off = ho + 1;
        if off > 80 { off = 80; }
    } else {
        let t: i32 = rem << 1;
        let hf: i32 = 1 << d_clamped;
        if t > hf {
            mant = mant + 1;
        } else if t == hf {
            if (s & 1) == 1 {
                mant = mant + 1;
            }
        }
    }
    if mant >= 512 {
        mant = 0;
        off = off + 1;
        if off > 80 { off = 80; }
    }
    return (off << 9) | (mant as u32);
}

// magsub: magnitude subtraction (used by sadd)
fn magsub(hi: u32, lo: u32) -> u32 {
    if hi == lo { return 0; }
    let ho: i32 = (hi >> 9) as i32;
    let hm: i32 = (hi & 511) as i32;
    let lo_o: i32 = (lo >> 9) as i32;
    let lm: i32 = (lo & 511) as i32;
    let d: i32 = ho - lo_o;
    let mut la: i32 = 0;
    let mut sticky: i32 = 0;
    if d < 0 {
        return 0; // hi<lo: spec discards this call (recomputes magsub(mb,ma))
    }
    if d >= 26 {
        la = 0;
        sticky = 1;
    } else {
        let ls: i32 = (512 + lm) << 14;
        la = ls >> d;
        if (ls - (la << d)) > 0 {
            sticky = 1;
        }
    }
    let diff: i32 = (512 + hm) << 14 - la;
    let mut off: i32 = ho;
    let mut cap: i32 = 12;
    if off - 1 < cap { cap = off - 1; }
    if cap < 0 { cap = 0; }
    let mut sh: i32 = 0;
    if diff != 0 {
        let mut t: i32 = diff;
        if t < 65536 { if sh + 8 <= cap { t = t << 8; sh = sh + 8; } }
        if t < 1048576 { if sh + 4 <= cap { t = t << 4; sh = sh + 4; } }
        if t < 4194304 { if sh + 2 <= cap { t = t << 2; sh = sh + 2; } }
        if t < 8388608 { if sh + 1 <= cap { t = t << 1; sh = sh + 1; } }
    }
    diff = diff << sh;
    off = off - sh;
    let q: i32 = diff >> 14;
    let rem: i32 = diff - (q << 14);
    let half: i32 = 8192;
    let mut mant: i32 = q - 512;
    if rem > half {
        mant = mant + 1;
    } else if rem == half {
        if sticky == 1 {
            mant = mant + 1;
        } else {
            if (q & 1) == 1 {
                mant = mant + 1;
            }
        }
    }
    if mant >= 512 {
        mant = 0;
        off = off + 1;
        if off > 80 { off = 80; }
    }
    return (off << 9) | (mant as u32);
}

// sadd: signed addition
fn sadd(a: u32, b: u32) -> u32 {
    if a == 0 { return b; }
    if b == 0 { return a; }
    let sa: u32 = a >> 16;
    let ma: u32 = a & 65535;
    let sb: u32 = b >> 16;
    let mb: u32 = b & 65535;
    if sa == sb {
        return ((sa << 16) | magadd(ma, mb)) & 0xffffffff;
    }
    let bsign: u32 = sa;
    let mut r: u32 = magsub(ma, mb);
    if ma < mb {
        r = magsub(mb, ma);
        bsign = sb;
    }
    if r == 0 { return 0; }
    return ((bsign << 16) | r) & 0xffffffff;
}

// smul: signed multiplication
fn smul(a: u32, b: u32) -> u32 {
    if a == 0 || b == 0 { return 0; }
    let sign: u32 = ((a >> 16) & 1) ^ ((b >> 16) & 1);
    let mag: u32 = magmul(a & 65535, b & 65535);
    if mag == 0 { return 0; }
    return (sign << 16) | mag;
}

// magmul: magnitude multiplication (used by smul)
fn magmul(a16: u32, b16: u32) -> u32 {
    let ao: i32 = (a16 >> 9) as i32;
    let am: i32 = (a16 & 511) as i32;
    let bo: i32 = (b16 >> 9) as i32;
    let bm: i32 = (b16 & 511) as i32;
    let mut prod: i32 = (512 + am) * (512 + bm);
    let mut carry: i32 = if prod >= 524288 { 1 } else { 0 };
    let mut q: i32;
    let mut r: i32;
    let mut half: i32;
    if carry != 0 {
        q = prod >> 10;
        r = prod & 1023;
        half = 512;
    } else {
        q = prod >> 9;
        r = prod & 511;
        half = 256;
    }
    let mut mant: i32 = q - 512;
    if r > half {
        mant = mant + 1;
    } else if r == half {
        if (q & 1) == 1 {
            mant = mant + 1;
        }
    }
    let sm_: i32 = ao + bo + carry;
    let mut out_off: i32 = 0;
    if sm_ >= 40 {
        out_off = if sm_ - 40 > 80 { 80 } else { sm_ - 40 };
    }
    if mant >= 512 {
        mant = 0;
        out_off = if out_off + 1 > 80 { 80 } else { out_off + 1 };
    }
    return (out_off << 9) | (mant as u32);
}

// neg: negation
fn neg(v: u32) -> u32 {
    if v == 0 { return 0; }
    return v ^ 65536;
}

// exp2: approximate base-2 exponential
fn exp2(x: u32) -> u32 {
    if x == 0 { return 20480; }
    let ng: u32 = (x >> 16) & 1;
    let off_in: u32 = (x >> 9) & 127;
    let mant_in: u32 = x & 511;
    if off_in >= 48 {
        if ng == 1 { return 512; } else { return (80 << 9) | 511; }
    }
    let num: u32 = 512 + mant_in;
    let sh: i32 = (off_in as i32) - 33;
    let mq: u32;
    if sh >= 0 {
        mq = num << sh as u32;
    } else {
        mq = num >> ((-sh) as u32);
    }
    let ki: u32 = mq >> 16;
    let ff: u32 = mq & 65535;
    let mut k: i32;
    let mut f: u32;
    if ng == 1 {
        k = if ff == 0 { -(ki as i32) } else { -((ki + 1) as i32) };
        f = if ff == 0 { 0 } else { 65536 - ff };
    } else {
        k = ki as i32;
        f = ff;
    }
    let mut mant: u32 = pow2_frac(f as u32);
    let mut off: i32 = k + 40;
    if off < 1 { off = 1; }
    if off > 80 { off = 80; }
    return (off << 9) | mant;
}

// pow2_frac: helper for exp2
fn pow2_frac(f: u32) -> u32 {
    let mut p: u32 = 6;
    let arr: [u32; 4] = [29, 123, 354];
    for i in 0..3 {
        let c: u32 = arr[i];
        p = ((p * f + 32768) >> 16) + c; // H=1<<15 = 32768
    }
    p = ((p * f + 32768) >> 16);
    if p > 511 { p = 511; }
    return p;
}

// recip: reciprocal
fn recip(x: u32) -> u32 {
    if x == 0 { return (80 << 9) | 511; }
    let s: u32 = (x >> 16) & 1;
    let o: u32 = (x >> 9) & 127;
    let m: u32 = x & 511;
    let den: u32 = 512 + m;
    let mut mp: i32 = (524288 + (den >> 1)) / den - 512;
    let mut off: i32 = 79 - (o as i32);
    if mp >= 512 {
        mp = mp - 512;
        off = off + 1;
    }
    if off < 1 {
        off = 1;
        mp = 0;
    }
    if off > 80 {
        off = 80;
        mp = 511;
    }
    return (s << 16) | (off << 9) | (mp as u32);
}

// softmax: compute softmax of four logits for index sel
fn softmax(ls: [u32; 4], sel: u8) -> u32 {
    let mut mx: u32 = ls[0];
    for i in 1..4 {
        if gt(ls[i], mx) == 1 {
            mx = ls[i];
        }
    }
    let mut es: [u32; 4] = [0; 4];
    for i in 0..4 {
        es[i] = sadd(ls[i], neg(mx));
        es[i] = exp2(es[i]);
    }
    let mut S: u32 = sadd(sadd(es[0], es[1]), sadd(es[2], es[3]));
    let r: u32 = recip(S);
    let mut tmp: u32 = magmul(es[sel as u32] & 65535, r & 65535);
    return tmp & 0xffff;
}

// gt: greater than (used by softmax)
fn gt(a: u32, b: u32) -> u8 {
    let ca: u8 = cat(a);
    let cb: u8 = cat(b);
    if ca != cb {
        return if ca > cb { 1 } else { 0 };
    }
    let ma: u32 = a & 65535;
    let mb: u32 = b & 65535;
    if ca == 2 {
        return if ma > mb { 1 } else { 0 };
    }
    if ca == 0 {
        return if ma < mb { 1 } else { 0 };
    }
    return 0;
}

// cat: category (used by gt)
fn cat(a: u32) -> u8 {
    if a == 0 { return 1; }
    return if (a >> 16) == 0 { 2 } else { 0 };
}

// quadrant: return quadrant of point (x0, x1)
fn quadrant(x0: f32, x1: f32) -> u8 {
    if x0 >= 0.0 && x1 >= 0.0 { return 0; }
    if x0 < 0.0 && x1 >= 0.0 { return 1; }
    if x0 < 0.0 && x1 < 0.0 { return 2; }
    return 3;
}

// gen: generate n random points with quadrant label
fn gen(n: u32, rng: &mut Random) -> [((f32, f32), u8); n] {
    let mut pts: [((f32, f32), u8); n] = [((0.0, 0.0), 0); n];
    let mut i: u32 = 0;
    while i < n {
        let x0: f32 = rng.uniform(-1.0, 1.0);
        let x1: f32 = rng.uniform(-1.0, 1.0);
        if x0.abs() < 0.15 || x1.abs() < 0.15 {
            continue;
        }
        pts[i] = ((x0, x1), quadrant(x0, x1));
        i = i + 1;
    }
    return pts;
}

// forward: compute logits for weights W and point x
fn forward(W: [[u32; 2]; 4], x: [f32; 2]) -> [u32; 4] {
    let mut out: [u32; 4] = [0; 4];
    for c in 0..4 {
        let mut acc: u32 = 0;
        for j in 0..2 {
            acc = sadd(acc, smul(W[c][j], f2gft(x[j])));
        }
        out[c] = acc;
    }
    return out;
}

// accuracy: compute accuracy of weights W on data
fn accuracy(W: [[u32; 2]; 4], data: [((f32, f32), u8); N]) -> f32 {
    let mut ok: u32 = 0;
    for i in 0..data.len() {
        let ((x0, x1), t) = data[i];
        let lg: [u32; 4] = forward(W, [f2gft(x0), f2gft(x1)]);
        let mut pred: u8 = 0;
        let mut max_val: u32 = lg[0];
        for c in 1..4 {
            if lg[c] > max_val {
                max_val = lg[c];
                pred = c as u8;
            }
        }
        if pred == t {
            ok = ok + 1;
        }
    }
    return (ok as f32) / (data.len() as f32);
}

// main: training loop
fn main() {
    let mut rng: Random = Random::new(3201);
    let train: [((f32, f32), u8); 120] = gen(120, &mut rng);
    let test: [((f32, f32), u8); 60] = gen(60, &mut rng);
    let mut W: [[u32; 2]; 4] = [[0; 2]; 4];
    for c in 0..4 {
        for j in 0..2 {
            W[c][j] = f2gft(rng.uniform(-0.2, 0.2));
        }
    }
    let eta_g: u32 = f2gft(0.2);
    // Print header
    print("train={} test={} points (2D, 4 quadrant classes)", train.len(), test.len());
    print("{:>5} {:>10} {:>9}", "epoch", "train_acc", "test_acc");
    print("{:5} {:>10.3f} {:>9.3f}", 0, accuracy(W, train), accuracy(W, test));
    for ep in 1..25 {
        let mut rng_epoch: Random = Random::new(ep);
        // Shuffle train using rng_epoch
        // We'll implement a simple shuffle by swapping
        let mut shuffled: [((f32, f32), u8); 120] = train;
        for i in 0..train.len() {
            let j: u32 = rng_epoch.uniform(0, (train.len() - 1) as u32);
            let tmp: ((f32, f32), u8) = shuffled[i];
            shuffled[i] = shuffled[j];
            shuffled[j] = tmp;
        }
        for i in 0..shuffled.len() {
            let ((x0, x1), t) = shuffled[i];
            let xg: [f32; 2] = [f2gft(x0), f2gft(x1)];
            let lg: [u32; 4] = forward(W, xg);
            for c in 0..4 {
                let pc: u32 = softmax(lg, c as u8);
                let gc: u32 = if c == t as u8 {
                    sadd(pc, neg(f2gft(1.0)))
                } else {
                    pc
                };
                for j in 0..2 {
                    W[c][j] = sadd(W[c][j], neg(smul(eta_g, smul(gc, xg[j]))));
                }
            }
        }
        if ep % 5 == 0 || ep <= 2 {
            print("{:5} {:>10.3f} {:>9.3f}", ep, accuracy(W, train), accuracy(W, test));
        }
    }
    print("\nFINAL held-out test accuracy: {:.1%}", accuracy(W, test));
}

// We need to define a Random struct and its methods.
// Since we don't have a standard library, we'll implement a simple LCG.
// We'll mimic the Python random.Random(seed) with uniform(a,b).

struct Random {
    seed: u64,
}

impl Random {
    fn new(seed: u64) -> Random {
        Random { seed }
    }

    fn uniform(&mut self, a: f32, b: f32) -> f32 {
        // LCG parameters from Numerical Recipes
        self.seed = (self.seed * 6364136223846793005 + 1) % 2^64;
        let r: f32 = (self.seed as f64) / (2^64 as f64);
        return a + (b - a) * r as f32;
    }
}


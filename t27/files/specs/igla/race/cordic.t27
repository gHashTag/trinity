    then r == 4.0

test cordic_sqrt_approx_two_five_approx_one_four_w320
    given x = 2.0
    when r = sqrt_approx(x)
    then r > 1.3 && r < 1.5

invariant cordic_sqrt_approx_sixteen_four_exact_w320_inv:
    sqrt_approx(16.0) == 4.0

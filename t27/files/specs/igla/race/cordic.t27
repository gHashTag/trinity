invariant cordic_pythagorean_identity
    forall angle : f32, iters : u8
    let (s, c) = cordic_sin_cos(angle, iters)
    s[0] * s[0] + c[0] * c[0] > 0.95 && s[0] * s[0] + c[0] * c[0] < 1.05


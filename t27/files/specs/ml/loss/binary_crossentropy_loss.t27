// t27/specs/
// Gradient w.r.t predictions | φ² + 1/φ² = 3 | TRINITY

module BinaryCe;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_EPSILON : f32 = 1e-7;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const BinaryCEConfig = struct {
        from_logits : bool,
        epsilon : f32,
        reduction : Reduction,
    };

    pub const Reduction = struct {
        enum : [MEAN, SUM, NONE],
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


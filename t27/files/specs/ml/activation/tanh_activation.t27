    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // All four functions have no bodies, so neither tanh nor its derivative
    // can be exercised. The module's only decision is that tanh takes no
    // hyper-parameters, and that is what TanhConfig encodes.

    test tanh_config_carries_no_state
        // the sole field is void, so the config occupies no storage at all
        given config_size = @sizeOf(TanhConfig)
        then config_size == 0


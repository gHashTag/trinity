// t27/specs/
// Free queue | φ² + 1/φ² = 3 | TRINITY

module TriPriorityQueue;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PriorityQueue = struct {
        data : []i64,
        size : usize,
        allocator : std.mem.Allocator,
    };


    pub const LRUCache = struct {
        generic : K, V,
        capacity : usize,
        size : usize,
        head : *Node,
        tail : *Node,
        map : HashMap(K, *Node),
    };

    pub const Node = struct {
        generic : K, V,
        key : K,
        value : V,
        prev : *Node,
        next : *Node,
    };


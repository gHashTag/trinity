// t27/specs/
// Either represents tagged union | φ² + 1/φ² = 3 | TRINITY

module TriEither;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Either(L, R) = struct {
        is_left : bool,
        left : L,
        right : R,
    };


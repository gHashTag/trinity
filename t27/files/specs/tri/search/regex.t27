module TriRegex;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Regex = struct {
        pattern : []const u8,
        compiled : bool,
    };

    pub const Match = struct {
        start : usize,
        end : usize,
        groups : [][]const u8,
    };

    // ═══════════════════════════════════════════════════════════

// t27/specs/
// BFS to build failure links | φ² + 1/φ² = 3 | TRINITY

module TriAhoCorasick;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ACTrieNode = struct {
        children : [256]?*ACTrieNode,
        fail : *ACTrieNode,
        output : [][]const u8,
        char : u8,
    };

    pub const ACAutomaton = struct {
        root : *ACTrieNode,
        patterns : [][]const u8,
        allocator : std.mem.Allocator,
    };

    // ═══════════════════════════════════════════════════════════

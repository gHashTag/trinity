// t27/specs/
// Full Unicode support | φ² + 1/φ² = 3 | TRINITY

module TriUtf8;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Codepoint = struct {
        underlying : U21,
    };

    pub const Rune = struct {
        bytes : [4]u8,
        len : u8,
    };

    // ═══════════════════════════════════════════════════════════

    // render(template: Template, context: [td.StringHashMap([]Const u8), allocator: std.mem.Allocator) → ![]u8
    fn render(template: Template, context: [td.StringHashMap([]Const u8), allocator: std.mem.Allocator) -> ![]u8 {

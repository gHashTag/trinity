// t27/specs/
// {{variable}} syntax | φ² + 1/φ² = 3 | TRINITY

module TriTemplate;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Template = struct {
        parts : []TemplatePart,
    };

    pub const TemplatePart = struct {
        is_literal : bool,
        text : []const u8,
        variable : []const u8,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


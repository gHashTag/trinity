// t27/specs/
// Free matrix | φ² + 1/φ² = 3 | TRINITY

module TriMatrix;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Matrix = struct {
        data : []f64,
        rows : usize,
        cols : usize,
        allocator : std.mem.Allocator,
    };


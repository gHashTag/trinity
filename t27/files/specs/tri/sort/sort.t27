        // TODO: Implement from .tri spec
    }

    // sort_by(items: []const T, key_fn: fn(T) ?Order, allocator: std.mem.Allocator) → ![]T
    fn sort_by(items: []const T, key_fn: fn(T) ?Order, allocator: std.mem.Allocator) -> ![]T {

// t27/specs/
// Stable sort | φ² + 1/φ² = 3 | TRINITY

module TriSort;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const SortOrder = struct {
        enum : [Ascending, Descending],
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


// t27/specs/
// Attach shorter tree under taller tree root | φ² + 1/φ² = 3 | TRINITY

module TriDisjointSet;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const DisjointSet = struct {
        parent : []usize,
        rank : []usize,
        count : usize,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════


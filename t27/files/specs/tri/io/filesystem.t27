// t27/specs/
// Results don't end with separator (except root) | φ² + 1/φ² = 3 | TRINITY

module TriFilesystem;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const PathError = struct {
        enum : [invalid_path, not_found, not_a_directory, not_a_file, permission_denied],
    };

    pub const FileInfo = struct {
        path : []const u8,
        size : u64,
        is_dir : bool,
        is_file : bool,
        modified : u64,
    };


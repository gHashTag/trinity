// t27/specs/
// Standard HTTP status codes | φ² + 1/φ² = 3 | TRINITY

module TriHttp;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const HttpMethod = struct {
        enum : [GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS],
    };

    pub const HttpStatus = struct {
        code : u16,
        reason : []const u8,
    };

    pub const Url = struct {
        scheme : ?[]const u8,
        host : ?[]const u8,
        port : ?u16,
        path : []const u8,
        query : ?[]const u8,
        fragment : ?[]const u8,
    };


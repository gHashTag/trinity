@spec handle_collecting_phone(context: ActionContext, intent: Intent) → ActionResult {
  /// Handle CollectingPhone state
  given: Context and intent
  when: Waiting for phone number
  then: Process phone or ask again
}

@impl {
  match intent {
    PhoneInput(phone) → {
      print("[ONBOARDING] Phone received: {phone}")

      // Connect to Bridge and send code
      let bridge_url = telegram_config.bridge_url()
      let api_key = telegram_config.bridge_api_key()
      let api_id = telegram_config.api_id()
      let api_hash = telegram_config.api_hash()

      let telegram_bridge = bridge."", api_key · with_session_and_key
      let config = api_id,
        api_hash,
        ☐phone · TelegramConfig
      )

      match bridge.config · connect {
        ✅#(connected_bridge, session_info)) → {
          print("[ONBOARDING] Connected, session: {session_info}".session_id)

          match bridge.phone · send_code {
            ✅phone_code_hash) → {
              print("[ONBOARDING] Code sent, hash: {phone_code_hash}")

              let _ = type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type type User {

@spec handle_waiting_code(
  context: ActionContext,
  intent: Intent,
  phone: str,
  session_id: str,
  hash: str
) → ActionResult {
  /// Handle WaitingCode state
  given: Context, intent, and auth data
  when: Waiting for verification code
  then: Verify code or handle errors

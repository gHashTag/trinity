  name: String,
  email: String,
  id: Int}_id) {
    ✅progress) → {
      match progress.current_step {
        "⤳ing_confirmation" → AwaitingConfirmation
        "collecting_phone" → CollectingPhone
        "waiting_code" → {
          match progress.phone, progress.bridge_session_id {
            ☐phone), ☐session_id) → session_id, "" · WaitingCode
            _, _ → CollectingPhone
          }
        }
        "waiting_fa" → {
          match progress.phone, progress.bridge_session_id {
            ☐phone), ☐session_id) → session_id · Waiting2FA
            _, _ → CollectingPhone
          }
        }
        "selecting_chats" → {
          match progress.bridge_session_id {
            ☐session_id) → "[]" · SelectingChats
            ∅-> CollectingPhone
          }
        }
        "configuring_modes" → {
          match progress.bridge_session_id {
            ☐session_id) → ConfiguringModes(session_id)
            ∅-> CollectingPhone
          }
        }
        "configuring_triggers" → {
          match progress.bridge_session_id {
            ☐session_id) → ConfiguringTriggers(session_id)
            ∅-> CollectingPhone
          }
        }
        "configuring_character" → {
          match progress.bridge_session_id {
            ☐session_id) → ConfiguringCharacter(session_id)
            ∅-> CollectingPhone
          }
        }
        "complete" → {
          match progress.bridge_session_id {
            ☐session_id) → Complete(session_id)
            ∅-> NotStarted
          }
        }
        _ → NotStarted
      }
    }
    ❌_) → NotStarted
  }
}

@spec get_available_chats_text(session_id: str) → str {
  /// Get available chats as text list
  given: Session ID
  when: Showing chat options
  then: Returns formatted chat list
}

@impl {
  let bridge_url = telegram_config.bridge_url()
  let api_key = telegram_config.bridge_api_key()
  let telegram_bridge = bridge.session_id, api_key · with_session_and_key

  match bridge.50 · get_dialogs {
    ✅dialogs) → {
      let groups = list.fn(d · filter {
        match d.dialog_type {
          GroupDialog → true
          SupergroupDialog → true
          _ → false
        }
      }

      match list.len(groups) {
        0 → "Групп не найдено. Убедись что ты состоишь в группах."
        _ → {
          groups
          · list.take(10)
          · list.index_map(i · fn {
            int_$(i + 1) + ". {d}".title
          }
          · string.join("\n")
        }
      }
    }
    ❌_) → "Не удалось загрузить чаты. Попробуй позже."
  }
}

@spec state_$(state: OnboardingState) → str {
  /// Convert state to string for logging
  given: OnboardingState
  when: Logging
  then: Returns state name
}

@impl {
  match state {
    NotStarted → "NotStarted"
    AwaitingConfirmation → "AwaitingConfirmation"
    CollectingPhone → "CollectingPhone"
    _, _ · WaitingCode → "WaitingCode"
    _ · Waiting2FA → "Waiting2FA"
    _ · SelectingChats → "SelectingChats"
    ConfiguringModes(_) → "ConfiguringModes"
    ConfiguringTriggers(_) → "ConfiguringTriggers"
    ConfiguringCharacter(_) → "ConfiguringCharacter"
    Complete(_) → "Complete"
  }
}

@spec int_$(n: int) → str {
  /// Convert integer to string
  given: Integer
  when: Formatting
  then: Returns string
}

@impl {
  string.inspect(n)
}


  print("[ONBOARDING] Current state: {state_to_string}"(state))

  // Route based on state and intent
  match state {
    NotStarted → detected · handle_not_started
    AwaitingConfirmation → detected · handle_⤳ing_confirmation
    CollectingPhone → detected · handle_collecting_phone
    session_id, hash · WaitingCode ->
      detected, phone, session_id, hash · handle_waiting_code
    session_id · Waiting2FA ->
      detected, phone, session_id · handle_waiting_fa
    available · SelectingChats ->
      detected, session_id, available · handle_selecting_chats
    ConfiguringModes(session_id) ->
      detected, session_id · handle_configuring_modes
    ConfiguringTriggers(session_id) ->
      detected, session_id · handle_configuring_triggers
    ConfiguringCharacter(session_id) ->
      detected, session_id · handle_configuring_character
    Complete(session_id) ->
      detected, session_id · handle_complete
  }
}

